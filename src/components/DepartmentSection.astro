---
import { departments } from '../data/departments';
---

<section
  class="departments"
  id="departments"
  aria-labelledby="departments-title"
>
  <div class="section-shell">
    <div class="system-bar" aria-hidden="true">
      <span>ASAW // ORGANIZATION FILE</span>
      <span>ACCESS: PUBLIC</span>
    </div>

    <header class="section-heading">
      <p class="eyebrow">学生科协</p>
      <h1 id="departments-title">学生科协及其部门介绍</h1>
      <p class="introduction">
        武汉科技大学人工智能与自动化学院学生科协是面向全院同学的学生科技组织，围绕科创项目、学科竞赛和学生服务开展工作，为同学参与科技创新提供支持。目前科协下设科创部、赛事部和运维部。
      </p>
    </header>

    <div class="department-list">
      {
        departments.map((department) => (
          <article class="department-item">
            <div class="department-name">
              <span class="department-code" aria-hidden="true">
                {department.code}
              </span>
              <h2>{department.name}</h2>
              <p>{department.englishName}</p>
            </div>
            <div class="department-detail">
              <p class="department-summary">{department.summary}</p>
              <ul aria-label={`${department.name}主要工作`}>
                {department.responsibilities.map((responsibility) => (
                  <li>{responsibility}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .departments {
    position: relative;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-page);
  }

  .section-shell {
    width: min(72rem, calc(100% - 2rem));
    margin-inline: auto;
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .system-bar {
    display: none;
  }

  .section-heading {
    max-width: 62rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--color-accent);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.35rem, 4.5vw, 4.2rem);
    line-height: 1.08;
    letter-spacing: -0.05em;
  }

  .introduction {
    max-width: 58rem;
    margin: 1.5rem 0 0;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.9;
  }

  .department-list {
    border-top: 2px solid var(--color-text);
  }

  .department-item {
    display: grid;
    grid-template-columns: minmax(9rem, 0.3fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    padding-block: clamp(1.8rem, 4vw, 2.8rem);
    border-bottom: 1px solid var(--color-border);
  }

  .department-name {
    position: relative;
  }

  .department-code {
    display: none;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.55rem, 3vw, 2.15rem);
    letter-spacing: -0.035em;
  }

  .department-name p {
    margin: 0.45rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .department-summary {
    margin: 0;
    line-height: 1.85;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.5rem;
    margin: 1rem 0 0;
    padding: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    list-style: none;
  }

  li::before {
    margin-right: 0.5rem;
    color: var(--color-accent);
    content: '—';
  }

  :global(:root[data-theme='ark']) .departments {
    overflow: hidden;
    background-color: var(--color-page);
    background-image:
      linear-gradient(
        color-mix(in srgb, var(--color-border) 68%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-border) 68%, transparent) 1px,
        transparent 1px
      );
    background-size: 3rem 3rem;
  }

  :global(:root[data-theme='ark']) .departments::before {
    position: absolute;
    inset: 0 0 auto;
    height: 0.45rem;
    background: repeating-linear-gradient(
      -45deg,
      var(--color-accent) 0 0.55rem,
      transparent 0.55rem 1.1rem
    );
    content: '';
  }

  :global(:root[data-theme='ark']) .section-shell {
    position: relative;
    padding-inline: clamp(1rem, 3vw, 2rem);
    border-inline: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-page) 88%, transparent);
  }

  :global(:root[data-theme='ark']) .system-bar {
    display: flex;
    justify-content: space-between;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    padding-block: 0.6rem;
    border-block: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-family: ui-monospace, 'Cascadia Code', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.13em;
  }

  :global(:root[data-theme='ark']) .eyebrow::before {
    margin-right: 0.55rem;
    content: '01 /';
  }

  :global(:root[data-theme='ark']) h1 {
    max-width: 13ch;
    text-shadow: 0.12rem 0
      color-mix(in srgb, var(--color-accent) 38%, transparent);
  }

  :global(:root[data-theme='ark']) .section-heading {
    position: relative;
    padding-left: clamp(1rem, 2.5vw, 2rem);
    border-left: 0.35rem solid var(--color-accent);
  }

  :global(:root[data-theme='ark']) .department-list {
    display: grid;
    gap: 0.8rem;
    border-top: 0;
  }

  :global(:root[data-theme='ark']) .department-item {
    position: relative;
    grid-template-columns: minmax(10rem, 0.34fr) minmax(0, 1fr);
    padding: clamp(1.4rem, 3vw, 2rem);
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-surface) 94%, transparent);
    clip-path: polygon(
      0 0,
      calc(100% - 1.4rem) 0,
      100% 1.4rem,
      100% 100%,
      0 100%
    );
  }

  :global(:root[data-theme='ark']) .department-item::after {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 4rem;
    height: 0.2rem;
    background: var(--color-accent);
    content: '';
  }

  :global(:root[data-theme='ark']) .department-code {
    display: block;
    margin-bottom: 1.1rem;
    color: var(--color-accent);
    font-family: ui-monospace, 'Cascadia Code', monospace;
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1;
  }

  :global(:root[data-theme='ark']) .department-code::after {
    margin-left: 0.65rem;
    color: var(--color-text-muted);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    content: 'DEPARTMENT';
  }

  :global(:root[data-theme='ark']) li {
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--color-border);
    background: var(--color-page);
    font-family: ui-monospace, 'Cascadia Code', monospace;
    font-size: 0.76rem;
  }

  :global(:root[data-theme='ark']) li::before {
    content: '//';
  }

  @media (max-width: 42rem) {
    .department-item,
    :global(:root[data-theme='ark']) .department-item {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .introduction {
      font-size: 1rem;
    }

    :global(:root[data-theme='ark']) .system-bar span:last-child {
      display: none;
    }
  }
</style>
