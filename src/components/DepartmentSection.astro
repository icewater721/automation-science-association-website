---
import { departments } from '../data/departments';
---

<section
  class="departments"
  id="departments"
  aria-labelledby="departments-title"
>
  <div class="section-shell">
    <div class="system-bar" aria-hidden="true">
      <span>ASAW // ORGANIZATION FILE</span>
      <span>ACCESS: PUBLIC</span>
    </div>

    <header class="section-heading">
      <p class="eyebrow">学生科协</p>
      <h1 id="departments-title">学生科协及其部门介绍</h1>
      <p class="introduction">
        武汉科技大学人工智能与自动化学院学生科协是面向全院同学的学生科技组织，围绕科创项目、学科竞赛和学生服务开展工作，为同学参与科技创新提供支持。目前科协下设科创部、赛事部和运维部。
      </p>
    </header>

    <div class="department-tabs" role="tablist" aria-label="科协部门">
      {
        departments.map((department, index) => (
          <button
            id={`department-tab-${department.code}`}
            type="button"
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`department-panel-${department.code}`}
            tabindex={index === 0 ? 0 : -1}
            data-department-tab
          >
            {department.name}
          </button>
        ))
      }
    </div>

    <div class="department-panels">
      {
        departments.map((department, index) => (
          <article
            class="department-panel"
            id={`department-panel-${department.code}`}
            role="tabpanel"
            aria-labelledby={`department-tab-${department.code}`}
            hidden={index !== 0}
            data-department-panel
          >
            <div class="department-name">
              <span class="department-code" aria-hidden="true">
                {department.code}
              </span>
              <h2>
                {department.name}
                <span class="title-separator"> · </span>
                <span class="english-name">{department.englishName}</span>
              </h2>
              <p class="department-summary">
                <strong>{department.mission}</strong>
                {department.summary}
              </p>
            </div>
            <div class="department-detail">
              <h3>我们做什么：</h3>
              <ul aria-label={`${department.name}主要工作`}>
                {department.responsibilities.map((responsibility) => (
                  <li>{responsibility}</li>
                ))}
              </ul>
            </div>
            <span class="panel-status" aria-hidden="true">
              ACTIVE / 01
            </span>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const setupDepartmentTabs = () => {
    const tabList = document.querySelector<HTMLElement>('.department-tabs');
    if (!tabList || tabList.dataset.ready === 'true') return;
    tabList.dataset.ready = 'true';

    const tabs = Array.from(
      tabList.querySelectorAll<HTMLButtonElement>('[data-department-tab]'),
    );
    const panels = Array.from(
      document.querySelectorAll<HTMLElement>('[data-department-panel]'),
    );

    const selectTab = (tab: HTMLButtonElement) => {
      for (const candidate of tabs) {
        const selected = candidate === tab;
        candidate.setAttribute('aria-selected', String(selected));
        candidate.tabIndex = selected ? 0 : -1;
      }

      for (const panel of panels) {
        panel.hidden = panel.getAttribute('aria-labelledby') !== tab.id;
      }
    };

    for (const tab of tabs) {
      tab.addEventListener('click', () => selectTab(tab));
      tab.addEventListener('keydown', (event) => {
        const currentIndex = tabs.indexOf(tab);
        let nextIndex: number | undefined;

        if (event.key === 'ArrowRight')
          nextIndex = (currentIndex + 1) % tabs.length;
        if (event.key === 'ArrowLeft')
          nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = tabs.length - 1;
        if (nextIndex === undefined) return;

        event.preventDefault();
        const nextTab = tabs[nextIndex];
        if (!nextTab) return;
        selectTab(nextTab);
        nextTab.focus();
      });
    }
  };

  setupDepartmentTabs();
  document.addEventListener('astro:page-load', setupDepartmentTabs);
</script>

<style>
  .departments {
    position: relative;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-page);
  }

  .section-shell {
    width: min(64rem, calc(100% - clamp(3rem, 10vw, 8rem)));
    margin-inline: auto;
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .system-bar,
  .panel-status {
    display: none;
  }

  .section-heading {
    max-width: 62rem;
    margin-bottom: clamp(2.25rem, 5vw, 3.5rem);
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--color-accent);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.35rem, 4.5vw, 4.2rem);
    line-height: 1.08;
    letter-spacing: -0.05em;
  }

  .introduction {
    max-width: 58rem;
    margin: 1.5rem 0 0;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.9;
  }

  .department-tabs {
    display: flex;
    align-items: center;
    padding-block: 0.85rem;
    border-block: 2px solid var(--color-text);
  }

  .department-tabs button {
    position: relative;
    flex: 1;
    padding: 0.25rem clamp(1rem, 3vw, 2.25rem);
    border: 0;
    background: transparent;
    color: var(--color-text-muted);
    font: inherit;
    font-size: 1rem;
    font-weight: 650;
    cursor: pointer;
    text-align: center;
  }

  .department-tabs button:not(:last-child)::after {
    position: absolute;
    right: 0;
    color: var(--color-border);
    content: '|';
  }

  .department-tabs button[aria-selected='true'] {
    color: var(--color-text);
  }

  .department-tabs button[aria-selected='true']::before {
    position: absolute;
    right: clamp(1rem, 3vw, 2.25rem);
    bottom: -1.2rem;
    left: clamp(1rem, 3vw, 2.25rem);
    height: 0.2rem;
    background: var(--color-accent);
    content: '';
  }

  .department-panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(15rem, 0.42fr) minmax(0, 0.58fr);
    gap: clamp(2.5rem, 7vw, 5.5rem);
    min-height: 18rem;
    align-items: start;
    padding-block: clamp(2rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--color-border);
  }

  .department-panel[hidden] {
    display: none;
  }

  .department-code {
    display: none;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    letter-spacing: -0.025em;
  }

  .title-separator {
    font-weight: 450;
  }

  .english-name {
    font-weight: 750;
  }

  .department-summary {
    margin: 1.35rem 0 0;
    font-size: clamp(1rem, 1.5vw, 1.1rem);
    line-height: 1.8;
  }

  .department-detail h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  ul {
    display: grid;
    gap: 0.65rem;
    margin: 1.15rem 0 0;
    padding-left: 1.35rem;
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.7;
  }

  li::marker {
    color: var(--color-accent);
  }

  @media (max-width: 42rem) {
    .section-shell {
      width: min(100% - 2rem, 64rem);
    }

    .department-tabs {
      justify-content: space-between;
    }

    .department-tabs button {
      flex: 1;
      padding-inline: 0.55rem;
    }

    .department-tabs button[aria-selected='true']::before {
      right: 0.55rem;
      left: 0.55rem;
    }

    .introduction {
      font-size: 1rem;
    }

    .department-panel {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
