---
import { departments } from '../data/departments';
---

<section
  class="departments"
  id="departments"
  aria-labelledby="departments-title"
>
  <div class="section-shell">
    <div class="system-bar" aria-hidden="true">
      <span>ASAW // ORGANIZATION FILE</span>
      <span>ACCESS: PUBLIC</span>
    </div>

    <header class="section-heading">
      <p class="eyebrow">学生科协</p>
      <h1 id="departments-title">学生科协及其部门介绍</h1>
      <p class="introduction">
        武汉科技大学人工智能与自动化学院学生科协是面向全院同学的学生科技组织，围绕科创项目、学科竞赛和学生服务开展工作，为同学参与科技创新提供支持。目前科协下设科创部、赛事部和运维部。
      </p>
    </header>

    <div class="department-tabs" role="tablist" aria-label="科协部门">
      {
        departments.map((department, index) => (
          <button
            id={`department-tab-${department.code}`}
            type="button"
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`department-panel-${department.code}`}
            tabindex={index === 0 ? 0 : -1}
            data-department-tab
          >
            {department.name}
          </button>
        ))
      }
    </div>

    <div class="department-panels">
      {
        departments.map((department, index) => (
          <article
            class="department-panel"
            id={`department-panel-${department.code}`}
            role="tabpanel"
            aria-labelledby={`department-tab-${department.code}`}
            hidden={index !== 0}
            data-department-panel
          >
            <div class="department-name">
              <span class="department-code" aria-hidden="true">
                {department.code}
              </span>
              <h2>{department.name}</h2>
              <p>{department.englishName}</p>
            </div>
            <div class="department-detail">
              <p class="department-summary">{department.summary}</p>
              <ul aria-label={`${department.name}主要工作`}>
                {department.responsibilities.map((responsibility) => (
                  <li>{responsibility}</li>
                ))}
              </ul>
            </div>
            <span class="panel-status" aria-hidden="true">
              ACTIVE / 01
            </span>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const setupDepartmentTabs = () => {
    const tabList = document.querySelector<HTMLElement>('.department-tabs');
    if (!tabList || tabList.dataset.ready === 'true') return;
    tabList.dataset.ready = 'true';

    const tabs = Array.from(
      tabList.querySelectorAll<HTMLButtonElement>('[data-department-tab]'),
    );
    const panels = Array.from(
      document.querySelectorAll<HTMLElement>('[data-department-panel]'),
    );

    const selectTab = (tab: HTMLButtonElement) => {
      for (const candidate of tabs) {
        const selected = candidate === tab;
        candidate.setAttribute('aria-selected', String(selected));
        candidate.tabIndex = selected ? 0 : -1;
      }

      for (const panel of panels) {
        panel.hidden = panel.getAttribute('aria-labelledby') !== tab.id;
      }
    };

    for (const tab of tabs) {
      tab.addEventListener('click', () => selectTab(tab));
      tab.addEventListener('keydown', (event) => {
        const currentIndex = tabs.indexOf(tab);
        let nextIndex: number | undefined;

        if (event.key === 'ArrowRight')
          nextIndex = (currentIndex + 1) % tabs.length;
        if (event.key === 'ArrowLeft')
          nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = tabs.length - 1;
        if (nextIndex === undefined) return;

        event.preventDefault();
        const nextTab = tabs[nextIndex];
        if (!nextTab) return;
        selectTab(nextTab);
        nextTab.focus();
      });
    }
  };

  setupDepartmentTabs();
  document.addEventListener('astro:page-load', setupDepartmentTabs);
</script>

<style>
  .departments {
    position: relative;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-page);
  }

  .section-shell {
    width: min(72rem, calc(100% - 2rem));
    margin-inline: auto;
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .system-bar,
  .panel-status {
    display: none;
  }

  .section-heading {
    max-width: 62rem;
    margin-bottom: clamp(2.25rem, 5vw, 3.5rem);
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--color-accent);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.35rem, 4.5vw, 4.2rem);
    line-height: 1.08;
    letter-spacing: -0.05em;
  }

  .introduction {
    max-width: 58rem;
    margin: 1.5rem 0 0;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.9;
  }

  .department-tabs {
    display: flex;
    align-items: center;
    padding-block: 0.85rem;
    border-block: 2px solid var(--color-text);
  }

  .department-tabs button {
    position: relative;
    padding: 0.25rem clamp(1rem, 3vw, 2.25rem);
    border: 0;
    background: transparent;
    color: var(--color-text-muted);
    font: inherit;
    font-size: 1rem;
    font-weight: 650;
    cursor: pointer;
  }

  .department-tabs button:first-child {
    padding-left: 0;
  }

  .department-tabs button:not(:last-child)::after {
    position: absolute;
    right: 0;
    color: var(--color-border);
    content: '|';
  }

  .department-tabs button[aria-selected='true'] {
    color: var(--color-text);
  }

  .department-tabs button[aria-selected='true']::before {
    position: absolute;
    right: clamp(1rem, 3vw, 2.25rem);
    bottom: -1.2rem;
    left: clamp(1rem, 3vw, 2.25rem);
    height: 0.2rem;
    background: var(--color-accent);
    content: '';
  }

  .department-tabs button:first-child[aria-selected='true']::before {
    left: 0;
  }

  .department-panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(10rem, 0.32fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    min-height: 14rem;
    align-content: center;
    padding-block: clamp(2rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--color-border);
  }

  .department-panel[hidden] {
    display: none;
  }

  .department-code {
    display: none;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.7rem, 3vw, 2.35rem);
    letter-spacing: -0.035em;
  }

  .department-name p {
    margin: 0.45rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .department-summary {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.85;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.5rem;
    margin: 1rem 0 0;
    padding: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    list-style: none;
  }

  li::before {
    margin-right: 0.5rem;
    color: var(--color-accent);
    content: '—';
  }

  :global(:root[data-theme='ark']) .departments {
    overflow: hidden;
    background-color: var(--color-page);
    background-image: var(--ark-grid-image);
    background-position: center top;
    background-size: var(--ark-grid-size) var(--ark-grid-size);
  }

  :global(:root[data-theme='ark']) .departments::before {
    position: absolute;
    inset: 0 0 auto;
    height: 0.45rem;
    background: var(--ark-hazard-stripe);
    content: '';
  }

  :global(:root[data-theme='ark']) .departments::after {
    position: absolute;
    top: 9rem;
    right: -8rem;
    width: 24rem;
    height: 24rem;
    border: 1px solid var(--color-border);
    opacity: 0.36;
    content: '';
    transform: rotate(45deg);
    pointer-events: none;
  }

  :global(:root[data-theme='ark']) .section-shell {
    position: relative;
    z-index: 1;
    padding-inline: clamp(1rem, 3vw, 2rem);
    border-inline: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-page) 86%, transparent);
  }

  :global(:root[data-theme='ark']) .system-bar {
    display: flex;
    justify-content: space-between;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    padding-block: 0.6rem;
    border-block: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-family: ui-monospace, 'Cascadia Code', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.13em;
  }

  :global(:root[data-theme='ark']) .eyebrow::before {
    margin-right: 0.55rem;
    content: '01 /';
  }

  :global(:root[data-theme='ark']) h1 {
    max-width: 13ch;
    text-shadow: 0.12rem 0
      color-mix(in srgb, var(--color-accent) 38%, transparent);
  }

  :global(:root[data-theme='ark']) .section-heading {
    position: relative;
    padding-left: clamp(1rem, 2.5vw, 2rem);
    border-left: 0.35rem solid var(--color-accent);
  }

  :global(:root[data-theme='ark']) .section-heading::after {
    display: inline-block;
    margin-top: 1.6rem;
    padding: 0.35rem 2.5rem 0.35rem 0.65rem;
    background: var(--color-text);
    color: var(--color-page);
    font-family: ui-monospace, 'Cascadia Code', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    content: 'MODULE / PERSONNEL';
  }

  :global(:root[data-theme='ark']) .department-tabs {
    gap: 0.25rem;
    padding: 0.35rem;
    border: 1px solid var(--color-border);
    background: #020304;
  }

  :global(:root[data-theme='ark']) .department-tabs button {
    flex: 1;
    padding: 0.75rem 1rem;
    color: var(--color-text-muted);
    font-family: ui-monospace, 'Cascadia Code', monospace;
    letter-spacing: 0.05em;
    clip-path: polygon(0.55rem 0, 100% 0, calc(100% - 0.55rem) 100%, 0 100%);
  }

  :global(:root[data-theme='ark']) .department-tabs button::after,
  :global(:root[data-theme='ark']) .department-tabs button::before {
    display: none;
  }

  :global(:root[data-theme='ark'])
    .department-tabs
    button[aria-selected='true'] {
    background: var(--color-text);
    color: var(--color-page);
  }

  :global(:root[data-theme='ark']) .department-panel {
    grid-template-columns: minmax(10rem, 0.34fr) minmax(0, 1fr);
    min-height: 17rem;
    margin-top: 0.8rem;
    padding: clamp(1.6rem, 4vw, 2.5rem);
    border: 1px solid var(--color-border);
    border-left: 0.35rem solid var(--color-accent);
    background:
      linear-gradient(
        115deg,
        color-mix(in srgb, var(--color-surface) 98%, transparent) 0 68%,
        color-mix(in srgb, var(--color-accent) 8%, var(--color-surface)) 68%
      ),
      var(--color-surface);
    clip-path: polygon(
      0 0,
      calc(100% - 1.4rem) 0,
      100% 1.4rem,
      100% 100%,
      0 100%
    );
  }

  :global(:root[data-theme='ark']) .department-code {
    display: block;
    margin-bottom: 1.1rem;
    color: var(--color-accent);
    font-family: ui-monospace, 'Cascadia Code', monospace;
    font-size: 2.6rem;
    font-weight: 800;
    line-height: 1;
  }

  :global(:root[data-theme='ark']) .department-code::after {
    margin-left: 0.65rem;
    color: var(--color-text-muted);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    content: 'DEPARTMENT';
  }

  :global(:root[data-theme='ark']) li {
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--color-border);
    background: var(--color-page);
    font-family: ui-monospace, 'Cascadia Code', monospace;
    font-size: 0.76rem;
  }

  :global(:root[data-theme='ark']) li::before {
    content: '//';
  }

  :global(:root[data-theme='ark']) .panel-status {
    position: absolute;
    right: 1rem;
    bottom: 0.65rem;
    display: block;
    color: var(--color-accent);
    font-family: ui-monospace, 'Cascadia Code', monospace;
    font-size: 0.58rem;
    letter-spacing: 0.12em;
  }

  @media (max-width: 42rem) {
    .department-tabs {
      justify-content: space-between;
    }

    .department-tabs button {
      flex: 1;
      padding-inline: 0.55rem;
    }

    .department-tabs button[aria-selected='true']::before {
      right: 0.55rem;
      left: 0.55rem;
    }

    .department-tabs button:first-child[aria-selected='true']::before {
      left: 0.55rem;
    }

    .department-panel,
    :global(:root[data-theme='ark']) .department-panel {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .introduction {
      font-size: 1rem;
    }

    :global(:root[data-theme='ark']) .system-bar span:last-child {
      display: none;
    }
  }
</style>
