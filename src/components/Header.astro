---
import SiteSearch from './SiteSearch.astro';
import ThemeToggle from './ThemeToggle.astro';
import { withBase } from '../utils/paths';

const pathname = Astro.url.pathname;
const homePath = withBase();
const docsPath = withBase('/docs/');
const isHomePage = pathname === homePath;
const isDocsPage = pathname.startsWith(docsPath);
---

<aside class="site-sidebar">
  <a class="brand" href={homePath} aria-label="人工智能学院学生科协首页">
    <img
      src={withBase('/images/brand/asaw-logo.png')}
      alt=""
      width="56"
      height="56"
    />
    <span><strong>人工智能学院</strong><small>学生科协</small></span>
  </a>

  <nav class="primary-nav" aria-label="主导航">
    <a
      class:list={['nav-link', { 'nav-link--current': isHomePage }]}
      href={homePath}
      aria-current={isHomePage ? 'page' : undefined}
    >
      <span aria-hidden="true">01</span>首页
    </a>
    <a
      class:list={['nav-link', { 'nav-link--current': isDocsPage }]}
      href={docsPath}
      aria-current={isDocsPage ? 'page' : undefined}
    >
      <span aria-hidden="true">02</span>文档
    </a>
  </nav>

  <div class="sidebar-tools">
    <SiteSearch />
    <div class="theme-row"><span>外观</span><ThemeToggle /></div>
  </div>
</aside>

<style>
  .site-sidebar {
    position: fixed;
    z-index: 100;
    inset: 0 auto 0 0;
    display: flex;
    width: var(--site-sidebar-width);
    flex-direction: column;
    padding: 1.4rem 1rem 1rem;
    border-right: 1px solid var(--color-border);
    background: var(--color-nav);
    color: var(--color-nav-text);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.45rem;
    border-radius: 0.65rem;
    text-decoration: none;
  }

  .brand:hover,
  .nav-link:hover {
    background: color-mix(in srgb, var(--color-nav-text) 6%, transparent);
  }

  .brand img {
    width: 3.25rem;
    height: 3.25rem;
    flex: 0 0 auto;
    border: 1px solid color-mix(in srgb, var(--color-nav-text) 16%, transparent);
    border-radius: 50%;
  }

  .brand span {
    display: grid;
    min-width: 0;
    gap: 0.18rem;
  }

  .brand strong {
    font-size: 0.9rem;
  }
  .brand small {
    color: color-mix(in srgb, var(--color-nav-text) 62%, transparent);
    font-size: 0.78rem;
  }

  .primary-nav {
    display: grid;
    gap: 0.35rem;
    margin-top: 2.75rem;
  }

  .nav-link {
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-items: center;
    padding: 0.72rem 0.8rem;
    border-radius: 0.55rem;
    color: color-mix(in srgb, var(--color-nav-text) 68%, transparent);
    font-size: 0.92rem;
    font-weight: 650;
    text-decoration: none;
  }

  .nav-link > span {
    font-family: ui-monospace, 'Cascadia Code', monospace;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .nav-link:hover {
    color: var(--color-nav-text);
  }
  .nav-link--current,
  .nav-link--current:hover {
    background: var(--color-nav-text);
    color: var(--color-nav);
  }

  .sidebar-tools {
    display: grid;
    gap: 0.8rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .theme-row {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: space-between;
    padding-left: 0.75rem;
    color: color-mix(in srgb, var(--color-nav-text) 64%, transparent);
    font-size: 0.78rem;
  }

  @media (max-width: 48rem) {
    .site-sidebar {
      position: sticky;
      width: 100%;
      min-height: 4.25rem;
      flex-direction: row;
      align-items: center;
      gap: 0.75rem;
      padding: 0.55rem 0.75rem;
      border-right: 0;
      border-bottom: 1px solid var(--color-border);
    }
    .brand span,
    .sidebar-tools,
    .nav-link > span {
      display: none;
    }
    .brand img {
      width: 2.8rem;
      height: 2.8rem;
    }
    .primary-nav {
      display: flex;
      gap: 0.2rem;
      margin: 0 0 0 auto;
    }
    .nav-link {
      display: block;
      padding: 0.6rem 0.8rem;
    }
  }
</style>
