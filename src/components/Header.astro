---
import SiteSearch from './SiteSearch.astro';
import ThemeToggle from './ThemeToggle.astro';
import { withBase } from '../utils/paths';

const pathname = Astro.url.pathname;
const homePath = withBase();
const articlesPath = withBase('/articles/');
const loginPath = withBase('/login/');
const profilePath = withBase('/profile/');
const draftsPath = withBase('/articles/drafts/');
const myDraftsPath = withBase('/articles/mine/');
const adminPath = withBase('/admin/');
const isHomePage = pathname === homePath;
const isArticlesPage = pathname.startsWith(articlesPath);
---

<aside class="site-sidebar">
  <a class="brand" href={homePath} aria-label="人工智能学院学生科协首页">
    <img
      src={withBase('/images/brand/asaw-logo.png')}
      alt=""
      width="56"
      height="56"
    />
    <span>
      <strong>人工智能与自动化学院科协</strong>
      <small><b>WUST</b><span>AI &amp; AUTOMATION</span></small>
    </span>
  </a>

  <div class="sidebar-search">
    <SiteSearch placement="sidebar" />
  </div>

  <nav class="primary-nav" aria-label="主导航">
    <a
      class:list={['nav-link', { 'nav-link--current': isHomePage }]}
      href={homePath}
      aria-current={isHomePage ? 'page' : undefined}
    >
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="m3 11 9-7 9 7"></path>
        <path d="M5.5 10v10h13V10M9.5 20v-6h5v6"></path>
      </svg>
      首页
    </a>
    <a
      class:list={['nav-link', { 'nav-link--current': isArticlesPage }]}
      href={articlesPath}
      aria-current={isArticlesPage ? 'page' : undefined}
    >
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="M5 4.5h14v15H5Z"></path>
        <path d="M8.5 8h7M8.5 12h7M8.5 16h4"></path>
      </svg>
      文档
    </a>
  </nav>

  <div class="sidebar-tools">
    <div class="tool-row">
      <div class="member-menu" data-member-menu data-login-url={loginPath} data-drafts-url={draftsPath}>
        <button
          class="tool-link login-link"
          type="button"
          data-member-trigger
          data-profile-url={profilePath}
          aria-label="个人登录"
          aria-haspopup="menu"
          aria-expanded="false"
          title="个人登录"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24">
            <circle cx="12" cy="8" r="3.5"></circle>
            <path d="M5.5 20c.5-4 2.7-6 6.5-6s6 2 6.5 6"></path>
          </svg>
        </button>
        <div class="member-popover" data-member-popover role="menu" hidden>
          <div class="member-summary">
            <span class="member-summary-avatar">
              <img data-menu-avatar alt="" hidden />
              <svg data-menu-placeholder aria-hidden="true" viewBox="0 0 24 24">
                <circle cx="12" cy="8" r="3.5"></circle>
                <path d="M5.5 20c.5-4 2.7-6 6.5-6s6 2 6.5 6"></path>
              </svg>
            </span>
            <span>
              <small>已登录</small>
              <span class="member-name-row">
                <strong data-member-name>未设置昵称</strong>
                <em data-admin-badge hidden>管理员</em>
              </span>
            </span>
          </div>
          <a href={profilePath} role="menuitem">个人主页</a>
          <a href={adminPath} role="menuitem">权限入口</a>
          <div class="editor-menu" data-editor-menu hidden>
            <a href={draftsPath} role="menuitem">草稿箱</a>
            <a href={myDraftsPath} role="menuitem">我的文档</a>
          </div>
          <button type="button" data-menu-sign-out role="menuitem">退出登录</button>
        </div>
      </div>
      <a
        class="tool-link github-link"
        href="https://github.com/icewater721/automation-science-association-website"
        target="_blank"
        rel="noreferrer"
        aria-label="在 GitHub 查看网站仓库"
        title="GitHub 仓库"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path
            d="M12 2.7a9.4 9.4 0 0 0-3 18.3c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 0 1.6 1.1 1.6 1.1.9 1.6 2.4 1.1 3 .8.1-.7.4-1.1.7-1.4-2.2-.3-4.6-1.1-4.6-4.7 0-1 .4-1.9 1-2.6-.1-.3-.4-1.3.1-2.6 0 0 .8-.3 2.7 1a9.2 9.2 0 0 1 4.9 0c1.9-1.3 2.7-1 2.7-1 .5 1.3.2 2.3.1 2.6.7.7 1 1.6 1 2.6 0 3.6-2.4 4.4-4.6 4.7.4.3.7.9.7 1.8v2.7c0 .4.2.6.7.5A9.4 9.4 0 0 0 12 2.7Z"
          ></path>
        </svg>
      </a>
      <ThemeToggle />
    </div>
  </div>
</aside>

<script>
  import { supabase } from '../lib/supabase';

  const memberMenu = document.querySelector<HTMLElement>('[data-member-menu]');
  const memberTrigger = document.querySelector<HTMLButtonElement>(
    '[data-member-trigger]',
  );
  const memberPopover = document.querySelector<HTMLElement>(
    '[data-member-popover]',
  );
  const sessionResult = await supabase?.auth.getSession();
  const session = sessionResult?.data.session;

  const closeMemberMenu = () => {
    if (!memberPopover || !memberTrigger) return;
    memberPopover.hidden = true;
    memberTrigger.ariaExpanded = 'false';
  };

  if (memberTrigger && session) {
    memberTrigger.ariaLabel = '打开个人菜单';
    memberTrigger.title = '个人菜单';
    const profileResult = await supabase!
      .from('profiles')
      .select('display_name,avatar_url,role')
      .eq('user_id', session.user.id)
      .single();
    let profile: {
      display_name?: unknown;
      avatar_url?: unknown;
      role?: unknown;
    } | null = profileResult.data;
    if (profileResult.error?.code === '42703') {
      const legacyResult = await supabase!
        .from('profiles')
        .select('display_name,avatar_url,is_collaborator')
        .eq('user_id', session.user.id)
        .single();
      profile = legacyResult.data
        ? {
            display_name: legacyResult.data.display_name,
            avatar_url: legacyResult.data.avatar_url,
            role: legacyResult.data.is_collaborator ? 'editor' : null,
          }
        : null;
    }
    const displayName = String(profile?.display_name || '未设置昵称');
    const avatarUrl = String(profile?.avatar_url || '');
    const name = document.querySelector<HTMLElement>('[data-member-name]');
    if (name) name.textContent = displayName;
    const adminBadge = document.querySelector<HTMLElement>('[data-admin-badge]');
    if (adminBadge && profile?.role === 'admin') adminBadge.hidden = false;
    if (profile?.role === 'admin') {
      const editorMenu = document.querySelector<HTMLElement>('[data-editor-menu]');
      if (editorMenu) editorMenu.hidden = false;
    }
    const menuAvatar =
      document.querySelector<HTMLImageElement>('[data-menu-avatar]');
    if (menuAvatar && avatarUrl) {
      menuAvatar.src = avatarUrl;
      menuAvatar.hidden = false;
    }
    if (avatarUrl) {
      const placeholder = document.querySelector<HTMLElement>(
        '[data-menu-placeholder]',
      );
      if (placeholder) placeholder.hidden = true;
    }
  }

  memberTrigger?.addEventListener('click', () => {
    if (!session) {
      window.location.assign(memberMenu?.dataset.loginUrl ?? '/');
      return;
    }
    if (!memberPopover) return;
    memberPopover.hidden = !memberPopover.hidden;
    memberTrigger.ariaExpanded = String(!memberPopover.hidden);
  });
  document.addEventListener('pointerdown', (event) => {
    if (!memberMenu?.contains(event.target as Node)) closeMemberMenu();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMemberMenu();
  });
  document.querySelector('[data-menu-sign-out]')?.addEventListener('click', async () => {
    await supabase?.auth.signOut();
    window.location.assign(memberMenu?.dataset.loginUrl ?? '/');
  });
</script>

<style>
  .site-sidebar {
    position: fixed;
    z-index: 100;
    inset: 0 auto 0 0;
    display: flex;
    width: var(--site-sidebar-width);
    flex-direction: column;
    padding: 1.4rem 1rem 1rem;
    border-right: 1px solid var(--color-border);
    background: var(--color-nav);
    color: var(--color-nav-text);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.45rem;
    border-radius: 0.65rem;
    text-decoration: none;
  }

  .brand:hover,
  .nav-link:hover {
    background: color-mix(in srgb, var(--color-nav-text) 6%, transparent);
  }

  .brand img {
    width: 3.25rem;
    height: 3.25rem;
    flex: 0 0 auto;
    border: 1px solid color-mix(in srgb, var(--color-nav-text) 16%, transparent);
    border-radius: 50%;
  }

  .brand span {
    display: grid;
    min-width: 0;
    gap: 0.18rem;
  }

  .brand strong {
    font-size: 0.78rem;
    line-height: 1.35;
    white-space: nowrap;
  }
  .brand small {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: flex-start;
    gap: 0.5rem;
    color: color-mix(in srgb, var(--color-nav-text) 62%, transparent);
    font-family: ui-serif, Georgia, serif;
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    line-height: 1.35;
  }

  .brand small b {
    padding-right: 0.35rem;
    border-right: 1px solid currentColor;
    color: var(--color-nav-text);
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.48rem;
  }

  .brand small > span {
    display: inline-block;
    letter-spacing: 0.12em;
    word-spacing: 0.22em;
  }

  .primary-nav {
    display: grid;
    gap: 0.35rem;
    margin-top: 1.5rem;
  }

  .sidebar-search {
    margin-top: 1.5rem;
  }

  .nav-link {
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-items: center;
    padding: 0.72rem 0.8rem;
    border-radius: 0.55rem;
    color: color-mix(in srgb, var(--color-nav-text) 68%, transparent);
    font-size: 0.92rem;
    font-weight: 650;
    text-decoration: none;
  }

  .nav-link > svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .nav-link:hover {
    color: var(--color-nav-text);
  }
  .nav-link--current,
  .nav-link--current:hover {
    background: var(--color-nav-text);
    color: var(--color-nav);
  }

  .sidebar-tools {
    display: grid;
    gap: 0.8rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .tool-row {
    display: grid;
    grid-template-columns: repeat(3, 2.75rem);
    min-height: 2.75rem;
    align-items: center;
    justify-content: space-between;
  }

  .tool-link {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border-radius: 999px;
    color: var(--color-nav-text);
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .tool-link:hover {
    background: color-mix(in srgb, var(--color-nav-text) 10%, transparent);
  }

  .tool-link svg {
    width: 1.45rem;
    height: 1.45rem;
  }

  .github-link svg {
    fill: currentColor;
  }

  .login-link svg {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .member-menu {
    position: relative;
  }

  .member-popover {
    position: absolute;
    z-index: 10;
    bottom: calc(100% + 0.8rem);
    left: 0;
    width: 13.5rem;
    padding: 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-nav);
    box-shadow: 0 0.8rem 2rem color-mix(in srgb, #000 18%, transparent);
  }

  .member-popover[hidden] {
    display: none;
  }

  .member-summary {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.45rem 0.45rem 0.7rem;
    border-bottom: 1px solid var(--color-border);
  }

  .member-summary > span:last-child {
    display: grid;
    min-width: 0;
    gap: 0.1rem;
  }

  .member-summary small {
    color: color-mix(in srgb, var(--color-nav-text) 58%, transparent);
    font-size: 0.65rem;
  }

  .member-summary strong {
    overflow: hidden;
    font-size: 0.82rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .member-name-row {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.4rem;
  }

  .member-name-row em {
    flex: none;
    padding: 0.12rem 0.32rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent) 20%, transparent);
    color: var(--color-accent);
    font-size: 0.56rem;
    font-style: normal;
    font-weight: 750;
  }

  .member-summary-avatar {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    place-items: center;
    overflow: hidden;
    border-radius: 50%;
    background: var(--color-nav-text);
    color: var(--color-nav);
  }

  .member-summary-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .member-summary-avatar svg {
    width: 1.3rem;
    height: 1.3rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
  }

  .member-popover > a,
  .member-popover > button {
    display: block;
    width: 100%;
    padding: 0.44rem 0.55rem;
    border: 0;
    border-radius: 0.45rem;
    background: transparent;
    color: var(--color-nav-text);
    cursor: pointer;
    font: inherit;
    font-size: 0.78rem;
    text-align: left;
    text-decoration: none;
  }

  .member-popover > a:hover,
  .member-popover > button:hover {
    background: color-mix(in srgb, var(--color-nav-text) 9%, transparent);
  }

  .editor-menu { display: grid; padding-block: 0.08rem; }
  .editor-menu[hidden] { display: none; }
  .editor-menu > a, .editor-menu details > summary { display: block; margin: 0; padding: 0.4rem 0.55rem; border-radius: 0.45rem; color: var(--color-nav-text); cursor: pointer; font-size: 0.78rem; font-weight: 500; line-height: 1.25; list-style: none; text-decoration: none; }
  .editor-menu details > summary::-webkit-details-marker { display: none; }
  .editor-menu > a { border-radius: 0.45rem; }
  .editor-menu > a:hover { background: color-mix(in srgb, var(--color-nav-text) 9%, transparent); }
  .editor-menu details div { display: grid; padding: 0 0.35rem 0.08rem 0.75rem; }
  .editor-menu details div a, .editor-menu details div > span { overflow: hidden; padding: 0.14rem 0; color: color-mix(in srgb, var(--color-nav-text) 62%, transparent); font-size: 0.72rem; line-height: 1.2; text-decoration: none; text-overflow: ellipsis; white-space: nowrap; }
  .editor-menu details div a:hover { color: var(--color-nav-text); }

  @media (max-width: 48rem) {
    .site-sidebar {
      position: sticky;
      width: 100%;
      min-height: 4.25rem;
      flex-direction: row;
      align-items: center;
      gap: 0.75rem;
      padding: 0.55rem 0.75rem;
      border-right: 0;
      border-bottom: 1px solid var(--color-border);
    }
    .brand span,
    .sidebar-search,
    .sidebar-tools,
    .nav-link > svg {
      display: none;
    }
    .brand img {
      width: 2.8rem;
      height: 2.8rem;
    }
    .primary-nav {
      display: flex;
      gap: 0.2rem;
      margin: 0 0 0 auto;
    }
    .nav-link {
      display: block;
      padding: 0.6rem 0.8rem;
    }
  }
</style>
