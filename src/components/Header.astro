---
import SiteSearch from './SiteSearch.astro';
import ThemeToggle from './ThemeToggle.astro';
import { withBase } from '../utils/paths';

const pathname = Astro.url.pathname;
const docsPath = withBase('/docs/');
const servicesPath = withBase('/services/');
const isDocsPage = pathname.startsWith(docsPath);
const isServicesPage = pathname.startsWith(servicesPath);
---

<header class="site-header" data-hidden="false">
  <nav class="primary-nav" aria-label="主导航">
    <a class="home-link" href={withBase()}>
      <img
        src={withBase('/images/brand/asaw-logo.png')}
        alt=""
        width="48"
        height="48"
      />
      <span class="brand-name">人工智能学院学生科协</span>
    </a>
    <a
      class:list={['nav-link', { 'nav-link--current': isDocsPage }]}
      href={docsPath}
      aria-current={isDocsPage ? 'page' : undefined}>文档</a
    >
    <span
      class="nav-link nav-link--upcoming"
      aria-disabled="true"
      title="活动区将在后续实现">活动</span
    >
    <a
      class:list={['nav-link', { 'nav-link--current': isServicesPage }]}
      href={servicesPath}
      aria-current={isServicesPage ? 'page' : undefined}>服务</a
    >
  </nav>

  <div class="header-actions">
    <ThemeToggle />
    <SiteSearch />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    min-height: 4.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.75rem;
    padding-inline: clamp(0.75rem, 2vw, 1.5rem) clamp(1rem, 4vw, 3.5rem);
    background: var(--color-nav);
    color: var(--color-nav-text);
    border-bottom: 1px solid var(--color-border);
    transition: transform 200ms ease;
    will-change: transform;
  }

  .site-header[data-hidden='true'] {
    transform: translateY(-100%);
  }

  .primary-nav,
  .home-link {
    display: flex;
    align-items: center;
  }

  .primary-nav {
    min-width: 0;
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }

  .home-link {
    flex: 0 0 auto;
    gap: 0.75rem;
    border-radius: 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    white-space: nowrap;
  }

  .home-link img {
    width: 3rem;
    height: 3rem;
    border: 1px solid color-mix(in srgb, var(--color-nav-text) 18%, transparent);
    border-radius: 999px;
  }

  .nav-link {
    padding: 0.55rem 0.7rem;
    border-radius: 0.45rem;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-link--upcoming {
    color: color-mix(in srgb, var(--color-nav-text) 52%, transparent);
    cursor: not-allowed;
  }

  .nav-link--current {
    position: relative;
    color: var(--color-accent);
  }

  .nav-link--current::after {
    position: absolute;
    right: 0.7rem;
    bottom: 0.2rem;
    left: 0.7rem;
    height: 0.13rem;
    background: currentColor;
    content: '';
  }

  .home-link:hover .brand-name,
  a.nav-link:hover {
    color: var(--color-accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  :global(:root[data-theme='ark']) .site-header {
    border-bottom: 0.25rem solid var(--color-accent);
    background: linear-gradient(
      105deg,
      #111416 0 28%,
      #272c30 28% 29%,
      #15181b 29%
    );
    box-shadow: inset 0 -1px rgb(255 255 255 / 12%);
  }

  :global(:root[data-theme='ark']) .site-header::after {
    position: absolute;
    right: 18%;
    bottom: -0.25rem;
    width: 5.5rem;
    height: 0.25rem;
    background: var(--ark-warning);
    content: '';
  }

  :global(:root[data-theme='ark']) .nav-link {
    border-radius: 0;
    letter-spacing: 0.06em;
  }

  :global(:root[data-theme='ark']) .nav-link--current {
    background: var(--color-accent);
    color: #111416;
    clip-path: polygon(0.4rem 0, 100% 0, calc(100% - 0.4rem) 100%, 0 100%);
  }

  :global(:root[data-theme='ark']) .nav-link--current::after {
    right: 0;
    bottom: 0;
    left: auto;
    width: 28%;
    height: 0.2rem;
    background: var(--ark-warning);
  }

  :global(:root[data-theme='ark']) .nav-link--upcoming::after {
    display: inline-block;
    width: 0.35rem;
    height: 0.35rem;
    margin-left: 0.4rem;
    background: var(--color-accent);
    content: '';
    transform: rotate(45deg);
  }

  :global(:root[data-theme='stardew']) .site-header {
    border-bottom: 0.3rem solid var(--stardew-wood);
    background:
      repeating-linear-gradient(
        90deg,
        rgb(255 255 255 / 4%) 0 3rem,
        rgb(31 67 46 / 7%) 3rem 3.15rem
      ),
      linear-gradient(rgb(255 255 255 / 5%), transparent), var(--color-nav);
    box-shadow:
      0 0.25rem 0 #193b2a,
      inset 0 0.12rem 0 rgb(255 244 207 / 14%);
  }

  :global(:root[data-theme='stardew']) .site-header::before,
  :global(:root[data-theme='stardew']) .site-header::after {
    position: absolute;
    bottom: -0.38rem;
    width: 0.7rem;
    height: 0.7rem;
    border: 0.12rem solid #704429;
    background: var(--stardew-gold);
    content: '';
    transform: rotate(45deg);
  }

  :global(:root[data-theme='stardew']) .site-header::before {
    left: 1rem;
  }

  :global(:root[data-theme='stardew']) .site-header::after {
    right: 1rem;
  }

  :global(:root[data-theme='stardew']) .home-link img {
    border: 0.15rem solid #f4d278;
    box-shadow: 0.15rem 0.15rem 0 #193b2a;
    image-rendering: pixelated;
  }

  :global(:root[data-theme='stardew']) .nav-link {
    border: 0.12rem solid #1c432e;
    border-radius: 0.35rem;
    background: rgb(20 56 37 / 45%);
    box-shadow: inset 0 1px rgb(255 244 207 / 12%);
    text-shadow: 0.08rem 0.08rem 0 #193b2a;
  }

  :global(:root[data-theme='stardew']) .nav-link--current {
    background: var(--stardew-gold);
    color: #4b3020;
    box-shadow: 0.16rem 0.16rem 0 var(--stardew-shadow);
    text-shadow: none;
  }

  :global(:root[data-theme='stardew']) .nav-link--current::after {
    display: none;
  }

  @media (max-width: 64rem) {
    .brand-name {
      display: none;
    }
  }

  @media (max-width: 36rem) {
    .site-header {
      min-height: 4rem;
      flex-wrap: wrap;
      padding: 0.6rem 0.75rem;
    }

    .primary-nav,
    .header-actions {
      width: 100%;
    }

    .primary-nav {
      justify-content: space-between;
      gap: 0.25rem;
    }

    .header-actions :global(.site-search) {
      width: auto;
      flex: 1;
    }

    .home-link img {
      width: 2.65rem;
      height: 2.65rem;
    }

    .header-actions {
      gap: 0.45rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }
</style>

<script>
  const setupAutoHideHeader = () => {
    const header = document.querySelector<HTMLElement>('.site-header');

    if (!header || header.dataset.scrollReady === 'true') return;

    header.dataset.scrollReady = 'true';
    let previousScrollY = window.scrollY;
    let frameRequested = false;

    const updateHeader = () => {
      const currentScrollY = window.scrollY;
      const movement = currentScrollY - previousScrollY;

      if (currentScrollY <= header.offsetHeight) {
        header.dataset.hidden = 'false';
      } else if (movement > 4) {
        header.dataset.hidden = 'true';
      } else if (movement < -4) {
        header.dataset.hidden = 'false';
      }

      previousScrollY = currentScrollY;
      frameRequested = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (frameRequested) return;
        frameRequested = true;
        window.requestAnimationFrame(updateHeader);
      },
      { passive: true },
    );

    header.addEventListener('focusin', () => {
      header.dataset.hidden = 'false';
    });
  };

  setupAutoHideHeader();
  document.addEventListener('astro:page-load', setupAutoHideHeader);
</script>
