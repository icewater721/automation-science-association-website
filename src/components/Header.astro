---
import SiteSearch from './SiteSearch.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header" data-hidden="false">
  <nav class="primary-nav" aria-label="主导航">
    <a class="home-link" href="/">
      <img src="/images/brand/asaw-logo.png" alt="" width="48" height="48" />
      <span class="brand-name">人工智能学院学生科协</span>
    </a>
    <a class="nav-link" href="/docs/">文档</a>
    <span
      class="nav-link nav-link--upcoming"
      aria-disabled="true"
      title="活动区将在后续实现">活动</span
    >
    <a class="nav-link" href="/services/">服务</a>
  </nav>

  <div class="header-actions">
    <ThemeToggle />
    <SiteSearch />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    min-height: 4.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.75rem;
    padding-inline: clamp(0.75rem, 2vw, 1.5rem) clamp(1rem, 4vw, 3.5rem);
    background: var(--color-nav);
    color: var(--color-nav-text);
    border-bottom: 1px solid var(--color-border);
    transition: transform 200ms ease;
    will-change: transform;
  }

  .site-header[data-hidden='true'] {
    transform: translateY(-100%);
  }

  .primary-nav,
  .home-link {
    display: flex;
    align-items: center;
  }

  .primary-nav {
    min-width: 0;
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }

  .home-link {
    flex: 0 0 auto;
    gap: 0.75rem;
    border-radius: 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    white-space: nowrap;
  }

  .home-link img {
    width: 3rem;
    height: 3rem;
    border: 1px solid color-mix(in srgb, var(--color-nav-text) 18%, transparent);
    border-radius: 999px;
  }

  .nav-link {
    padding: 0.55rem 0.7rem;
    border-radius: 0.45rem;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-link--upcoming {
    color: color-mix(in srgb, var(--color-nav-text) 52%, transparent);
    cursor: not-allowed;
  }

  .home-link:hover .brand-name,
  a.nav-link:hover {
    color: var(--color-accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  :global(:root[data-theme='ark']) .site-header {
    border-bottom-color: var(--color-accent);
  }

  :global(:root[data-theme='ark']) .nav-link {
    border-radius: 0;
  }

  :global(:root[data-theme='ark']) .nav-link--upcoming::after {
    display: inline-block;
    width: 0.35rem;
    height: 0.35rem;
    margin-left: 0.4rem;
    background: var(--color-accent);
    content: '';
    transform: rotate(45deg);
  }

  @media (max-width: 64rem) {
    .brand-name {
      display: none;
    }
  }

  @media (max-width: 36rem) {
    .site-header {
      min-height: 4rem;
      flex-wrap: wrap;
      padding: 0.6rem 0.75rem;
    }

    .primary-nav,
    .header-actions {
      width: 100%;
    }

    .primary-nav {
      justify-content: space-between;
      gap: 0.25rem;
    }

    .header-actions :global(.site-search) {
      width: auto;
      flex: 1;
    }

    .home-link img {
      width: 2.65rem;
      height: 2.65rem;
    }

    .header-actions {
      gap: 0.45rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }
</style>

<script>
  const setupAutoHideHeader = () => {
    const header = document.querySelector<HTMLElement>('.site-header');

    if (!header || header.dataset.scrollReady === 'true') return;

    header.dataset.scrollReady = 'true';
    let previousScrollY = window.scrollY;
    let frameRequested = false;

    const updateHeader = () => {
      const currentScrollY = window.scrollY;
      const movement = currentScrollY - previousScrollY;

      if (currentScrollY <= header.offsetHeight) {
        header.dataset.hidden = 'false';
      } else if (movement > 4) {
        header.dataset.hidden = 'true';
      } else if (movement < -4) {
        header.dataset.hidden = 'false';
      }

      previousScrollY = currentScrollY;
      frameRequested = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (frameRequested) return;
        frameRequested = true;
        window.requestAnimationFrame(updateHeader);
      },
      { passive: true },
    );

    header.addEventListener('focusin', () => {
      header.dataset.hidden = 'false';
    });
  };

  setupAutoHideHeader();
  document.addEventListener('astro:page-load', setupAutoHideHeader);
</script>
