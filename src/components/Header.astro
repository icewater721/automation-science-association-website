---
import SiteSearch from './SiteSearch.astro';
import ThemeToggle from './ThemeToggle.astro';
import { withBase } from '../utils/paths';

const pathname = Astro.url.pathname;
const homePath = withBase();
const docsPath = withBase('/docs/');
const articlesPath = withBase('/articles/');
const loginPath = withBase('/login/');
const isHomePage = pathname === homePath;
const isDocsPage = pathname.startsWith(docsPath);
const isArticlesPage = pathname.startsWith(articlesPath);
---

<aside class="site-sidebar">
  <a class="brand" href={homePath} aria-label="人工智能学院学生科协首页">
    <img
      src={withBase('/images/brand/asaw-logo.png')}
      alt=""
      width="56"
      height="56"
    />
    <span>
      <strong>人工智能与自动化学院科协</strong>
      <small><b>WUST</b><span>AI &amp; AUTOMATION</span></small>
    </span>
  </a>

  <div class="sidebar-search">
    <SiteSearch placement="sidebar" />
  </div>

  <nav class="primary-nav" aria-label="主导航">
    <a
      class:list={['nav-link', { 'nav-link--current': isHomePage }]}
      href={homePath}
      aria-current={isHomePage ? 'page' : undefined}
    >
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="m3 11 9-7 9 7"></path>
        <path d="M5.5 10v10h13V10M9.5 20v-6h5v6"></path>
      </svg>
      首页
    </a>
    <a
      class:list={['nav-link', { 'nav-link--current': isDocsPage }]}
      href={docsPath}
      aria-current={isDocsPage ? 'page' : undefined}
    >
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="M6 3.5h8l4 4V20.5H6Z"></path>
        <path d="M14 3.5v4h4M9 12h6M9 16h6"></path>
      </svg>
      文档
    </a>
    <a
      class:list={['nav-link', { 'nav-link--current': isArticlesPage }]}
      href={articlesPath}
      aria-current={isArticlesPage ? 'page' : undefined}
    >
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="M5 4.5h14v15H5Z"></path>
        <path d="M8.5 8h7M8.5 12h7M8.5 16h4"></path>
      </svg>
      文章
    </a>
  </nav>

  <div class="sidebar-tools">
    <div class="tool-row">
      <a
        class="tool-link login-link"
        href={loginPath}
        aria-label="个人登录"
        title="个人登录"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <circle cx="12" cy="8" r="3.5"></circle>
          <path d="M5.5 20c.5-4 2.7-6 6.5-6s6 2 6.5 6"></path>
        </svg>
      </a>
      <a
        class="tool-link github-link"
        href="https://github.com/icewater721/automation-science-association-website"
        target="_blank"
        rel="noreferrer"
        aria-label="在 GitHub 查看网站仓库"
        title="GitHub 仓库"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path
            d="M12 2.7a9.4 9.4 0 0 0-3 18.3c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 0 1.6 1.1 1.6 1.1.9 1.6 2.4 1.1 3 .8.1-.7.4-1.1.7-1.4-2.2-.3-4.6-1.1-4.6-4.7 0-1 .4-1.9 1-2.6-.1-.3-.4-1.3.1-2.6 0 0 .8-.3 2.7 1a9.2 9.2 0 0 1 4.9 0c1.9-1.3 2.7-1 2.7-1 .5 1.3.2 2.3.1 2.6.7.7 1 1.6 1 2.6 0 3.6-2.4 4.4-4.6 4.7.4.3.7.9.7 1.8v2.7c0 .4.2.6.7.5A9.4 9.4 0 0 0 12 2.7Z"
          ></path>
        </svg>
      </a>
      <ThemeToggle />
    </div>
  </div>
</aside>

<style>
  .site-sidebar {
    position: fixed;
    z-index: 100;
    inset: 0 auto 0 0;
    display: flex;
    width: var(--site-sidebar-width);
    flex-direction: column;
    padding: 1.4rem 1rem 1rem;
    border-right: 1px solid var(--color-border);
    background: var(--color-nav);
    color: var(--color-nav-text);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.45rem;
    border-radius: 0.65rem;
    text-decoration: none;
  }

  .brand:hover,
  .nav-link:hover {
    background: color-mix(in srgb, var(--color-nav-text) 6%, transparent);
  }

  .brand img {
    width: 3.25rem;
    height: 3.25rem;
    flex: 0 0 auto;
    border: 1px solid color-mix(in srgb, var(--color-nav-text) 16%, transparent);
    border-radius: 50%;
  }

  .brand span {
    display: grid;
    min-width: 0;
    gap: 0.18rem;
  }

  .brand strong {
    font-size: 0.78rem;
    line-height: 1.35;
    white-space: nowrap;
  }
  .brand small {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: color-mix(in srgb, var(--color-nav-text) 62%, transparent);
    font-family: ui-serif, Georgia, serif;
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.35;
  }

  .brand small b {
    padding-right: 0.35rem;
    border-right: 1px solid currentColor;
    color: var(--color-nav-text);
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 0.48rem;
  }

  .primary-nav {
    display: grid;
    gap: 0.35rem;
    margin-top: 1.5rem;
  }

  .sidebar-search {
    margin-top: 1.5rem;
  }

  .nav-link {
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-items: center;
    padding: 0.72rem 0.8rem;
    border-radius: 0.55rem;
    color: color-mix(in srgb, var(--color-nav-text) 68%, transparent);
    font-size: 0.92rem;
    font-weight: 650;
    text-decoration: none;
  }

  .nav-link > svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .nav-link:hover {
    color: var(--color-nav-text);
  }
  .nav-link--current,
  .nav-link--current:hover {
    background: var(--color-nav-text);
    color: var(--color-nav);
  }

  .sidebar-tools {
    display: grid;
    gap: 0.8rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .tool-row {
    display: grid;
    grid-template-columns: repeat(3, 2.75rem);
    min-height: 2.75rem;
    align-items: center;
    justify-content: space-between;
  }

  .tool-link {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border-radius: 999px;
    color: var(--color-nav-text);
  }

  .tool-link:hover {
    background: color-mix(in srgb, var(--color-nav-text) 10%, transparent);
  }

  .tool-link svg {
    width: 1.45rem;
    height: 1.45rem;
  }

  .github-link svg {
    fill: currentColor;
  }

  .login-link svg {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  @media (max-width: 48rem) {
    .site-sidebar {
      position: sticky;
      width: 100%;
      min-height: 4.25rem;
      flex-direction: row;
      align-items: center;
      gap: 0.75rem;
      padding: 0.55rem 0.75rem;
      border-right: 0;
      border-bottom: 1px solid var(--color-border);
    }
    .brand span,
    .sidebar-search,
    .sidebar-tools,
    .nav-link > svg {
      display: none;
    }
    .brand img {
      width: 2.8rem;
      height: 2.8rem;
    }
    .primary-nav {
      display: flex;
      gap: 0.2rem;
      margin: 0 0 0 auto;
    }
    .nav-link {
      display: block;
      padding: 0.6rem 0.8rem;
    }
  }
</style>
