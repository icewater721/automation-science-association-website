---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div>
    <p class="footer-brand">人工智能与自动化学院学生科协</p>
    <p class="footer-english">
      <span>Automation</span><span>Science</span><span>Association</span>
    </p>
  </div>
  <p>&copy; {currentYear} ASAW</p>
</footer>

<style>
  .site-footer {
    display: flex;
    width: min(64rem, calc(100% - clamp(3rem, 10vw, 8rem)));
    min-height: 9rem;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-inline: auto;
    padding-block: 2.5rem;
    color: var(--color-text-muted);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .site-footer p {
    margin: 0.35rem 0 0;
  }

  .footer-brand {
    color: var(--color-text);
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .footer-english {
    display: flex;
    width: min(100%, 20rem);
    justify-content: space-between;
    gap: 1.25rem;
  }

  @media (max-width: 38rem) {
    .site-footer {
      width: min(100% - 2rem, 64rem);
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
