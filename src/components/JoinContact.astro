---
import { joinContactContent } from '../data/site';
import { withBase } from '../utils/paths';
---

<section class="join-contact" id="services" aria-labelledby="join-title">
  <div class="join-inner">
    <div class="section-heading">
      <p>加入与联系</p>
      <h2 id="join-title">{joinContactContent.heading}</h2>
    </div>

    <div class="action-grid">
      <article>
        <span class="panel-code" aria-hidden="true">02-A / JOIN</span>
        <h3>加入我们</h3>
        <p>{joinContactContent.join.description}</p>
        <div class="panel-status">
          <span class="status-dot" aria-hidden="true"></span>{
            joinContactContent.join.status
          }
        </div>
      </article>

      <article id="contact">
        <span class="panel-code" aria-hidden="true">02-B / CONTACT</span>
        <h3>联系我们</h3>
        <p>{joinContactContent.contact.description}</p>
        <div class="panel-links">
          <a href={withBase('/articles/')}
            >查看文章 <span aria-hidden="true">↗</span></a
          >
          <a href={`mailto:${joinContactContent.contact.email}`}
            >{joinContactContent.contact.email}</a
          >
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .join-contact {
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }

  .join-inner {
    width: min(64rem, calc(100% - clamp(3rem, 10vw, 8rem)));
    margin-inline: auto;
  }

  .section-heading {
    max-width: 44rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }

  .section-heading p {
    margin: 0 0 0.8rem;
    color: var(--color-accent);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  h2 {
    margin: 0;
    font-size: clamp(2rem, 3.5vw, 3.15rem);
    line-height: 1.1;
    letter-spacing: -0.045em;
  }

  .action-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  article {
    display: grid;
    min-height: 16rem;
    align-content: start;
    overflow: hidden;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: var(--color-surface);
  }

  h3 {
    margin: 0 0 1rem;
    font-size: clamp(1.65rem, 3vw, 2.3rem);
    letter-spacing: -0.04em;
  }

  .panel-code {
    display: none;
  }

  article > p {
    max-width: 32rem;
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.75;
  }

  .panel-status,
  .panel-links {
    align-self: end;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.88rem;
  }

  .panel-status {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
  }

  .status-dot {
    width: 0.5rem;
    height: 0.5rem;
    flex: 0 0 auto;
    margin-top: 0.3rem;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .panel-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .panel-links a {
    font-weight: 700;
    text-decoration: none;
  }

  .panel-links a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 46rem) {
    .join-inner {
      width: min(100% - 2rem, 64rem);
    }

    .action-grid {
      grid-template-columns: 1fr;
    }

    article {
      min-height: auto;
    }
  }
</style>
