<button
  class="theme-toggle"
  type="button"
  aria-label="切换到深色模式"
  title="切换到深色模式"
  data-theme-toggle
>
  <svg class="sun-icon" aria-hidden="true" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="3.5"></circle>
    <path
      d="M12 2v2.4M12 19.6V22M2 12h2.4M19.6 12H22M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M19.1 4.9l-1.7 1.7M6.6 17.4l-1.7 1.7"
    ></path>
  </svg>
  <svg class="moon-icon" aria-hidden="true" viewBox="0 0 24 24">
    <path d="M19.8 15.2A8 8 0 0 1 8.8 4.2 8.2 8.2 0 1 0 19.8 15.2Z"></path>
  </svg>
</button>

<script>
  const setupThemeToggle = () => {
    const toggle = document.querySelector<HTMLButtonElement>(
      '[data-theme-toggle]',
    );
    if (!toggle || toggle.dataset.ready === 'true') return;
    toggle.dataset.ready = 'true';

    const updateLabel = () => {
      const isDark = document.documentElement.dataset.theme === 'dark';
      const label = isDark ? '切换到浅色模式' : '切换到深色模式';
      toggle.setAttribute('aria-label', label);
      toggle.title = label;
    };

    updateLabel();
    toggle.addEventListener('click', () => {
      const nextTheme =
        document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = nextTheme;
      localStorage.setItem('asaw-theme', nextTheme);
      updateLabel();
    });
  };

  setupThemeToggle();
  document.addEventListener('astro:page-load', setupThemeToggle);
</script>

<style>
  .theme-toggle {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    flex: 0 0 auto;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-nav-text);
    cursor: pointer;
  }

  .theme-toggle:hover {
    background: color-mix(in srgb, var(--color-nav-text) 10%, transparent);
  }

  .theme-toggle svg {
    grid-area: 1 / 1;
    width: 1.55rem;
    height: 1.55rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .moon-icon {
    display: none;
  }

  :global(:root[data-theme='dark']) .sun-icon {
    display: none;
  }

  :global(:root[data-theme='dark']) .moon-icon {
    display: block;
  }
</style>
