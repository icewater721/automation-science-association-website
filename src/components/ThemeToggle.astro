<div class="theme-picker" data-theme-picker>
  <button
    class="theme-trigger"
    type="button"
    aria-label="选择颜色模式"
    aria-haspopup="menu"
    aria-expanded="false"
    data-theme-trigger
  >
    <span class="current-theme-icon" aria-hidden="true">
      <svg
        class="is-current"
        data-current-theme-icon="light"
        viewBox="0 0 24 24"
      >
        <circle cx="12" cy="12" r="3.5"></circle>
        <path
          d="M12 2v2.4M12 19.6V22M2 12h2.4M19.6 12H22M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M19.1 4.9l-1.7 1.7M6.6 17.4l-1.7 1.7"
        ></path>
      </svg>
      <svg data-current-theme-icon="dark" viewBox="0 0 24 24">
        <path d="M19.8 15.2A8 8 0 0 1 8.8 4.2 8.2 8.2 0 1 0 19.8 15.2Z"></path>
      </svg>
      <svg data-current-theme-icon="ark" viewBox="0 0 24 24">
        <path d="M12 2.8 21 19H3L12 2.8Z"></path>
        <path d="m8 15.6 4-7.2 4 7.2M6.2 19l2.1-3.8h7.4l2.1 3.8"></path>
      </svg>
    </span>
    <svg class="chevron" aria-hidden="true" viewBox="0 0 24 24"
      ><path d="m8 10 4 4 4-4"></path></svg
    >
  </button>

  <div
    class="theme-menu"
    role="menu"
    aria-label="颜色模式"
    hidden
    data-theme-menu
  >
    <button
      type="button"
      role="menuitemradio"
      aria-label="浅色"
      title="浅色"
      data-theme-option="light"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="3.5"></circle>
        <path
          d="M12 2v2.4M12 19.6V22M2 12h2.4M19.6 12H22M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M19.1 4.9l-1.7 1.7M6.6 17.4l-1.7 1.7"
        ></path>
      </svg>
    </button>
    <button
      type="button"
      role="menuitemradio"
      aria-label="深色"
      title="深色"
      data-theme-option="dark"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="M19.8 15.2A8 8 0 0 1 8.8 4.2 8.2 8.2 0 1 0 19.8 15.2Z"></path>
      </svg>
    </button>
    <button
      type="button"
      role="menuitemradio"
      aria-label="明日方舟风格"
      title="明日方舟风格"
      data-theme-option="ark"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="M12 2.8 21 19H3L12 2.8Z"></path>
        <path d="m8 15.6 4-7.2 4 7.2M6.2 19l2.1-3.8h7.4l2.1 3.8"></path>
      </svg>
    </button>
  </div>
</div>

<script>
  type Theme = 'light' | 'dark' | 'ark';

  const themeNames: Record<Theme, string> = {
    light: '浅色',
    dark: '深色',
    ark: '明日方舟风格',
  };

  const setupThemePicker = () => {
    const picker = document.querySelector<HTMLElement>('[data-theme-picker]');
    if (!picker || picker.dataset.ready === 'true') return;
    picker.dataset.ready = 'true';

    const trigger = picker.querySelector<HTMLButtonElement>(
      '[data-theme-trigger]',
    );
    const menu = picker.querySelector<HTMLElement>('[data-theme-menu]');
    const currentIcons = Array.from(
      picker.querySelectorAll<SVGElement>('[data-current-theme-icon]'),
    );
    const options = Array.from(
      picker.querySelectorAll<HTMLButtonElement>('[data-theme-option]'),
    );
    if (!trigger || !menu) return;

    const closeMenu = () => {
      menu.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
    };

    const updatePicker = () => {
      const theme = (document.documentElement.dataset.theme ??
        'light') as Theme;
      trigger.setAttribute(
        'aria-label',
        `当前主题：${themeNames[theme]}；选择颜色模式`,
      );
      trigger.title = themeNames[theme];
      for (const icon of currentIcons) {
        icon.classList.toggle(
          'is-current',
          icon.dataset.currentThemeIcon === theme,
        );
      }
      for (const option of options) {
        option.setAttribute(
          'aria-checked',
          String(option.dataset.themeOption === theme),
        );
      }
    };

    updatePicker();
    trigger.addEventListener('click', () => {
      const opening = menu.hidden;
      menu.hidden = !opening;
      trigger.setAttribute('aria-expanded', String(opening));
      if (opening) options[0]?.focus();
    });

    for (const option of options) {
      option.addEventListener('click', () => {
        const theme = option.dataset.themeOption as Theme;
        document.documentElement.dataset.theme = theme;
        localStorage.setItem('asaw-theme', theme);
        updatePicker();
        closeMenu();
        trigger.focus();
      });
    }

    picker.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeMenu();
        trigger.focus();
        return;
      }

      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        const currentIndex = options.indexOf(
          document.activeElement as HTMLButtonElement,
        );
        const step = event.key === 'ArrowDown' ? 1 : -1;
        const nextIndex =
          (currentIndex + step + options.length) % options.length;
        options[nextIndex]?.focus();
      }
    });
    document.addEventListener('pointerdown', (event) => {
      if (!picker.contains(event.target as Node)) closeMenu();
    });
  };

  setupThemePicker();
  document.addEventListener('astro:page-load', setupThemePicker);
</script>

<style>
  .theme-picker {
    position: relative;
    flex: 0 0 auto;
  }
  .theme-trigger {
    display: flex;
    height: 2.5rem;
    align-items: center;
    gap: 0.3rem;
    padding-inline: 0.65rem 0.5rem;
    border: 1px solid color-mix(in srgb, var(--color-nav-text) 28%, transparent);
    border-radius: 0.55rem;
    background: transparent;
    color: var(--color-nav-text);
    font: inherit;
    font-size: 0.86rem;
    cursor: pointer;
  }
  .theme-trigger:hover,
  .theme-menu button:hover,
  .theme-menu button:focus-visible {
    background: color-mix(in srgb, var(--color-nav-text) 10%, transparent);
  }
  .theme-trigger svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }
  .current-theme-icon {
    display: grid;
    width: 1.1rem;
    height: 1.1rem;
    place-items: center;
  }
  .current-theme-icon svg {
    display: none;
  }
  .current-theme-icon svg.is-current {
    display: block;
  }
  .theme-trigger .chevron {
    width: 0.8rem;
  }
  .theme-menu {
    position: absolute;
    z-index: 30;
    top: calc(100% + 0.55rem);
    right: 0;
    display: grid;
    grid-template-columns: repeat(3, 2.65rem);
    gap: 0.25rem;
    padding: 0.3rem;
    border: 1px solid var(--color-border);
    border-radius: 0.65rem;
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: 0 0.8rem 2rem rgb(0 0 0 / 18%);
  }
  .theme-menu[hidden] {
    display: none;
  }
  .theme-menu button {
    display: grid;
    width: 2.65rem;
    height: 2.65rem;
    place-items: center;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 0.4rem;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .theme-menu button svg {
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .theme-menu button[data-theme-option='light'] {
    border-color: #d6d6d6;
    background: #ffffff;
    color: #111111;
  }

  .theme-menu button[data-theme-option='dark'] {
    border-color: #3d3d3d;
    border-radius: 999px;
    background: #050505;
    color: #ffffff;
  }

  .theme-menu button[data-theme-option='ark'] {
    border-color: #18a9ff;
    border-left-width: 0.3rem;
    border-radius: 0;
    background:
      linear-gradient(90deg, transparent 0 76%, rgb(24 169 255 / 16%) 76%),
      #101418;
    color: #ffffff;
    clip-path: polygon(
      0 0,
      calc(100% - 0.7rem) 0,
      100% 0.7rem,
      100% 100%,
      0 100%
    );
  }
  .theme-menu button[aria-checked='true']::after {
    position: absolute;
    right: 0.15rem;
    bottom: 0.15rem;
    width: 0.35rem;
    height: 0.35rem;
    background: currentColor;
    content: '';
    transform: rotate(45deg);
  }
  .theme-menu button {
    position: relative;
  }
  :global(:root[data-theme='ark']) .theme-trigger,
  :global(:root[data-theme='ark']) .theme-menu {
    border-radius: 0;
  }

  :global(:root[data-theme='light']) .theme-trigger {
    border-radius: 999px;
    background: #ffffff;
  }

  :global(:root[data-theme='dark']) .theme-trigger {
    border-radius: 0.35rem;
    background: #050505;
  }

  :global(:root[data-theme='ark']) .theme-trigger {
    border-left: 0.25rem solid var(--color-accent);
    background: linear-gradient(
      105deg,
      #0e1216 0 78%,
      rgb(24 169 255 / 18%) 78%
    );
    clip-path: polygon(
      0 0,
      calc(100% - 0.65rem) 0,
      100% 0.65rem,
      100% 100%,
      0 100%
    );
  }
</style>
