<button
  class="theme-toggle"
  type="button"
  aria-label="切换为深色模式"
  title="切换颜色模式"
>
  <svg
    class="theme-icon theme-icon--sun"
    aria-hidden="true"
    viewBox="0 0 24 24"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"
    ></path>
  </svg>
  <svg
    class="theme-icon theme-icon--moon"
    aria-hidden="true"
    viewBox="0 0 24 24"
  >
    <path d="M20.5 14.1A8.5 8.5 0 0 1 9.9 3.5 8.5 8.5 0 1 0 20.5 14.1Z"></path>
  </svg>
  <span class="visually-hidden">切换颜色模式</span>
</button>

<script>
  const setupThemeToggle = () => {
    const button = document.querySelector<HTMLButtonElement>('.theme-toggle');

    if (!button || button.dataset.ready === 'true') return;
    button.dataset.ready = 'true';

    const updateLabel = () => {
      const isDark = document.documentElement.dataset.theme === 'dark';
      button.setAttribute(
        'aria-label',
        isDark ? '切换为浅色模式' : '切换为深色模式',
      );
    };

    updateLabel();
    button.addEventListener('click', () => {
      const nextTheme =
        document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = nextTheme;
      localStorage.setItem('asaw-theme', nextTheme);
      updateLabel();
    });
  };

  setupThemeToggle();
  document.addEventListener('astro:page-load', setupThemeToggle);
</script>

<style>
  .theme-toggle {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    flex: 0 0 auto;
    padding: 0;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--color-nav-text) 28%, transparent);
    border-radius: 999px;
    background: transparent;
    color: var(--color-nav-text);
    cursor: pointer;
  }

  .theme-toggle:hover {
    background: color-mix(in srgb, var(--color-nav-text) 12%, transparent);
  }

  .theme-icon {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  :global(:root[data-theme='light']) .theme-icon--sun,
  :global(:root[data-theme='dark']) .theme-icon--moon {
    display: none;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
