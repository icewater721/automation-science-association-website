---
import DepartmentSection from '../components/DepartmentSection.astro';
import Footer from '../components/Footer.astro';
import JoinContact from '../components/JoinContact.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="首页 | 武科大人工智能学院科协"
  description="首页 | 武科大人工智能学院科协"
>
  <main id="main-content" class="home-content" data-home-content>
    <DepartmentSection />
    <JoinContact />
  </main>
  <Footer />
  <div class="home-loader" data-home-loader aria-hidden="true">
    <span></span><span></span><span></span>
  </div>
</BaseLayout>

<script>
  const revealHome = () => {
    requestAnimationFrame(() => {
      document.querySelector('[data-home-content]')?.classList.add('is-ready');
      document.querySelector('[data-home-loader]')?.classList.add('is-hidden');
    });
  };
  if (document.readyState === 'complete') revealHome();
  else window.addEventListener('load', revealHome, { once: true });
</script>

<style>
  .home-content {
    opacity: 0;
    transform: translateY(0.55rem);
    transition:
      opacity 520ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 620ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .home-content.is-ready {
    opacity: 1;
    transform: none;
  }
  .home-loader {
    position: fixed;
    inset: 0;
    z-index: 20;
    display: grid;
    place-content: center;
    grid-auto-flow: column;
    gap: 0.45rem;
    background: var(--color-page);
    transition:
      opacity 420ms ease,
      visibility 420ms;
  }
  .home-loader span {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: var(--color-accent);
    animation: home-loader 900ms ease-in-out infinite alternate;
  }
  .home-loader span:nth-child(2) {
    animation-delay: 140ms;
  }
  .home-loader span:nth-child(3) {
    animation-delay: 280ms;
  }
  .home-loader.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  @keyframes home-loader {
    from {
      opacity: 0.3;
      transform: translateY(0.2rem);
    }
    to {
      opacity: 1;
      transform: translateY(-0.2rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-content {
      transition: none;
    }
    .home-loader span {
      animation: none;
    }
  }
</style>
