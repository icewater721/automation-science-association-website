---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="武汉科技大学人工智能与自动化学院科协"
  description="武汉科技大学人工智能与自动化学院科学技术协会门户网站"
>
  <main class="project-start" id="main-content">
    <img
      src="/images/brand/asaw-logo.png"
      alt="学院科协 Logo"
      width="160"
      height="160"
    />
    <p>Automation Science Association Website</p>
    <h1>项目初始化完成</h1>
    <p>导航栏、颜色模式和全站搜索正在 Sprint 1 中逐步实现。</p>
  </main>
</BaseLayout>

<style>
  .project-start {
    display: grid;
    min-height: calc(100vh - 4.5rem);
    place-content: center;
    justify-items: center;
    padding: 2rem;
    text-align: center;
  }

  .project-start img {
    margin-bottom: 1.5rem;
  }

  .project-start p {
    max-width: 42rem;
    color: var(--color-text-muted);
  }

  .project-start h1 {
    margin-block: 0.25rem;
  }
</style>
