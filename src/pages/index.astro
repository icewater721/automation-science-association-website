---
import DepartmentSection from '../components/DepartmentSection.astro';
import Footer from '../components/Footer.astro';
import JoinContact from '../components/JoinContact.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="武汉科技大学人工智能与自动化学院科协"
  description="武汉科技大学人工智能与自动化学院学生科学技术协会门户网站"
>
  <main id="main-content">
    <section
      class="about section-shell"
      id="about"
      aria-labelledby="about-title"
    >
      <div class="ark-meta" aria-hidden="true">
        <span>ASAW / HOME</span><span>SYS.ONLINE</span>
      </div>
      <div class="about-copy">
        <p class="section-label">关于科协</p>
        <h1 id="about-title">服务同学的学生科创组织</h1>
        <p>
          武汉科技大学人工智能与自动化学院学生科协面向全院同学，组织科创赛事、服务创新项目、提供双创支持，帮助同学参与科研实践，提升创新能力。
        </p>
      </div>
      <div class="about-principles" aria-label="科协主要工作">
        <span>科创项目</span>
        <span>赛事组织</span>
        <span>学生服务</span>
      </div>
    </section>

    <DepartmentSection />
    <JoinContact />
  </main>
  <Footer />
</BaseLayout>

<style>
  .section-shell {
    width: min(76rem, calc(100% - 2rem));
    margin-inline: auto;
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }

  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(15rem, 0.55fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: end;
  }

  .ark-meta {
    display: none;
  }

  .section-label {
    margin: 0;
    color: var(--color-accent);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  h1 {
    max-width: 12ch;
    margin-block: 1rem 1.5rem;
    font-size: clamp(2.7rem, 5vw, 4.7rem);
    line-height: 1.04;
    letter-spacing: -0.055em;
  }

  .about-copy > p:last-child {
    max-width: 45rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.8;
  }

  .about-principles {
    display: grid;
    border-top: 1px solid var(--color-border);
  }

  .about-principles span {
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.92rem;
    font-weight: 650;
  }

  :global(:root[data-theme='ark']) .about {
    position: relative;
    background-image:
      linear-gradient(var(--color-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px);
    background-size: 3rem 3rem;
    background-position: right top;
  }

  :global(:root[data-theme='ark']) .about::after {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 5rem;
    height: 0.25rem;
    background: var(--color-accent);
    content: '';
  }

  :global(:root[data-theme='ark']) .ark-meta {
    display: flex;
    grid-column: 1 / -1;
    justify-content: space-between;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-family: ui-monospace, 'Cascadia Code', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
  }

  :global(:root[data-theme='ark']) .section-label::before {
    margin-right: 0.55rem;
    content: '01 /';
  }

  @media (max-width: 48rem) {
    .about {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      min-height: auto;
    }

    :global(:root[data-theme='ark']) .ark-meta {
      grid-column: 1;
    }
  }
</style>
