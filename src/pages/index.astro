---
import DepartmentSection from '../components/DepartmentSection.astro';
import Footer from '../components/Footer.astro';
import JoinContact from '../components/JoinContact.astro';
import SiteSearch from '../components/SiteSearch.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="首页 | 武科大人工智能学院科协"
  description="首页 | 武科大人工智能学院科协"
>
  <div class="home-search"><SiteSearch /></div>
  <main id="main-content">
    <DepartmentSection />
    <JoinContact />
  </main>
  <Footer />
</BaseLayout>

<style>
  .home-search {
    width: min(64rem, calc(100% - clamp(3rem, 10vw, 8rem)));
    margin-inline: auto;
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
  }
</style>
