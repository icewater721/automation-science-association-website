---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { withBase } from '../../utils/paths';

export const getStaticPaths = (async () => {
  const entries = await getCollection('docs', ({ data }) => !data.draft);
  const routeForEntry = (id: string) => id.replace(/\/index$/, '');

  return entries
    .filter((entry) => entry.id !== 'index' && entry.data.kind === 'document')
    .map((entry) => ({
      params: { id: routeForEntry(entry.id) },
      props: { entry },
    }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const route = entry.id.replace(/\/index$/, '');
const currentPath = `/docs/${route}/`;
const entries = await getCollection('docs', ({ data }) => !data.draft);
const entryByRoute = new Map(
  entries.map((item) => [item.id.replace(/\/index$/, ''), item]),
);
const routeSegments = route.split('/');
const directoryTitles: Record<string, string> = {
  learning: '学习资料',
  'basic-tools': '基础工具',
};
const breadcrumbs = [
  { title: '文档', href: withBase('/docs/') },
  ...routeSegments.map((_, index) => {
    const segmentRoute = routeSegments.slice(0, index + 1).join('/');
    const segmentEntry = entryByRoute.get(segmentRoute);
    const isCurrent = index === routeSegments.length - 1;

    return {
      title:
        segmentEntry?.data.title ??
        directoryTitles[routeSegments[index] ?? ''] ??
        routeSegments[index],
      href:
        isCurrent || !segmentEntry
          ? undefined
          : withBase(`/docs/${segmentRoute}/`),
    };
  }),
];
const parentRoute = route.includes('/')
  ? route.slice(0, route.lastIndexOf('/'))
  : '';
const siblingDocuments = entries
  .filter((item) => {
    if (item.data.kind !== 'document') return false;
    const itemRoute = item.id.replace(/\/index$/, '');
    const itemParent = itemRoute.includes('/')
      ? itemRoute.slice(0, itemRoute.lastIndexOf('/'))
      : '';
    return itemParent === parentRoute;
  })
  .sort((a, b) => a.data.order - b.data.order);
const currentIndex = siblingDocuments.findIndex((item) => item.id === entry.id);
const navigationItem = (item: (typeof siblingDocuments)[number] | undefined) =>
  item
    ? {
        title: item.data.title,
        href: withBase(`/docs/${item.id.replace(/\/index$/, '')}/`),
      }
    : undefined;
const previous = navigationItem(siblingDocuments[currentIndex - 1]);
const next = navigationItem(siblingDocuments[currentIndex + 1]);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  headings={headings}
  currentPath={currentPath}
  breadcrumbs={breadcrumbs}
  previous={previous}
  next={next}
>
  <Content />
</DocsLayout>
