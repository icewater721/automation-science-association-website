---
import { getEntry, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';

const intro = await getEntry('docs', 'index');

if (!intro) {
  throw new Error('文档中心简介不存在。');
}

const { Content, headings } = await render(intro);
---

<DocsLayout
  title={intro.data.title}
  description={intro.data.description}
  browserTitle="文档 | 人工智能学院科协"
  headings={headings}
  currentPath="/docs/"
>
  <Content />
</DocsLayout>
