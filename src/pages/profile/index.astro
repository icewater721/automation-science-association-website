---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/paths';
---

<BaseLayout title="个人页 | 人工智能学院科协" description="科协成员个人空间。">
  <main
    class="profile-page"
    data-profile-page
    data-loading="true"
    aria-busy="true"
    data-login-url={withBase('/login/')}
  >
    <section class="identity-card">
      <div
        class="cover image-edit-target"
        data-cover
        data-image-target="background"
        role="button"
        tabindex="0"
        aria-label="悬停 0.5 秒后更换背景图"
      >
        <span>更换背景图</span>
      </div>
      <div class="identity-content">
        <div class="profile-actions">
          <div
            class="avatar image-edit-target"
            data-avatar
            data-image-target="avatar"
            role="button"
            tabindex="0"
            aria-label="悬停 0.5 秒后更换头像"
          >
            <svg
              class="avatar-placeholder"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-4.42 0-8 2.24-8 5v1h16v-1c0-2.76-3.58-5-8-5Z"
              ></path>
            </svg>
            <span>更换头像</span>
          </div>
        </div>
        <div class="identity-copy">
          <p class="role" data-profile-role>REGISTERED MEMBER</p>
          <h1 data-display-name tabindex="0" title="单击编辑昵称">
            正在读取……
          </h1>
          <p class="signature" title="单击编辑个性签名">
            <span data-bio tabindex="0">用一句话介绍自己</span>
          </p>
          <p class="profile-note" data-profile-note aria-live="polite"></p>
        </div>
      </div>
    </section>
    <input
      data-avatar-input
      type="file"
      accept="image/png,image/jpeg,image/webp"
      hidden
    />
    <input
      data-background-input
      type="file"
      accept="image/png,image/jpeg,image/webp"
      hidden
    />

    <section class="profile-section">
      <header><p>PUBLICATIONS</p><h2>我发布的文章</h2></header>
      <div class="empty-state">
        <strong>还没有文章</strong><span
          >获得编辑权限并发布文章后，它们会出现在这里。</span
        >
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { isSupabaseConfigured, supabase } from '../../lib/supabase';

  const page = document.querySelector<HTMLElement>('[data-profile-page]');
  const nameElement = document.querySelector<HTMLElement>(
    '[data-display-name]',
  );
  const bioElement = document.querySelector<HTMLElement>('[data-bio]');
  const avatarElement = document.querySelector<HTMLElement>('[data-avatar]');
  const coverElement = document.querySelector<HTMLElement>('[data-cover]');
  const note = document.querySelector<HTMLElement>('[data-profile-note]');
  const roleElement = document.querySelector<HTMLElement>('[data-profile-role]');
  const avatarInput = document.querySelector<HTMLInputElement>(
    '[data-avatar-input]',
  );
  const backgroundInput = document.querySelector<HTMLInputElement>(
    '[data-background-input]',
  );
  let userId = '';
  let currentProfile: Record<string, unknown> = {};
  const NAME_MAX_LENGTH = 12;
  const BIO_MAX_LENGTH = 30;
  const countCharacters = (value: string) => Array.from(value).length;
  const formatCount = (value: string, maximum: number) =>
    `${String(countCharacters(value)).padStart(2, '0')}/${maximum}`;

  const goToLogin = () =>
    window.location.replace(page?.dataset.loginUrl ?? '/');
  if (!isSupabaseConfigured || !supabase) goToLogin();

  const { data: sessionData } = (await supabase?.auth.getSession()) ?? {
    data: { session: null },
  };
  if (!sessionData.session) goToLogin();
  userId = sessionData.session?.user.id ?? '';

  const applyProfile = (profile: Record<string, unknown>) => {
    currentProfile = { ...currentProfile, ...profile };
    const displayName = Array.from(
      String(profile.display_name || '未设置昵称'),
    )
      .slice(0, NAME_MAX_LENGTH)
      .join('');
    const bio = Array.from(
      String(profile.bio || '用一句话介绍自己，或者留下你最近正在探索的事情。'),
    )
      .slice(0, BIO_MAX_LENGTH)
      .join('');
    currentProfile.bio = bio;
    currentProfile.display_name = displayName;
    const role = profile.role === 'admin' ? 'admin' : profile.role === 'editor' ? 'editor' : '';
    if (nameElement) nameElement.textContent = displayName;
    if (bioElement) bioElement.textContent = bio;
    if (roleElement)
      roleElement.textContent =
        role === 'admin'
          ? 'ADMINISTRATOR'
          : role === 'editor'
            ? 'EDITOR'
            : 'REGISTERED MEMBER';
    if (avatarElement) {
      const avatarUrl = String(profile.avatar_url || '');
      avatarElement.classList.toggle('has-image', Boolean(avatarUrl));
      avatarElement.style.backgroundImage = avatarUrl
        ? `url("${avatarUrl}")`
        : '';
    }
    const backgroundUrl = String(profile.background_url || '');
    if (coverElement)
      coverElement.style.backgroundImage = backgroundUrl
        ? `url("${backgroundUrl}")`
        : '';
  };

  let { data: profile, error: profileError } = (await supabase
    ?.from('profiles')
    .select('display_name,bio,avatar_url,background_url,role')
    .eq('user_id', userId)
    .single()) ?? { data: null, error: null };
  if (profileError?.code === '42703') {
    const legacyResult = await supabase!
      .from('profiles')
      .select('display_name,bio,avatar_url,background_url,is_collaborator')
      .eq('user_id', userId)
      .single();
    profile = legacyResult.data
      ? {
          ...legacyResult.data,
          role: legacyResult.data.is_collaborator ? 'editor' : null,
        }
      : null;
    profileError = legacyResult.error;
  }
  if (profile) applyProfile(profile);
  if (profileError && note) {
    note.textContent = '个人资料加载失败，请稍后重试。';
    note.dataset.error = 'true';
  }
  window.requestAnimationFrame(() => {
    if (!page) return;
    page.dataset.loading = 'false';
    page.setAttribute('aria-busy', 'false');
  });

  const setNote = (message: string, error = false) => {
    if (!note) return;
    note.textContent = message;
    note.dataset.error = String(error);
  };

  const updateProfile = async (updates: Record<string, string>) => {
    const { data, error } = await supabase!
      .from('profiles')
      .update({ ...updates, updated_at: new Date().toISOString() })
      .eq('user_id', userId)
      .select()
      .single();
    if (error) {
      setNote(error.message, true);
      return false;
    }
    applyProfile(data);
    setNote('');
    return true;
  };

  const beginInlineEdit = (
    element: HTMLElement,
    field: 'display_name' | 'bio',
  ) => {
    if (element.dataset.editing === 'true') return;
    element.dataset.editing = 'true';
    const originalBounds = element.getBoundingClientRect();
    element.style.height = `${originalBounds.height}px`;
    const original = String(currentProfile[field] || '');
    const maximum = field === 'bio' ? BIO_MAX_LENGTH : NAME_MAX_LENGTH;
    const editorShell = document.createElement('span');
    editorShell.className = 'inline-editor-shell';
    const control = document.createElement('input');
    control.type = 'text';
    control.className = 'inline-editor';
    control.value = original;
    control.maxLength = maximum;
    const counter = document.createElement('small');
    counter.className = 'inline-editor-count';
    counter.textContent = formatCount(control.value, maximum);
    editorShell.append(control, counter);
    element.replaceChildren(editorShell);
    control.focus();
    control.select();

    let finished = false;
    const finish = async (save: boolean) => {
      if (finished) return;
      finished = true;
      const value = control.value.trim();
      if (save && (field !== 'display_name' || value)) {
        await updateProfile({ [field]: value });
      } else {
        applyProfile(currentProfile);
      }
      delete element.dataset.editing;
      element.style.removeProperty('height');
    };
    control.addEventListener('blur', () => void finish(true));
    control.addEventListener('beforeinput', (event) => {
      if (!event.inputType.startsWith('insert')) return;
      const selectionLength =
        (control.selectionEnd ?? 0) - (control.selectionStart ?? 0);
      const incomingLength = countCharacters(event.data ?? '');
      if (
        countCharacters(control.value) - selectionLength + incomingLength >
        maximum
      ) {
        setNote(`${field === 'bio' ? '个性签名' : '昵称'}最多 ${maximum} 个字符。`, true);
      }
    });
    control.addEventListener('paste', (event) => {
      const pastedLength = countCharacters(
        event.clipboardData?.getData('text') ?? '',
      );
      const selectionLength =
        (control.selectionEnd ?? 0) - (control.selectionStart ?? 0);
      if (
        countCharacters(control.value) - selectionLength + pastedLength >
        maximum
      ) {
        setNote(`粘贴内容已限制为 ${maximum} 个字符。`, true);
      }
    });
    control.addEventListener('input', () => {
      const characters = Array.from(control.value);
      if (characters.length > maximum) {
        control.value = characters.slice(0, maximum).join('');
      }
      counter.textContent = formatCount(control.value, maximum);
      if (characters.length >= maximum) {
        setNote(`${field === 'bio' ? '个性签名' : '昵称'}最多 ${maximum} 个字符。`, true);
      } else if (note?.dataset.error === 'true') {
        setNote('');
      }
    });
    control.addEventListener('keydown', (event) => {
      const keyboardEvent = event as KeyboardEvent;
      if (keyboardEvent.key === 'Escape') void finish(false);
      if (keyboardEvent.key === 'Enter') {
        event.preventDefault();
        void finish(true);
      }
    });
  };

  nameElement?.addEventListener('click', () =>
    beginInlineEdit(nameElement, 'display_name'),
  );
  bioElement?.addEventListener('click', () =>
    beginInlineEdit(bioElement, 'bio'),
  );
  nameElement?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') beginInlineEdit(nameElement, 'display_name');
  });
  bioElement?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') beginInlineEdit(bioElement, 'bio');
  });

  const uploadImage = async (file: File, kind: 'avatar' | 'background') => {
    if (file.size > 5 * 1024 * 1024) {
      throw new Error('图片不能超过 5 MB。');
    }
    const extension = file.name.split('.').pop()?.toLowerCase() || 'webp';
    const path = `${userId}/${kind}.${extension}`;
    const { error } = await supabase!.storage
      .from('profile-images')
      .upload(path, file, { upsert: true });
    if (error) throw error;
    return (
      supabase!.storage.from('profile-images').getPublicUrl(path).data
        .publicUrl + `?v=${Date.now()}`
    );
  };

  const saveImage = async (file: File, kind: 'avatar' | 'background') => {
    try {
      const url = await uploadImage(file, kind);
      await updateProfile({ [`${kind}_url`]: url });
    } catch (error) {
      setNote(error instanceof Error ? error.message : '上传失败。', true);
    }
  };

  const setupImageTarget = (target: HTMLElement) => {
    let hoverTimer: number | undefined;
    const kind = target.dataset.imageTarget as 'avatar' | 'background';
    const input = kind === 'avatar' ? avatarInput : backgroundInput;
    target.addEventListener('pointerenter', () => {
      hoverTimer = window.setTimeout(
        () => target.classList.add('is-edit-ready'),
        500,
      );
    });
    target.addEventListener('pointerleave', () => {
      window.clearTimeout(hoverTimer);
      target.classList.remove('is-edit-ready');
    });
    target.addEventListener('focus', () =>
      target.classList.add('is-edit-ready'),
    );
    target.addEventListener('blur', () =>
      target.classList.remove('is-edit-ready'),
    );
    target.addEventListener('click', () => {
      if (target.classList.contains('is-edit-ready')) input?.click();
    });
    target.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') input?.click();
    });
  };

  document
    .querySelectorAll<HTMLElement>('[data-image-target]')
    .forEach(setupImageTarget);
  avatarInput?.addEventListener('change', () => {
    const file = avatarInput.files?.[0];
    if (file) void saveImage(file, 'avatar');
    avatarInput.value = '';
  });
  backgroundInput?.addEventListener('change', () => {
    const file = backgroundInput.files?.[0];
    if (file) void saveImage(file, 'background');
    backgroundInput.value = '';
  });
</script>

<style>
  .profile-page {
    width: min(60rem, calc(100% - 4rem));
    margin-right: auto;
    margin-left: clamp(2rem, 6vw, 5rem);
    padding-bottom: clamp(2rem, 6vw, 5rem);
  }
  .identity-card {
    border-bottom: 1px solid var(--color-border);
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 620ms ease,
      transform 620ms ease,
      filter 620ms ease;
  }
  .profile-section {
    transition:
      opacity 620ms ease 100ms,
      transform 620ms ease 100ms,
      filter 620ms ease 100ms;
  }
  .profile-page[data-loading='true'] .identity-card,
  .profile-page[data-loading='true'] .profile-section {
    opacity: 0;
    transform: translateY(0.55rem);
    filter: blur(5px);
  }
  .cover {
    position: relative;
    width: 100%;
    aspect-ratio: 20 / 9;
    background:
      radial-gradient(
        circle at 28% 35%,
        color-mix(in srgb, var(--color-accent) 14%, transparent),
        transparent 48%
      ),
      linear-gradient(
        125deg,
        var(--color-surface),
        color-mix(in srgb, var(--color-surface) 75%, var(--color-page))
      );
    background-position: center;
    background-size: cover;
    overflow: hidden;
  }
  .identity-content {
    padding: 0 1.75rem 2rem;
  }
  .profile-actions {
    display: flex;
    min-height: 4rem;
    align-items: flex-start;
    justify-content: space-between;
  }
  .avatar {
    position: relative;
    display: grid;
    width: 5.75rem;
    height: 5.75rem;
    margin-top: -2.85rem;
    place-items: center;
    border: 0.25rem solid var(--color-page);
    border-radius: 50%;
    background: var(--color-text);
    color: var(--color-page);
    font-size: 1.55rem;
    font-weight: 800;
    background-position: center;
    background-size: cover;
    overflow: hidden;
  }
  .avatar-placeholder {
    width: 2.75rem;
    height: 2.75rem;
    fill: currentColor;
  }
  .avatar.has-image .avatar-placeholder {
    display: none;
  }
  .image-edit-target {
    cursor: default;
  }
  .image-edit-target > span {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, #000 56%, transparent);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    opacity: 0;
    transition: opacity 180ms ease;
  }
  .image-edit-target.is-edit-ready {
    cursor: pointer;
  }
  .image-edit-target.is-edit-ready > span {
    opacity: 1;
  }
  .identity-copy {
    max-width: 42rem;
  }
  .role,
  .profile-section header p {
    margin: 0 0 0.35rem;
    color: var(--color-accent);
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.1em;
  }
  h1 {
    margin: 0;
    font-size: clamp(1.3rem, 2.5vw, 1.75rem);
  }
  [data-display-name],
  [data-bio] {
    max-width: 100%;
    box-sizing: border-box;
    border-radius: 0.35rem;
    cursor: text;
  }
  [data-display-name] {
    width: fit-content;
  }
  [data-display-name][data-editing='true'],
  [data-bio][data-editing='true'] {
    width: 100%;
  }
  [data-display-name]:hover,
  [data-bio]:hover {
    background: color-mix(in srgb, var(--color-text) 5%, transparent);
  }
  :global(.inline-editor-shell) {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
  }
  :global(.inline-editor) {
    display: block;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    padding: 0 3.25rem 0 0.5rem;
    border: 1px solid var(--color-accent);
    border-radius: 0.4rem;
    background: var(--color-page);
    color: var(--color-text);
    font: inherit;
    line-height: inherit;
  }
  :global(.inline-editor-count) {
    position: absolute;
    top: 50%;
    right: 0.55rem;
    color: var(--color-text-muted);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    pointer-events: none;
    transform: translateY(-50%);
  }
  .signature {
    position: relative;
    display: block;
    width: min(42rem, 100%);
    margin: 0.65rem 0 0;
    color: var(--color-text-muted);
    line-height: 1.65;
    white-space: nowrap;
  }
  .signature [data-bio] {
    display: block;
    width: 100%;
    min-width: 0;
    min-height: 1.65em;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  button {
    padding: 0.7rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.55rem;
    background: var(--color-page);
    cursor: pointer;
  }
  .profile-section {
    margin-top: 3.25rem;
    padding-inline: 1.75rem;
  }
  h2 {
    margin: 0;
    font-size: 1.35rem;
  }
  .empty-state {
    display: grid;
    gap: 0.45rem;
    margin-top: 1.2rem;
    padding: 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.7rem;
  }
  .empty-state span {
    color: var(--color-text-muted);
    font-size: 0.88rem;
  }
  .profile-note {
    min-height: 1.2em;
    margin: 0.65rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }
  .profile-note[data-error='true'] {
    color: #c23b3b;
  }
  @media (min-width: 48.01rem) {
    .profile-page {
      padding-top: 1.4rem;
    }
  }

  @media (max-width: 42rem) {
    .profile-page {
      width: calc(100% - 2rem);
      margin-inline: 1rem;
    }

    .identity-content,
    .profile-section {
      padding-inline: 1rem;
    }
  }
</style>
