---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="个人页 | 人工智能学院科协" description="科协成员个人空间。">
  <main class="profile-page">
    <section class="identity-card">
      <div class="cover"></div>
      <div class="identity-content">
        <div class="profile-actions">
          <div class="avatar" aria-hidden="true">A</div>
          <button type="button">编辑资料</button>
        </div>
        <div class="identity-copy">
          <p class="role">REGISTERED MEMBER</p>
          <h1>未设置昵称</h1>
          <p class="signature">
            用一句话介绍自己，或者留下你最近正在探索的事情。
          </p>
        </div>
      </div>
    </section>

    <section class="profile-section">
      <header><p>PUBLICATIONS</p><h2>我发布的文章</h2></header>
      <div class="empty-state">
        <strong>还没有文章</strong><span
          >获得协作者权限并发布文章后，它们会出现在这里。</span
        >
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .profile-page {
    width: min(62rem, calc(100% - 4rem));
    margin-inline: auto;
    padding-bottom: clamp(2rem, 6vw, 5rem);
  }
  .identity-card {
    border-bottom: 1px solid var(--color-border);
  }
  .cover {
    height: clamp(9rem, 19vw, 12.5rem);
    background:
      radial-gradient(
        circle at 28% 35%,
        color-mix(in srgb, var(--color-accent) 14%, transparent),
        transparent 48%
      ),
      linear-gradient(
        125deg,
        var(--color-surface),
        color-mix(in srgb, var(--color-surface) 75%, var(--color-page))
      );
  }
  .identity-content {
    padding: 0 1.75rem 2rem;
  }
  .profile-actions {
    display: flex;
    min-height: 4rem;
    align-items: flex-start;
    justify-content: space-between;
  }
  .avatar {
    display: grid;
    width: 5.75rem;
    height: 5.75rem;
    margin-top: -2.85rem;
    place-items: center;
    border: 0.25rem solid var(--color-page);
    border-radius: 50%;
    background: var(--color-text);
    color: var(--color-page);
    font-size: 1.55rem;
    font-weight: 800;
  }
  .profile-actions button {
    margin-top: 0.7rem;
  }
  .identity-copy {
    max-width: 42rem;
  }
  .role,
  .profile-section header p {
    margin: 0 0 0.35rem;
    color: var(--color-accent);
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.1em;
  }
  h1 {
    margin: 0;
    font-size: clamp(1.45rem, 3vw, 2rem);
  }
  .signature {
    margin: 0.65rem 0 0;
    color: var(--color-text-muted);
    line-height: 1.65;
  }
  button {
    padding: 0.7rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.55rem;
    background: var(--color-page);
    cursor: pointer;
  }
  .profile-section {
    margin-top: 3.25rem;
    padding-inline: 1.75rem;
  }
  h2 {
    margin: 0;
    font-size: 1.35rem;
  }
  .empty-state {
    display: grid;
    gap: 0.45rem;
    margin-top: 1.2rem;
    padding: 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.7rem;
  }
  .empty-state span {
    color: var(--color-text-muted);
    font-size: 0.88rem;
  }
  @media (min-width: 48.01rem) {
    .profile-page {
      padding-top: 1.4rem;
    }
  }

  @media (max-width: 42rem) {
    .profile-page {
      width: 100%;
    }

    .identity-content,
    .profile-section {
      padding-inline: 1rem;
    }
  }
</style>
