---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/paths';

const articles = (
  await getCollection(
    'docs',
    ({ data }) => data.kind === 'document' && !data.draft,
  )
).sort((a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime());
const categories = [
  '技术分享',
  '工具使用',
  '竞赛经验',
  '项目记录',
  '公告',
  '未分类',
];
const slugFor = (id: string) =>
  id
    .split('/')
    .at(-1)
    ?.replace(/\.mdx?$/, '') ?? id;
---

<BaseLayout title="文档 | 人工智能学院科协" description="科协文档与学习资料。">
  <main
    class="articles-page"
    data-articles-page
    data-read-url={withBase('/articles/read/')}
    data-default-avatar={withBase('/images/brand/asaw-logo.png')}
  >
    <section class="article-list" aria-live="polite">
      {
        articles.map((article, index) => (
          <a
            class="article-card"
            href={withBase(`/articles/${slugFor(article.id)}/`)}
            data-article-card
            data-category={article.data.category}
            style={`--post-index: ${index}`}
          >
            <>
              <span>{article.data.category}</span>
              <h2>{article.data.title}</h2>
            </>
            <p>{article.data.description}</p>
            <div class="article-dates">
              <span
                class="contributor"
                data-historical-contributor
                data-loading="true"
              >
                <>
                  <img src={withBase('/images/brand/asaw-logo.png')} alt="" />
                  <b>科协成员</b>
                </>
              </span>
              <time
                datetime={(
                  article.data.publishedAt ?? article.data.updatedAt
                ).toISOString()}
              >
                发布时间：
                {(
                  article.data.publishedAt ?? article.data.updatedAt
                ).toLocaleDateString('zh-CN')}
              </time>
              {article.data.publishedAt &&
                article.data.updatedAt.getTime() >
                  article.data.publishedAt.getTime() && (
                  <time datetime={article.data.updatedAt.toISOString()}>
                    更新时间：
                    {article.data.updatedAt.toLocaleDateString('zh-CN')}
                  </time>
                )}
            </div>
          </a>
        ))
      }
    </section>
    <p class="empty-filter" data-empty-filter hidden>该栏目暂时没有文档。</p>
    <aside class="article-tools" aria-label="文档功能">
      <details class="tool-item category-filter" data-category-filter>
        <summary>
          <svg class="grid-icon" aria-hidden="true" viewBox="0 0 24 24"
            >{
              Array.from({ length: 9 }, (_, index) => (
                <rect
                  x={3 + (index % 3) * 7}
                  y={3 + Math.floor(index / 3) * 7}
                  width="4"
                  height="4"
                  rx="0.7"
                />
              ))
            }</svg
          >
          <span><strong>全部分类</strong></span>
        </summary>
        <div class="category-menu">
          <button type="button" data-category="all" aria-pressed="true"
            >全部文档</button
          >
          {
            categories.map((category) => (
              <button
                type="button"
                data-category={category}
                aria-pressed="false"
              >
                {category}
              </button>
            ))
          }
        </div>
      </details>
    </aside>
  </main>
</BaseLayout>

<script>
  import { supabase } from '../../lib/supabase';
  const emptyFilter = document.querySelector<HTMLElement>(
    '[data-empty-filter]',
  );
  const filterByCategory = (button: HTMLButtonElement) => {
    const selectedCategory = button.dataset.category ?? 'all';
    let visible = 0;
    document
      .querySelectorAll<HTMLElement>('[data-article-card]')
      .forEach((card) => {
        const show =
          selectedCategory === 'all' ||
          card.dataset.category === selectedCategory;
        card.hidden = !show;
        if (show) {
          visible += 1;
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches)
            card.animate(
              [
                { opacity: 0, transform: 'translateY(0.35rem)' },
                { opacity: 1, transform: 'translateY(0)' },
              ],
              { duration: 480, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
            );
        }
      });
    document
      .querySelectorAll<HTMLButtonElement>('[data-category]')
      .forEach((candidate) =>
        candidate.setAttribute('aria-pressed', String(candidate === button)),
      );
    if (emptyFilter) emptyFilter.hidden = visible > 0;
    const filter = document.querySelector<HTMLDetailsElement>(
      '[data-category-filter]',
    );
    if (filter) filter.open = false;
  };
  document
    .querySelectorAll<HTMLButtonElement>('[data-category]')
    .forEach((button) =>
      button.addEventListener('click', () => filterByCategory(button)),
    );
  const revealHistoricalContributors = (contributor?: {
    avatar_url?: string | null;
    display_name?: string | null;
  }) => {
    document
      .querySelectorAll<HTMLElement>('[data-historical-contributor]')
      .forEach((element) => {
        const image = element.querySelector<HTMLImageElement>('img');
        const name = element.querySelector<HTMLElement>('b');
        if (image && contributor?.avatar_url)
          image.src = String(contributor.avatar_url);
        if (name)
          name.textContent = String(contributor?.display_name || '科协成员');
        requestAnimationFrame(() => (element.dataset.loading = 'false'));
      });
  };
  if (supabase) {
    const historical = await supabase.rpc('get_site_contributor');
    const siteContributor = historical.data?.[0];
    revealHistoricalContributors(
      !historical.error ? siteContributor : undefined,
    );
    const feed = await supabase.rpc('get_published_article_feed');
    const fallback = feed.error
      ? await supabase
          .from('articles')
          .select('id,title,summary,category,published_at,updated_at,author_id')
          .eq('status', 'published')
          .order('published_at', { ascending: false })
      : null;
    const published = feed.error ? fallback?.data : feed.data;
    const list = document.querySelector<HTMLElement>('.article-list');
    const page = document.querySelector<HTMLElement>('[data-articles-page]');
    for (const article of published ?? []) {
      const link = document.createElement('a');
      link.className = 'article-card';
      link.dataset.articleCard = '';
      link.dataset.category = article.category;
      link.href = `${page?.dataset.readUrl ?? ''}?id=${encodeURIComponent(article.id)}`;
      const category = document.createElement('span');
      category.textContent = article.category;
      const title = document.createElement('h2');
      title.textContent = article.title;
      const summary = document.createElement('p');
      summary.textContent = article.summary;
      const dates = document.createElement('div');
      dates.className = 'article-dates';
      const contributor = document.createElement('span');
      contributor.className = 'contributor';
      const avatar = document.createElement('img');
      avatar.src = String(
        article.author_avatar_url || page?.dataset.defaultAvatar || '',
      );
      avatar.alt = '';
      contributor.append(
        avatar,
        document.createTextNode(String(article.author_name || '科协成员')),
      );
      const publishedTime = document.createElement('time');
      const publishedDate = article.published_at
        ? new Date(article.published_at)
        : new Date();
      publishedTime.dateTime = publishedDate.toISOString();
      publishedTime.textContent = `发布时间：${publishedDate.toLocaleDateString('zh-CN')}`;
      dates.append(contributor, publishedTime);
      if (
        article.updated_at &&
        new Date(article.updated_at).getTime() > publishedDate.getTime() + 1000
      ) {
        const updatedTime = document.createElement('time');
        const updatedDate = new Date(article.updated_at);
        updatedTime.dateTime = updatedDate.toISOString();
        updatedTime.textContent = `更新时间：${updatedDate.toLocaleDateString('zh-CN')}`;
        dates.append(updatedTime);
      }
      link.append(category, title, summary, dates);
      list?.prepend(link);
      if (
        !document.querySelector(
          `.category-menu [data-category="${CSS.escape(article.category)}"]`,
        )
      ) {
        const button = document.createElement('button');
        button.type = 'button';
        button.dataset.category = article.category;
        button.ariaPressed = 'false';
        button.textContent = article.category;
        button.addEventListener('click', () => filterByCategory(button));
        document.querySelector('.category-menu')?.append(button);
      }
    }
  } else revealHistoricalContributors();
</script>

<style>
  .articles-page {
    display: grid;
    grid-template-columns: minmax(0, 39rem) 14rem;
    align-items: start;
    gap: clamp(2rem, 4vw, 3.5rem);
    width: min(59rem, calc(100% - 4rem));
    margin-left: clamp(2rem, 5vw, 4.5rem);
    padding-block: 1rem 4rem;
  }
  .article-tools {
    position: sticky;
    top: 1rem;
    display: grid;
    gap: 0.3rem;
    padding: 0.55rem;
    color: var(--color-text);
  }
  .tool-item {
    border: 0;
    border-radius: 0.55rem;
    background: transparent;
  }
  .tool-item > summary,
  .draft-link {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.85rem;
    cursor: pointer;
    list-style: none;
  }
  .tool-item > summary::-webkit-details-marker {
    display: none;
  }
  .tool-item svg {
    width: 1.45rem;
    height: 1.45rem;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }
  .tool-item span {
    display: grid;
    gap: 0.15rem;
  }
  .tool-item strong,
  .workspace-list > p {
    font-size: 0.78rem;
  }
  .tool-item .grid-icon {
    fill: currentColor;
    stroke: none;
  }
  .category-menu {
    display: grid;
    gap: 0.2rem;
    padding: 0.2rem 0.55rem 0.55rem;
  }
  .category-menu button {
    padding: 0.58rem 0.65rem;
    border: 0;
    border-radius: 0.55rem;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    font: inherit;
    font-size: 0.78rem;
    text-align: left;
    transition:
      background 160ms ease,
      color 160ms ease,
      padding-left 160ms ease;
  }
  .category-menu button:hover,
  .category-menu button[aria-pressed='true'] {
    padding-left: 0.85rem;
    background: color-mix(in srgb, var(--color-accent) 9%, transparent);
    color: var(--color-accent);
  }
  .tool-item > summary:hover {
    background: var(--color-surface);
  }
  .article-list {
    display: grid;
    gap: 0.7rem;
    padding-top: 1rem;
  }
  :global(.article-card) {
    position: relative;
    display: grid;
    min-height: 8.2rem;
    grid-template-columns: minmax(0, 1fr) auto;
    align-content: center;
    gap: 0.42rem 1.25rem;
    padding: 1.15rem 2.5rem 1.15rem 1.15rem;
    border: 1px solid
      color-mix(in srgb, var(--color-accent) 30%, var(--color-border));
    border-right: 3px solid
      color-mix(in srgb, var(--color-accent) 72%, transparent);
    border-radius: 1.05rem;
    background: linear-gradient(
      to left,
      color-mix(in srgb, var(--color-accent) 13%, var(--color-page)),
      color-mix(in srgb, var(--color-surface) 60%, var(--color-page)) 48%
    );
    box-shadow: 0.5rem 0.28rem 1.05rem color-mix(in srgb, #000 9%, transparent);
    color: var(--color-text);
    text-decoration: none;
    animation: post-in 680ms both cubic-bezier(0.22, 1, 0.36, 1);
    animation-delay: calc(var(--post-index) * 55ms);
    transition:
      background 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }
  :global(.article-card::after) {
    position: absolute;
    top: 50%;
    right: 0.9rem;
    color: var(--color-text-muted);
    content: '→';
    opacity: 0;
    transform: translate(-0.35rem, -50%);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }
  :global(.article-card > span) {
    grid-column: 1 / -1;
    width: fit-content;
    padding: 0.18rem 0.48rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent) 15%, transparent);
    color: var(--color-accent);
    font-size: 0.66rem;
    font-weight: 720;
    letter-spacing: 0.06em;
  }
  :global(.article-card h2) {
    margin: 0;
    font-size: clamp(1rem, 1.6vw, 1.22rem);
    font-weight: 660;
    transition: color 180ms ease;
  }
  :global(.article-card p) {
    display: -webkit-box;
    grid-column: 1;
    max-width: 31rem;
    margin: 0;
    overflow: hidden;
    color: color-mix(in srgb, var(--color-text) 72%, transparent);
    font-size: 0.9rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    white-space: normal;
  }
  :global(.article-dates) {
    grid-column: 1;
    display: flex;
    min-height: 1.25rem;
    align-items: center;
    gap: 0.35rem 1rem;
    color: var(--color-text-muted);
    font-size: 0.68rem;
    line-height: 1;
    white-space: nowrap;
  }
  :global(.contributor) {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    opacity: 0;
    transform: translateY(0.18rem);
    transition:
      opacity 380ms ease,
      transform 440ms cubic-bezier(0.2, 0.82, 0.22, 1);
  }
  :global(.contributor:not([data-loading])),
  :global(.contributor[data-loading='false']) {
    opacity: 1;
    transform: none;
  }
  :global(.contributor b) {
    font: inherit;
    font-weight: 500;
    transition: opacity 320ms ease;
  }
  :global(.contributor img) {
    width: 1.15rem;
    height: 1.15rem;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    object-fit: cover;
    transition:
      opacity 320ms ease,
      transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global(.article-card:hover) {
    border-color: color-mix(
      in srgb,
      var(--color-accent) 68%,
      var(--color-border)
    );
    box-shadow: 0.65rem 0.4rem 1.3rem color-mix(in srgb, #000 13%, transparent);
    transform: translateX(0.25rem);
  }
  :global(.article-card:hover h2) {
    color: var(--color-accent);
  }
  :global(.article-card:hover::after) {
    opacity: 1;
    transform: translate(0, -50%);
  }
  @keyframes post-in {
    from {
      opacity: 0;
      transform: translateY(0.28rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .empty-filter {
    color: var(--color-text-muted);
  }
  [hidden] {
    display: none !important;
  }
  @media (max-width: 60rem) {
    .articles-page {
      grid-template-columns: 1fr;
      width: calc(100% - 2rem);
      margin-inline: 1rem;
    }
    .article-tools {
      position: static;
      grid-row: 1;
    }
  }
  @media (max-width: 42rem) {
    :global(.article-card) {
      grid-template-columns: 1fr;
      margin-inline: 0;
      padding-inline: 0.65rem 2.4rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.article-card) {
      animation: none;
    }
    :global(.article-card),
    :global(.article-card::after),
    .category-filter svg,
    .category-filter > summary {
      transition: none;
    }
  }
</style>
