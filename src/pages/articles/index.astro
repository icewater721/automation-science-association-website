---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/paths';

const articles = (await getCollection('docs', ({ data }) =>
  data.kind === 'document' && !data.draft,
)).sort((a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime());
const categories = [...new Set(articles.map((article) => article.data.category))];
const slugFor = (id: string) => id.split('/').at(-1)?.replace(/\.mdx?$/, '') ?? id;
---

<BaseLayout title="文档 | 人工智能学院科协" description="科协文档与学习资料。">
  <main class="articles-page" data-articles-page data-read-url={withBase('/articles/read/')}>
    <section class="article-list" aria-live="polite">
      {articles.map((article, index) => (
        <a class="article-card" href={withBase(`/articles/${slugFor(article.id)}/`)} data-article-card data-category={article.data.category} style={`--post-index: ${index}`}>
          <span>{article.data.category}</span><h2>{article.data.title}</h2>
          <p>{article.data.description}</p>
          <div class="article-dates">
            <time datetime={(article.data.publishedAt ?? article.data.updatedAt).toISOString()}>发布时间：{(article.data.publishedAt ?? article.data.updatedAt).toLocaleDateString('zh-CN')}</time>
            {article.data.publishedAt && article.data.updatedAt.getTime() > article.data.publishedAt.getTime() && <time datetime={article.data.updatedAt.toISOString()}>更新时间：{article.data.updatedAt.toLocaleDateString('zh-CN')}</time>}
          </div>
        </a>
      ))}
    </section>
    <p class="empty-filter" data-empty-filter hidden>该栏目暂时没有文档。</p>
    <aside class="article-tools" aria-label="文档功能">
      <p class="tools-title">功能</p>
      <div class="category-menu">
        <p>栏目筛选</p>
        <button type="button" data-category="all" aria-pressed="true">全部文档</button>
        {categories.map((category) => <button type="button" data-category={category} aria-pressed="false">{category}</button>)}
      </div>
      <a class="draft-link" href={withBase('/articles/drafts/')} data-draft-link hidden>编辑文档 <span>→</span></a>
    </aside>
  </main>
</BaseLayout>

<script>
  import { supabase } from '../../lib/supabase';
  const emptyFilter = document.querySelector<HTMLElement>('[data-empty-filter]');
  const filterByCategory = (button: HTMLButtonElement) => {
      const selectedCategory = button.dataset.category ?? 'all';
      let visible = 0;
      document.querySelectorAll<HTMLElement>('[data-article-card]').forEach((card) => {
        const show = selectedCategory === 'all' || card.dataset.category === selectedCategory;
        card.hidden = !show;
        if (show) {
          visible += 1;
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches)
            card.animate(
              [
                { opacity: 0, transform: 'translateY(0.35rem)' },
                { opacity: 1, transform: 'translateY(0)' },
              ],
              { duration: 260, easing: 'ease-out' },
            );
        }
      });
      document.querySelectorAll<HTMLButtonElement>('[data-category]').forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
      if (emptyFilter) emptyFilter.hidden = visible > 0;
      const filter = document.querySelector<HTMLDetailsElement>('[data-category-filter]');
      if (filter) filter.open = false;
  };
  document.querySelectorAll<HTMLButtonElement>('[data-category]').forEach((button) =>
    button.addEventListener('click', () => filterByCategory(button)),
  );
  if (supabase) {
    const { data: published } = await supabase.from('articles').select('id,title,summary,category,published_at,updated_at').eq('status', 'published').order('published_at', { ascending: false });
    const list = document.querySelector<HTMLElement>('.article-list');
    const page = document.querySelector<HTMLElement>('[data-articles-page]');
    for (const article of published ?? []) {
      const link = document.createElement('a');
      link.className = 'article-card';
      link.dataset.articleCard = '';
      link.dataset.category = article.category;
      link.href = `${page?.dataset.readUrl ?? ''}?id=${encodeURIComponent(article.id)}`;
      const category = document.createElement('span');
      category.textContent = article.category;
      const title = document.createElement('h2');
      title.textContent = article.title;
      const summary = document.createElement('p');
      summary.textContent = article.summary;
      const dates = document.createElement('div');
      dates.className = 'article-dates';
      const publishedTime = document.createElement('time');
      const publishedDate = article.published_at ? new Date(article.published_at) : new Date();
      publishedTime.dateTime = publishedDate.toISOString();
      publishedTime.textContent = `发布时间：${publishedDate.toLocaleDateString('zh-CN')}`;
      dates.append(publishedTime);
      if (article.updated_at && new Date(article.updated_at).getTime() > publishedDate.getTime() + 1000) {
        const updatedTime = document.createElement('time');
        const updatedDate = new Date(article.updated_at);
        updatedTime.dateTime = updatedDate.toISOString();
        updatedTime.textContent = `更新时间：${updatedDate.toLocaleDateString('zh-CN')}`;
        dates.append(updatedTime);
      }
      link.append(category, title, summary, dates);
      list?.prepend(link);
      if (!document.querySelector(`[data-category="${CSS.escape(article.category)}"]`)) {
        const button = document.createElement('button');
        button.type = 'button';
        button.dataset.category = article.category;
        button.ariaPressed = 'false';
        button.textContent = article.category;
        button.addEventListener('click', () => filterByCategory(button));
        document.querySelector('.category-menu')?.append(button);
      }
    }
  }
  const session = (await supabase?.auth.getSession())?.data.session;
  if (session && supabase) {
    const current = await supabase.from('profiles').select('role').eq('user_id', session.user.id).single();
    let role = String(current.data?.role ?? '');
    if (current.error?.code === '42703') {
      const legacy = await supabase.from('profiles').select('is_collaborator').eq('user_id', session.user.id).single();
      role = legacy.data?.is_collaborator ? 'editor' : '';
    }
    if (role === 'editor' || role === 'admin') {
      const draftLink = document.querySelector<HTMLElement>('[data-draft-link]');
      if (draftLink) draftLink.hidden = false;
    }
  }
</script>

<style>
  .articles-page { display: grid; grid-template-columns: minmax(0, 52rem) 14rem; align-items: start; gap: clamp(2rem, 5vw, 4.5rem); width: min(72rem, calc(100% - 4rem)); margin-left: clamp(2rem, 5vw, 4.5rem); padding-block: 1rem 4rem; }
  .article-tools { position: sticky; top: 1rem; display: grid; gap: 0.8rem; padding: 1rem; border: 1px solid var(--color-border); border-radius: 0.75rem; background: color-mix(in srgb, var(--color-surface) 74%, transparent); }
  .tools-title, .category-menu > p { margin: 0; font-size: 0.72rem; font-weight: 760; letter-spacing: 0.07em; }
  .tools-title { color: var(--color-accent); }
  .category-menu { display: grid; gap: 0.2rem; padding-top: 0.75rem; border-top: 1px solid var(--color-border); }
  .category-menu button { padding: 0.65rem; border: 0; border-radius: 0.35rem; background: transparent; cursor: pointer; font: inherit; text-align: left; transition: background 160ms ease, color 160ms ease, padding-left 160ms ease; }
  .category-menu button:hover, .category-menu button[aria-pressed='true'] { padding-left: 0.85rem; background: var(--color-surface); color: var(--color-accent); }
  .draft-link { display: flex; justify-content: space-between; padding: 0.65rem; border-top: 1px solid var(--color-border); color: var(--color-text); font-size: 0.78rem; font-weight: 680; text-decoration: none; transition: color 180ms ease, transform 180ms ease; }
  .draft-link:hover { background: var(--color-surface); color: var(--color-text); transform: translateY(-0.1rem); }
  .article-list { display: grid; gap: 0.12rem; }
  .article-card { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.28rem 1.25rem; margin-inline: -0.65rem; padding: 0.78rem 2.5rem 0.78rem 0.65rem; border-radius: 0.55rem; color: var(--color-text); text-decoration: none; animation: post-in 420ms both; animation-delay: calc(var(--post-index) * 45ms); transition: background 180ms ease, transform 180ms ease; }
  .article-card::after { position: absolute; top: 50%; right: 0.9rem; color: var(--color-text-muted); content: '→'; opacity: 0; transform: translate(-0.35rem, -50%); transition: opacity 180ms ease, transform 180ms ease; }
  .article-card > span { grid-column: 1 / -1; width: fit-content; padding: 0.18rem 0.48rem; border-radius: 999px; background: color-mix(in srgb, var(--color-accent) 9%, transparent); color: var(--color-accent); font-size: 0.66rem; font-weight: 720; letter-spacing: 0.06em; }
  .article-card h2 { margin: 0; font-size: clamp(1rem, 1.6vw, 1.22rem); font-weight: 660; transition: color 180ms ease; }
  .article-card p { grid-column: 1; margin: 0; overflow: hidden; color: var(--color-text-muted); font-size: 0.82rem; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
  .article-dates { grid-column: 1; display: flex; flex-wrap: wrap; gap: 0.35rem 1rem; color: var(--color-text-muted); font-size: 0.68rem; }
  .article-card:hover { background: color-mix(in srgb, var(--color-text) 3.5%, transparent); transform: translateX(0.25rem); }
  .article-card:hover h2 { color: var(--color-accent); }
  .article-card:hover::after { opacity: 1; transform: translate(0, -50%); }
  @keyframes post-in { from { opacity: 0; transform: translateY(0.55rem); } to { opacity: 1; transform: translateY(0); } }
  .empty-filter { color: var(--color-text-muted); }
  [hidden] { display: none !important; }
  @media (max-width: 60rem) { .articles-page { grid-template-columns: 1fr; width: calc(100% - 2rem); margin-inline: 1rem; } .article-tools { position: static; grid-row: 1; } }
  @media (max-width: 42rem) { .article-card { grid-template-columns: 1fr; margin-inline: 0; padding-inline: 0.65rem 2.4rem; } }
  @media (prefers-reduced-motion: reduce) { .article-card { animation: none; } .article-card, .article-card::after, .category-filter svg, .category-filter > summary { transition: none; } }
</style>
