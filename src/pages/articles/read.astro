---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/paths';
---

<BaseLayout title="文档 | 人工智能学院科协" description="阅读科协文档。">
  <main
    class="reader"
    data-reader
    data-list-url={withBase('/articles/')}
    data-fallback-avatar={withBase('/images/brand/asaw-logo.png')}
  >
    <article data-document hidden>
      <a class="back-link" href={withBase('/articles/')}>← <span>返回</span></a>
      <header>
        <p data-category-label></p><h1 data-title></h1><div
          class="contributors"
          data-contributors
          aria-label="文章贡献者"
        >
        </div><p data-summary></p>
      </header>
      <div class="content" data-content></div>
    </article>
    <aside class="page-outline" data-outline hidden>
      <div class="outline-heading">
        <p>文档目录</p><button
          type="button"
          data-back-to-top
          title="回到顶部"
          aria-label="回到顶部">↑</button
        >
      </div>
      <nav data-outline-nav></nav>
      <span data-outline-empty hidden>本页暂无小节</span>
    </aside>
    <div class="reader-loader" data-reader-note aria-label="正在载入文档"></div>
  </main>
</BaseLayout>

<script>
  import { supabase } from '../../lib/supabase';
  import { renderMarkdown } from '../../utils/markdown';
  const note = document.querySelector<HTMLElement>('[data-reader-note]');
  const id = new URLSearchParams(window.location.search).get('id');
  if (!id || !supabase) {
    if (note) note.textContent = '文档链接无效。';
  } else {
    const [articleResult, contributorResult] = await Promise.all([
      supabase
        .from('articles')
        .select('title,summary,category,content_markdown')
        .eq('id', id)
        .eq('status', 'published')
        .single(),
      supabase.rpc('get_article_contributors', { target_article_id: id }),
    ]);
    const { data, error } = articleResult;
    if (error || !data) {
      if (note) note.textContent = '文档不存在或尚未发布。';
    } else {
      document
        .querySelectorAll<HTMLElement>('[data-category-label]')
        .forEach((element) => (element.textContent = data.category));
      const title = document.querySelector<HTMLElement>('[data-title]');
      const summary = document.querySelector<HTMLElement>('[data-summary]');
      const content = document.querySelector<HTMLElement>('[data-content]');
      if (title) title.textContent = data.title;
      if (summary) summary.textContent = data.summary;
      const contributorElement = document.querySelector<HTMLElement>(
        '[data-contributors]',
      );
      if (contributorElement && !contributorResult.error) {
        contributorElement.replaceChildren(
          ...(
            (contributorResult.data ?? []) as Array<{
              avatar_url: string | null;
              display_name: string;
            }>
          ).map((contributor) => {
            const person = document.createElement('span');
            person.className = 'contributor-person';
            const image = document.createElement('img');
            image.src =
              String(contributor.avatar_url || '') ||
              (document.querySelector<HTMLElement>('[data-reader]')?.dataset
                .fallbackAvatar ??
                '');
            image.alt = String(contributor.display_name || '科协成员');
            image.title = String(contributor.display_name || '科协成员');
            const name = document.createElement('b');
            name.textContent = String(contributor.display_name || '科协成员');
            person.append(image, name);
            return person;
          }),
        );
      }
      if (content) {
        content.innerHTML = renderMarkdown(data.content_markdown);
        const headings = [...content.querySelectorAll<HTMLElement>('h1,h2,h3')];
        const usedIds = new Map<string, number>();
        for (const heading of headings) {
          const base =
            heading.textContent
              ?.trim()
              .toLowerCase()
              .replace(/[^\p{L}\p{N}]+/gu, '-')
              .replace(/^-|-$/g, '') || 'section';
          const occurrence = usedIds.get(base) ?? 0;
          usedIds.set(base, occurrence + 1);
          heading.id = occurrence ? `${base}-${occurrence + 1}` : base;
        }
        const outline = document.querySelector<HTMLElement>('[data-outline]');
        const outlineNav =
          document.querySelector<HTMLElement>('[data-outline-nav]');
        const outlineEmpty = document.querySelector<HTMLElement>(
          '[data-outline-empty]',
        );
        if (outline && outlineNav) {
          outline.hidden = false;
          if (!headings.length) {
            if (outlineEmpty) outlineEmpty.hidden = false;
          } else {
            outlineNav.replaceChildren(
              ...headings.map((heading) => {
                const link = document.createElement('a');
                link.href = `#${encodeURIComponent(heading.id)}`;
                link.dataset.depth = heading.tagName.slice(1);
                link.textContent = heading.textContent;
                return link;
              }),
            );
            const links = [
              ...outlineNav.querySelectorAll<HTMLAnchorElement>('a'),
            ];
            const updateActive = () => {
              const marker = Math.min(window.innerHeight * 0.3, 180);
              let active = headings[0];
              for (const heading of headings) {
                if (heading.getBoundingClientRect().top <= marker)
                  active = heading;
                else break;
              }
              links.forEach((link) => {
                const selected =
                  decodeURIComponent(link.hash.slice(1)) === active.id;
                link.classList.toggle('is-active', selected);
                if (selected) link.setAttribute('aria-current', 'location');
                else link.removeAttribute('aria-current');
              });
            };
            updateActive();
            window.addEventListener('scroll', updateActive, { passive: true });
          }
        }
      }
      const documentElement =
        document.querySelector<HTMLElement>('[data-document]');
      if (documentElement) {
        documentElement.hidden = false;
        requestAnimationFrame(() => documentElement.classList.add('is-ready'));
      }
      if (note) {
        note.classList.add('is-hidden');
        window.setTimeout(() => (note.hidden = true), 360);
      }
      document.title = `${data.title} | 文档`;
    }
  }
  document
    .querySelector('[data-back-to-top]')
    ?.addEventListener('click', () =>
      window.scrollTo({ top: 0, behavior: 'smooth' }),
    );
</script>

<style>
  .reader {
    display: grid;
    grid-template-columns: minmax(0, 48rem) minmax(9rem, 11rem);
    gap: clamp(1.5rem, 3vw, 3rem);
    width: min(88rem, calc(100% - 4rem));
    margin-inline: auto;
    padding-block: 2rem 5rem;
  }
  article {
    min-width: 0;
    grid-column: 1;
    opacity: 0;
    transform: translateY(0.45rem);
    transition:
      opacity 480ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 560ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  article.is-ready {
    opacity: 1;
    transform: none;
  }
  .back-link {
    display: inline-flex;
    gap: 0.45rem;
    margin-bottom: 1.2rem;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    text-decoration: none;
    transition:
      color 160ms ease,
      transform 160ms ease;
  }
  .back-link:hover {
    color: var(--color-accent);
    transform: translateX(-0.15rem);
  }
  article header {
    padding: 1.4rem 0 2rem;
    border-bottom: 1px solid var(--color-border);
  }
  article header > p:first-child {
    margin: 0 0 0.65rem;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.08em;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.3rem, 5vw, 4rem);
    letter-spacing: -0.045em;
  }
  .contributors {
    display: flex;
    min-height: 2rem;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1rem;
  }
  .contributors :global(.contributor-person) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-text-muted);
    font-size: 0.76rem;
    animation: contributor-in 420ms both cubic-bezier(0.22, 1, 0.36, 1);
  }
  .contributors :global(.contributor-person b) {
    font: inherit;
    font-weight: 520;
  }
  .contributors :global(img) {
    width: 2rem;
    height: 2rem;
    border: 2px solid var(--color-page);
    border-radius: 50%;
    background: var(--color-surface);
    object-fit: cover;
  }
  .reader-loader {
    grid-column: 1;
    min-height: 55vh;
    transition:
      opacity 320ms ease,
      transform 380ms ease;
  }
  .reader-loader.is-hidden {
    opacity: 0;
    transform: translateY(-0.2rem);
  }
  @keyframes contributor-in {
    from {
      opacity: 0;
      transform: translateY(0.2rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  [data-summary] {
    max-width: 48rem;
    color: var(--color-text-muted);
    line-height: 1.75;
  }
  .content {
    padding-top: 1.5rem;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.85;
  }
  .content :global(h1),
  .content :global(h2),
  .content :global(h3) {
    margin: 2.4rem 0 0.8rem;
  }
  .content :global(a) {
    color: var(--color-accent);
  }
  .content :global(code) {
    font-family: inherit;
  }
  .content :global(pre) {
    overflow: auto;
    padding: 1rem;
    border: 1px solid
      color-mix(in srgb, var(--color-text) 24%, var(--color-border));
    border-radius: 0.8rem;
    background: color-mix(in srgb, var(--color-text) 9%, var(--color-page));
    color: var(--color-text);
    font-family: var(--font-code);
  }
  .content :global(pre code) {
    font-family: inherit;
  }
  .content :global(h1),
  .content :global(h2),
  .content :global(h3) {
    scroll-margin-top: 2rem;
  }
  .page-outline {
    position: sticky;
    top: 2rem;
    grid-column: 2;
    align-self: start;
  }
  .outline-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .outline-heading p {
    margin: 0 0 0.9rem;
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.08em;
  }
  .outline-heading button {
    display: grid;
    width: 1.8rem;
    height: 1.8rem;
    place-items: center;
    margin: 0 0 0.9rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    font: inherit;
  }
  .outline-heading button:hover {
    background: var(--color-surface);
    color: var(--color-accent);
  }
  .page-outline nav {
    display: grid;
    gap: 0.2rem;
  }
  .page-outline :global(a) {
    padding: 0.42rem 0 0.42rem 0.7rem;
    border-left: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.82rem;
    line-height: 1.45;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      background 160ms ease,
      color 160ms ease;
  }
  .page-outline :global(a[data-depth='1']) {
    font-weight: 700;
  }
  .page-outline :global(a[data-depth='3']) {
    padding-left: 1.15rem;
  }
  .page-outline :global(a:hover) {
    border-left-color: var(--color-accent);
    color: var(--color-text);
  }
  .page-outline :global(a.is-active) {
    border-left: 3px solid var(--color-accent);
    border-radius: 0 0.5rem 0.5rem 0;
    background: color-mix(in srgb, var(--color-accent) 16%, transparent);
    color: var(--color-accent);
    font-weight: 750;
  }
  .page-outline > span {
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }
  [hidden] {
    display: none !important;
  }
  @media (max-width: 86rem) {
    .reader {
      grid-template-columns: minmax(0, 48rem);
      justify-content: center;
    }
    .page-outline {
      display: none;
    }
  }
  @media (max-width: 46rem) {
    .reader {
      grid-template-columns: 1fr;
      width: calc(100% - 2rem);
    }
  }
</style>
