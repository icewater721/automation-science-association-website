---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/paths';
---

<BaseLayout title="文档 | 人工智能学院科协" description="阅读科协文档。">
  <main class="reader" data-reader data-list-url={withBase('/articles/')}>
    <a class="back-link" href={withBase('/articles/')}>← <span>返回</span></a>
    <article data-document hidden>
      <header><p data-category-label></p><h1 data-title></h1><p data-summary></p></header>
      <div class="content" data-content></div>
    </article>
    <p data-reader-note>正在加载文档……</p>
  </main>
</BaseLayout>

<script>
  import { supabase } from '../../lib/supabase';
  import { renderMarkdown } from '../../utils/markdown';
  const note = document.querySelector<HTMLElement>('[data-reader-note]');
  const id = new URLSearchParams(window.location.search).get('id');
  if (!id || !supabase) {
    if (note) note.textContent = '文档链接无效。';
  } else {
    const { data, error } = await supabase.from('articles').select('title,summary,category,content_markdown').eq('id', id).eq('status', 'published').single();
    if (error || !data) {
      if (note) note.textContent = '文档不存在或尚未发布。';
    } else {
      document.querySelectorAll<HTMLElement>('[data-category-label]').forEach((element) => (element.textContent = data.category));
      const title = document.querySelector<HTMLElement>('[data-title]');
      const summary = document.querySelector<HTMLElement>('[data-summary]');
      const content = document.querySelector<HTMLElement>('[data-content]');
      if (title) title.textContent = data.title;
      if (summary) summary.textContent = data.summary;
      if (content) content.innerHTML = renderMarkdown(data.content_markdown);
      const documentElement = document.querySelector<HTMLElement>('[data-document]');
      if (documentElement) documentElement.hidden = false;
      if (note) note.hidden = true;
      document.title = `${data.title} | 文档`;
    }
  }
</script>

<style>
  .reader { width: min(66rem, calc(100% - 4rem)); margin-inline: auto; padding-block: 2rem 5rem; }
  .back-link { display: inline-flex; gap: 0.45rem; margin-bottom: 1.2rem; color: var(--color-text-muted); font-size: 0.8rem; text-decoration: none; transition: color 160ms ease, transform 160ms ease; }
  .back-link:hover { color: var(--color-accent); transform: translateX(-0.15rem); }
  article header { padding: 1.4rem 0 2rem; border-bottom: 1px solid var(--color-border); }
  article header > p:first-child { margin: 0 0 0.65rem; color: var(--color-accent); font-size: 0.75rem; font-weight: 750; letter-spacing: 0.08em; }
  h1 { margin: 0; font-size: clamp(2.3rem, 5vw, 4rem); letter-spacing: -0.045em; }
  [data-summary] { max-width: 48rem; color: var(--color-text-muted); line-height: 1.75; }
  .content { padding-top: 1.5rem; font-size: 1rem; line-height: 1.85; }
  .content :global(h1), .content :global(h2), .content :global(h3) { margin: 2.4rem 0 0.8rem; }
  .content :global(a) { color: var(--color-accent); }
  .content :global(pre) { overflow: auto; padding: 1rem; background: var(--color-surface); }
  [hidden] { display: none !important; }
  @media (max-width: 46rem) { .reader { width: calc(100% - 2rem); } }
</style>
