---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/paths';
---

<BaseLayout title="我的草稿 | 文档" description="管理我的文档草稿。">
  <main class="manage-page" data-page data-login={withBase('/login/')} data-edit={withBase('/articles/drafts/')}>
    <a class="back" href={withBase('/articles/')}>← 返回</a>
    <header><p>DOCUMENT WORKSPACE</p><h1>我的草稿</h1></header>
    <div class="list" data-list><p class="empty">正在加载……</p></div>
    <p class="toast" data-toast hidden></p>
  </main>
</BaseLayout>

<script>
  import { supabase } from '../../lib/supabase';
  const page = document.querySelector<HTMLElement>('[data-page]');
  const list = document.querySelector<HTMLElement>('[data-list]');
  const toast = document.querySelector<HTMLElement>('[data-toast]');
  const session = (await supabase?.auth.getSession())?.data.session;
  if (!session) window.location.replace(page?.dataset.login ?? '/');
  const showToast = (message: string, error = false) => {
    if (!toast) return;
    toast.textContent = message;
    toast.dataset.error = String(error);
    toast.hidden = false;
    window.setTimeout(() => { toast.hidden = true; }, error ? 4000 : 2200);
  };
  const load = async () => {
    if (!supabase || !session || !list) return;
    const client = supabase;
    const editUrl = page?.dataset.edit ?? '/articles/drafts/';
    const { data, error } = await client.from('articles').select('id,title,category,status,updated_at').eq('author_id', session.user.id).in('status', ['draft', 'review']).order('updated_at', { ascending: false });
    if (error) { list.innerHTML = '<p class="empty">草稿加载失败。</p>'; return; }
    if (!data?.length) { list.innerHTML = '<p class="empty">还没有草稿。</p>'; return; }
    list.replaceChildren(...data.map((draft) => {
      const card = document.createElement('article');
      card.innerHTML = `<div><span>${draft.status === 'review' ? '待审核' : '草稿'}</span><h2></h2><p>${draft.category} · 更新于 ${new Date(draft.updated_at).toLocaleString('zh-CN')}</p></div><div class="actions"><a>继续编辑</a><button type="button">删除</button></div>`;
      card.querySelector('h2')!.textContent = draft.title || '未命名草稿';
      card.querySelector('a')!.setAttribute('href', `${editUrl}?id=${encodeURIComponent(draft.id)}`);
      card.querySelector('button')!.addEventListener('click', async () => {
        if (!window.confirm(`确定删除“${draft.title || '未命名草稿'}”吗？此操作无法撤销。`)) return;
        const result = await client.from('articles').delete().eq('id', draft.id);
        if (result.error) return showToast(result.error.message, true);
        card.remove(); showToast('草稿已删除。');
        if (!list.children.length) list.innerHTML = '<p class="empty">还没有草稿。</p>';
      });
      return card;
    }));
  };
  void load();
</script>

<style>
  .manage-page { width: min(48rem, calc(100% - 3rem)); margin-inline: auto; padding-block: 1.2rem 5rem; }
  .back { color: var(--color-text-muted); font-size: .8rem; text-decoration: none; }
  header p { margin: 1.5rem 0 0; color: var(--color-accent); font-size: .7rem; font-weight: 750; letter-spacing: .1em; }
  h1 { margin: .3rem 0 1.5rem; font-size: clamp(2rem, 5vw, 3rem); }
  .list { display: grid; gap: .7rem; }
  article { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 1.1rem; border: 1px solid var(--color-border); border-radius: 1rem; }
  article span { color: var(--color-accent); font-size: .68rem; font-weight: 700; }
  article h2 { margin: .2rem 0; font-size: 1rem; }
  article p, .empty { margin: 0; color: var(--color-text-muted); font-size: .76rem; }
  .actions { display: flex; flex: none; gap: .4rem; }
  .actions a, .actions button { padding: .5rem .7rem; border: 0; border-radius: .6rem; background: var(--color-surface); color: var(--color-text); cursor: pointer; font: inherit; font-size: .74rem; text-decoration: none; }
  .actions button { color: #d25a5a; }
  .toast { position: fixed; right: 1.4rem; bottom: 1.4rem; padding: .7rem .9rem; border-radius: .75rem; background: var(--color-nav); color: var(--color-nav-text); font-size: .78rem; box-shadow: 0 .8rem 2rem #0003; }
  .toast[data-error='true'] { color: #ef7777; }
  [hidden] { display: none !important; }
  @media (max-width: 38rem) { article { align-items: flex-start; flex-direction: column; } }
</style>
