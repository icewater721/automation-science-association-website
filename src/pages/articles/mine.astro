---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/paths';

const repositoryDocuments = (
  await getCollection(
    'docs',
    ({ data }) => data.kind === 'document' && !data.draft,
  )
).map((entry) => ({
  id: `repository:${entry.id}`,
  title: entry.data.title,
  category: entry.data.category,
  updatedAt: entry.data.updatedAt.toISOString(),
  contributors: entry.data.contributors,
  url: withBase(
    `/articles/${
      entry.id
        .split('/')
        .at(-1)
        ?.replace(/\.mdx?$/, '') ?? entry.id
    }/`,
  ),
}));
---

<BaseLayout title="创作中心 | 文档" description="统一管理草稿和已发布文档。">
  <main
    class="manage-page"
    data-page
    data-login={withBase('/login/')}
    data-articles={withBase('/articles/')}
    data-edit={withBase('/articles/drafts/')}
    data-read={withBase('/articles/read/')}
    data-repository-documents={JSON.stringify(repositoryDocuments)}
  >
    <header class="workspace-header">
      <div><p>DOCUMENT WORKSPACE</p><h1>创作中心</h1></div>
      <a class="new-article" href={withBase('/articles/drafts/')}>+ 新建文章</a>
    </header>
    <nav class="filters" aria-label="内容筛选" data-filters>
      <button type="button" data-filter="draft">草稿</button>

      <button type="button" data-filter="mine">我贡献的</button>
      <button class="is-active" type="button" data-filter="all">全部文章</button
      >
    </nav>
    <div class="list is-loading" data-list aria-busy="true">
      {
        Array.from({ length: 3 }, () => (
          <div class="skeleton" aria-hidden="true">
            <>
              <i />
              <b />
              <span />
            </>
          </div>
        ))
      }
    </div>
    <p class="toast" data-toast hidden></p>
  </main>
</BaseLayout>

<script>
  import { supabase } from '../../lib/supabase';

  interface ManagedArticle {
    id: string;
    author_id: string;
    title: string;
    category: string;
    status: 'draft' | 'published';
    updated_at: string;
    repository?: boolean;
    static_url?: string;
    contributors?: string[];
  }

  interface RepositoryDocument {
    id: string;
    title: string;
    category: string;
    updatedAt: string;
    contributors: string[];
    url: string;
  }

  const page = document.querySelector<HTMLElement>('[data-page]');
  const list = document.querySelector<HTMLElement>('[data-list]');
  const toast = document.querySelector<HTMLElement>('[data-toast]');
  const filters = document.querySelector<HTMLElement>('[data-filters]');
  const repositoryDocuments = JSON.parse(
    page?.dataset.repositoryDocuments ?? '[]',
  ) as RepositoryDocument[];
  let currentUserId = '';
  let contributedArticleIds = new Set<string>();
  let activeFilter = 'all';
  let articles: ManagedArticle[] = repositoryDocuments.map((document) => ({
    id: document.id,
    author_id: 'repository',
    title: document.title,
    category: document.category,
    status: 'published',
    updated_at: document.updatedAt,
    repository: true,
    static_url: document.url,
    contributors: document.contributors,
  }));

  const showToast = (message: string, error = false) => {
    if (!toast) return;
    toast.textContent = message;
    toast.dataset.error = String(error);
    toast.hidden = false;
    window.setTimeout(() => (toast.hidden = true), error ? 4000 : 2200);
  };

  const visibleArticles = () =>
    articles.filter((article) => {
      if (activeFilter === 'draft') return article.status === 'draft';
      if (activeFilter === 'mine')
        return (
          article.author_id === currentUserId ||
          contributedArticleIds.has(article.id)
        );
      return true;
    });

  const render = () => {
    if (!list) return;
    list.classList.remove('is-loading');
    list.ariaBusy = 'false';
    const visible = visibleArticles();
    if (!visible.length) {
      list.innerHTML = '<p class="empty">这个分类下还没有内容。</p>';
      return;
    }
    const editUrl = page?.dataset.edit ?? '/articles/drafts/';
    const readUrl = page?.dataset.read ?? '/articles/read/';
    list.replaceChildren(
      ...visible.map((article) => {
        const card = document.createElement('article');
        const published = article.status === 'published';
        card.dataset.status = article.status;
        card.innerHTML = `<div class="card-content"><div class="card-meta"><span class="status"></span><span class="ownership"></span></div><h2></h2><p></p></div><div class="actions">${published ? '<a class="view">查看</a>' : ''}${article.repository ? '' : `<a class="edit">${published ? '编辑' : '继续编辑'}</a>${published ? '' : '<button class="publish" type="button">发布</button>'}<details><summary aria-label="更多操作">···</summary><button class="delete" type="button">删除</button></details>`}</div>`;
        card.querySelector('h2')!.textContent =
          article.title || (published ? '未命名文档' : '未命名草稿');
        card.querySelector('.card-content > p')!.textContent = article.category;
        card.querySelector<HTMLElement>('.status')!.textContent = published
          ? '已发布'
          : '草稿';
        card.querySelector<HTMLElement>('.ownership')!.textContent =
          article.repository
            ? `仓库文档 · ${(article.contributors ?? []).join('、')}`
            : contributedArticleIds.has(article.id) ||
                article.author_id === currentUserId
              ? '我参与贡献'
              : '站内文章';
        card
          .querySelector<HTMLAnchorElement>('.view')
          ?.setAttribute(
            'href',
            article.static_url ??
              `${readUrl}?id=${encodeURIComponent(article.id)}`,
          );
        card
          .querySelector<HTMLAnchorElement>('.edit')
          ?.setAttribute(
            'href',
            `${editUrl}?id=${encodeURIComponent(article.id)}`,
          );
        card
          .querySelector<HTMLButtonElement>('.publish')
          ?.addEventListener('click', async () => {
            const now = new Date().toISOString();
            const result = await supabase!
              .from('articles')
              .update({
                status: 'published',
                published_at: now,
                updated_at: now,
              })
              .eq('id', article.id);
            if (result.error) return showToast(result.error.message, true);
            article.status = 'published';
            article.updated_at = now;
            showToast('文档已发布。');
            render();
          });
        card
          .querySelector<HTMLButtonElement>('.delete')
          ?.addEventListener('click', async () => {
            const title =
              article.title || (published ? '未命名文档' : '未命名草稿');
            if (!window.confirm(`确定删除“${title}”吗？此操作无法撤销。`))
              return;
            const result = await supabase!
              .from('articles')
              .delete()
              .eq('id', article.id);
            if (result.error) return showToast(result.error.message, true);
            articles = articles.filter((item) => item.id !== article.id);
            showToast(published ? '文档已删除。' : '草稿已删除。');
            render();
          });
        return card;
      }),
    );
  };

  filters?.addEventListener('click', (event) => {
    if (list?.classList.contains('is-loading')) return;
    const button = (event.target as Element).closest<HTMLButtonElement>(
      '[data-filter]',
    );
    if (!button) return;
    activeFilter = button.dataset.filter ?? 'all';
    filters
      .querySelectorAll('button')
      .forEach((item) => item.classList.toggle('is-active', item === button));
    render();
  });

  const initialize = async () => {
    const session = (await supabase?.auth.getSession())?.data.session;
    if (!session) {
      window.location.replace(page?.dataset.login ?? '/');
      return;
    }
    currentUserId = session.user.id;
    const [profileResult, contributorResult] = await Promise.all([
      supabase!
        .from('profiles')
        .select('role,display_name')
        .eq('user_id', currentUserId)
        .single(),
      supabase!.rpc('get_site_contributor'),
    ]);
    if (profileResult.data?.role !== 'admin') {
      window.location.replace(page?.dataset.articles ?? '/articles/');
      return;
    }
    const siteContributor = contributorResult.data?.[0] as
      { user_id?: string; display_name?: string } | undefined;
    const currentDisplayName = String(profileResult.data.display_name ?? '');
    const ownsRepositoryDocuments = siteContributor?.user_id
      ? siteContributor.user_id === currentUserId
      : Boolean(
          currentDisplayName &&
          siteContributor?.display_name === currentDisplayName,
        );
    if (ownsRepositoryDocuments) {
      articles.forEach((article) => {
        if (article.repository) article.author_id = currentUserId;
      });
    }

    const [articleResult, contributionResult] = await Promise.all([
      supabase!
        .from('articles')
        .select('id,author_id,title,category,status,updated_at')
        .in('status', ['draft', 'published'])
        .order('updated_at', { ascending: false }),
      supabase!
        .from('article_contributors')
        .select('article_id')
        .eq('user_id', currentUserId),
    ]);
    if (articleResult.error) {
      showToast('数据库文章暂时无法加载，已显示仓库文档。', true);
      render();
      return;
    }
    contributedArticleIds = new Set(
      (contributionResult.data ?? []).map((item) => String(item.article_id)),
    );
    const { data } = articleResult;
    const repositoryArticles = articles.filter((article) => article.repository);
    articles = [
      ...((data ?? []) as ManagedArticle[]),
      ...repositoryArticles,
    ].sort((a, b) => Date.parse(b.updated_at) - Date.parse(a.updated_at));
    render();
  };
  void initialize();
</script>

<style>
  .manage-page {
    width: min(44rem, calc(100% - 4rem));
    margin-left: clamp(2rem, 5vw, 4.5rem);
    padding-block: 1rem 5rem;
  }
  header {
    padding: 0.9rem 0 1.25rem;
  }
  header p {
    margin: 0;
    color: var(--color-accent);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.1em;
  }
  h1 {
    margin: 0.28rem 0 0;
    font-size: clamp(1.9rem, 4vw, 2.7rem);
  }
  .workspace-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }
  .new-article {
    padding: 0.65rem 0.9rem;
    border-radius: 0.7rem;
    background: var(--color-text);
    color: var(--color-page);
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
  }
  .filters {
    display: flex;
    gap: 0.35rem;
    margin: 0.35rem 0 1.2rem;
    overflow-x: auto;
  }
  .filters button {
    flex: none;
    padding: 0.48rem 0.72rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    font: inherit;
    font-size: 0.76rem;
  }
  .filters button:hover,
  .filters button.is-active {
    background: var(--color-surface);
    color: var(--color-text);
  }
  .card-meta {
    display: flex;
    gap: 0.45rem;
    color: var(--color-text-muted);
    font-size: 0.66rem;
  }
  .card-meta .status {
    color: var(--color-accent);
  }
  .actions details {
    position: relative;
  }
  .actions summary {
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 0.65rem;
    cursor: pointer;
    font-size: 0.74rem;
    list-style: none;
  }
  .actions summary::-webkit-details-marker {
    display: none;
  }
  .actions details button {
    position: absolute;
    z-index: 2;
    top: calc(100% + 0.3rem);
    right: 0;
    min-width: 5rem;
    background: var(--color-page);
    box-shadow: 0 0.5rem 1.4rem #0002;
  }
  .list {
    display: grid;
    gap: 0.7rem;
  }
  .list :global(article) {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.05rem 1rem 1.2rem;
    border: 1px solid var(--color-border);
    border-radius: 1.05rem;
    background: color-mix(in srgb, var(--color-surface) 72%, var(--color-page));
    box-shadow: 0 0.35rem 1.2rem color-mix(in srgb, #000 5%, transparent);
    animation: card-in 560ms both cubic-bezier(0.22, 1, 0.36, 1);
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }
  .list :global(article::before) {
    position: absolute;
    top: 1rem;
    bottom: 1rem;
    left: 0.55rem;
    width: 2px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent) 52%, transparent);
    content: '';
  }
  .list :global(article:hover) {
    border-color: color-mix(
      in srgb,
      var(--color-accent) 38%,
      var(--color-border)
    );
    box-shadow: 0 0.55rem 1.5rem color-mix(in srgb, #000 9%, transparent);
    transform: translateY(-0.12rem);
  }
  .list :global(article h2) {
    margin: 0.24rem 0 0.1rem;
    font-size: 1.08rem;
    font-weight: 660;
  }
  .list :global(article p),
  .list :global(.empty) {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.76rem;
  }
  .list :global(.actions) {
    display: flex;
    flex: none;
    gap: 0.4rem;
  }
  .list :global(.actions a),
  .list :global(.actions button) {
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 0.65rem;
    background: var(--color-page);
    color: var(--color-text);
    cursor: pointer;
    font: inherit;
    font-size: 0.74rem;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      color 160ms ease;
  }
  .list :global(.actions a:hover) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .list :global(.actions .publish) {
    border-color: color-mix(
      in srgb,
      var(--color-accent) 55%,
      var(--color-border)
    );
    color: var(--color-accent);
  }
  .list :global(.actions .delete) {
    color: #d25a5a;
  }
  .skeleton {
    display: grid;
    gap: 0.48rem;
    padding: 0.95rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 1.05rem;
    overflow: hidden;
  }
  .skeleton > * {
    display: block;
    height: 0.65rem;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--color-text) 4%, transparent) 20%,
      color-mix(in srgb, var(--color-text) 9%, transparent) 50%,
      color-mix(in srgb, var(--color-text) 4%, transparent) 80%
    );
    background-size: 220% 100%;
    animation: shimmer 1.35s ease-in-out infinite;
  }
  .skeleton i {
    width: 3.2rem;
    height: 0.85rem;
  }
  .skeleton b {
    width: 42%;
    height: 0.95rem;
  }
  .skeleton span {
    width: 18%;
  }
  @keyframes shimmer {
    to {
      background-position: -220% 0;
    }
  }
  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(0.28rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .toast {
    position: fixed;
    right: 1.4rem;
    bottom: 1.4rem;
    padding: 0.7rem 0.9rem;
    border-radius: 0.75rem;
    background: var(--color-nav);
    color: var(--color-nav-text);
    font-size: 0.78rem;
    box-shadow: 0 0.8rem 2rem #0003;
  }
  .toast[data-error='true'] {
    color: #ef7777;
  }
  [hidden] {
    display: none !important;
  }
  .manage-page {
    width: min(52rem, calc(100% - 4rem));
  }
  .list {
    width: min(41rem, 100%);
    gap: 0.65rem;
    --workspace-cyan: #2397d4;
    --workspace-teal: #18a88f;
    --workspace-sun: #e8b84a;
  }
  .list :global(article) {
    min-height: 6.7rem;
    padding: 0.72rem 1rem;
    border-color: color-mix(
      in srgb,
      var(--workspace-teal) 30%,
      var(--color-border)
    );
    border-radius: 1rem;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 96% -40%,
        color-mix(in srgb, var(--workspace-teal) 10%, transparent),
        transparent 44%
      ),
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--color-surface) 84%, transparent),
        color-mix(in srgb, var(--color-page) 76%, transparent)
      );
    box-shadow:
      0 0.7rem 1.8rem color-mix(in srgb, var(--workspace-teal) 8%, transparent),
      inset 0 1px 0 color-mix(in srgb, #fff 62%, transparent);
    backdrop-filter: blur(16px) saturate(125%);
    font-family: var(--font-body);
  }
  .list :global(article::before) {
    top: 0.8rem;
    bottom: 0.8rem;
    left: 0.55rem;
    display: block;
    width: 3px;
    background: linear-gradient(
      to bottom,
      var(--workspace-cyan),
      var(--workspace-teal) 68%,
      var(--workspace-sun)
    );
  }
  .list :global(article:hover) {
    border-color: color-mix(
      in srgb,
      var(--workspace-teal) 58%,
      var(--color-border)
    );
    box-shadow: 0 0.9rem 2.2rem
      color-mix(in srgb, var(--workspace-teal) 14%, transparent);
    transform: translateY(-0.12rem);
  }
  .list :global(article h2) {
    margin: 0.26rem 0 0.12rem;
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 680;
    letter-spacing: -0.015em;
  }
  .list :global(.card-meta) {
    align-items: center;
    font-family: var(--font-body);
    font-size: 0.68rem;
  }
  .list :global(.card-meta .status) {
    padding: 0.16rem 0.42rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--workspace-teal) 13%, transparent);
    color: color-mix(in srgb, var(--workspace-teal) 82%, var(--color-text));
  }
  .list :global(.actions a),
  .list :global(.actions button),
  .list :global(.actions summary) {
    border-color: transparent;
    background: color-mix(in srgb, var(--color-page) 58%, transparent);
    backdrop-filter: blur(10px);
    font-family: var(--font-body);
    font-weight: 600;
  }
  .list :global(.actions a:hover),
  .list :global(.actions button:hover),
  .list :global(.actions summary:hover) {
    border-color: color-mix(in srgb, var(--workspace-teal) 48%, transparent);
    color: color-mix(in srgb, var(--workspace-teal) 82%, var(--color-text));
  }
  .list :global(.actions .publish) {
    background: linear-gradient(
      135deg,
      var(--workspace-cyan),
      var(--workspace-teal)
    );
    color: #ffffff;
  }
  :global(html[data-theme='dark']) .list {
    --workspace-cyan: #63cfc0;
    --workspace-teal: #8bdc65;
    --workspace-sun: #c7e97c;
  }
  :global(html[data-theme='dark']) .list :global(article) {
    border-color: color-mix(
      in srgb,
      var(--workspace-teal) 26%,
      var(--color-border)
    );
    background:
      radial-gradient(
        circle at 96% -35%,
        color-mix(in srgb, var(--workspace-teal) 12%, transparent),
        transparent 48%
      ),
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--color-surface) 88%, transparent),
        color-mix(in srgb, var(--color-page) 72%, transparent)
      );
    box-shadow:
      0 0.8rem 2rem color-mix(in srgb, var(--workspace-teal) 7%, transparent),
      inset 0 1px 0 color-mix(in srgb, var(--workspace-teal) 8%, transparent);
  }
  :global(html[data-theme='dark']) .list :global(article:hover) {
    border-color: color-mix(
      in srgb,
      var(--workspace-teal) 44%,
      var(--color-border)
    );
    box-shadow:
      0 0.9rem 2.4rem color-mix(in srgb, var(--workspace-teal) 11%, transparent),
      inset 0 1px 0 color-mix(in srgb, var(--workspace-teal) 10%, transparent);
  }
  @media (max-width: 38rem) {
    .manage-page {
      width: calc(100% - 2rem);
      margin-inline: 1rem;
    }
    .list :global(article) {
      align-items: flex-start;
      flex-direction: column;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .list :global(article),
    .skeleton > * {
      animation: none;
    }
  }
</style>
