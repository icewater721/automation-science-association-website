---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/paths';
---

<BaseLayout title="我的草稿 | 文档" description="管理我的文档草稿。">
  <main class="manage-page" data-page data-login={withBase('/login/')} data-articles={withBase('/articles/')} data-edit={withBase('/articles/drafts/')}>
    <header><p>DOCUMENT WORKSPACE</p><h1>我的草稿</h1></header>
    <div class="list is-loading" data-list aria-busy="true">
      {Array.from({ length: 3 }, () => <div class="skeleton" aria-hidden="true"><i></i><b></b><span></span></div>)}
    </div>
    <p class="toast" data-toast hidden></p>
  </main>
</BaseLayout>

<script>
  import { supabase } from '../../lib/supabase';
  const page = document.querySelector<HTMLElement>('[data-page]');
  const list = document.querySelector<HTMLElement>('[data-list]');
  const toast = document.querySelector<HTMLElement>('[data-toast]');
  const session = (await supabase?.auth.getSession())?.data.session;
  if (!session) window.location.replace(page?.dataset.login ?? '/');
  const profile = session && supabase ? await supabase.from('profiles').select('role').eq('user_id', session.user.id).single() : null;
  if (profile?.data?.role !== 'admin') window.location.replace(page?.dataset.articles ?? '/articles/');
  const showToast = (message: string, error = false) => {
    if (!toast) return;
    toast.textContent = message;
    toast.dataset.error = String(error);
    toast.hidden = false;
    window.setTimeout(() => { toast.hidden = true; }, error ? 4000 : 2200);
  };
  const load = async () => {
    if (!supabase || !session || !list) return;
    const client = supabase;
    const editUrl = page?.dataset.edit ?? '/articles/drafts/';
    const { data, error } = await client.from('articles').select('id,title,category,status,updated_at').eq('author_id', session.user.id).eq('status', 'draft').order('updated_at', { ascending: false });
    list.classList.remove('is-loading'); list.ariaBusy = 'false';
    if (error) { list.innerHTML = '<p class="empty">草稿加载失败。</p>'; return; }
    if (!data?.length) { list.innerHTML = '<p class="empty">还没有草稿。</p>'; return; }
    list.replaceChildren(...data.map((draft) => {
      const card = document.createElement('article');
      card.innerHTML = `<div class="card-content"><h2></h2><p>${draft.category}</p></div><div class="actions"><a>继续编辑</a><button class="publish" type="button">发布</button><button class="delete" type="button">删除</button></div>`;
      card.querySelector('h2')!.textContent = draft.title || '未命名草稿';
      card.querySelector('a')!.setAttribute('href', `${editUrl}?id=${encodeURIComponent(draft.id)}`);
      card.querySelector<HTMLButtonElement>('.publish')!.addEventListener('click', async () => {
        const now = new Date().toISOString();
        const result = await client.from('articles').update({ status: 'published', published_at: now, updated_at: now }).eq('id', draft.id);
        if (result.error) return showToast(result.error.message, true);
        card.remove(); showToast('文档已发布。');
        if (!list.children.length) list.innerHTML = '<p class="empty">还没有草稿。</p>';
      });
      card.querySelector<HTMLButtonElement>('.delete')!.addEventListener('click', async () => {
        if (!window.confirm(`确定删除“${draft.title || '未命名草稿'}”吗？此操作无法撤销。`)) return;
        const result = await client.from('articles').delete().eq('id', draft.id);
        if (result.error) return showToast(result.error.message, true);
        card.remove(); showToast('草稿已删除。');
        if (!list.children.length) list.innerHTML = '<p class="empty">还没有草稿。</p>';
      });
      return card;
    }));
  };
  void load();
</script>

<style>
  .manage-page { width: min(44rem, calc(100% - 4rem)); margin-left: clamp(2rem, 5vw, 4.5rem); padding-block: 1rem 5rem; }
  header { padding: .9rem 0 1.25rem; }
  header p { margin: 0; color: var(--color-accent); font-size: .68rem; font-weight: 750; letter-spacing: .1em; }
  h1 { margin: .28rem 0 0; font-size: clamp(1.9rem, 4vw, 2.7rem); }
  .list { display: grid; gap: .7rem; }
  .list :global(article) { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 1.05rem 1rem 1.2rem; border: 1px solid var(--color-border); border-radius: 1.05rem; background: color-mix(in srgb, var(--color-surface) 72%, var(--color-page)); box-shadow: 0 .35rem 1.2rem color-mix(in srgb, #000 5%, transparent); animation: card-in 560ms both cubic-bezier(.22, 1, .36, 1); transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease; }
  .list :global(article::before) { position: absolute; top: 1rem; bottom: 1rem; left: .55rem; width: 2px; border-radius: 999px; background: color-mix(in srgb, var(--color-accent) 52%, transparent); content: ''; }
  .list :global(article:hover) { border-color: color-mix(in srgb, var(--color-accent) 38%, var(--color-border)); box-shadow: 0 .55rem 1.5rem color-mix(in srgb, #000 9%, transparent); transform: translateY(-.12rem); }
  .list :global(article h2) { margin: .24rem 0 .1rem; font-size: 1.08rem; font-weight: 660; }
  .list :global(article p), .list :global(.empty) { margin: 0; color: var(--color-text-muted); font-size: .76rem; }
  .list :global(.actions) { display: flex; flex: none; gap: .4rem; }
  .list :global(.actions a), .list :global(.actions button) { padding: .5rem .7rem; border: 1px solid var(--color-border); border-radius: .65rem; background: var(--color-page); color: var(--color-text); cursor: pointer; font: inherit; font-size: .74rem; text-decoration: none; transition: border-color 160ms ease, color 160ms ease; }
  .list :global(.actions a:hover) { border-color: var(--color-accent); color: var(--color-accent); }
  .list :global(.actions .publish) { border-color: color-mix(in srgb, var(--color-accent) 55%, var(--color-border)); color: var(--color-accent); }
  .list :global(.actions .delete) { color: #d25a5a; }
  .skeleton { display: grid; gap: .48rem; padding: .95rem 1rem; border: 1px solid var(--color-border); border-radius: 1.05rem; overflow: hidden; }
  .skeleton > * { display: block; height: .65rem; border-radius: 999px; background: linear-gradient(90deg, color-mix(in srgb, var(--color-text) 4%, transparent) 20%, color-mix(in srgb, var(--color-text) 9%, transparent) 50%, color-mix(in srgb, var(--color-text) 4%, transparent) 80%); background-size: 220% 100%; animation: shimmer 1.35s ease-in-out infinite; }
  .skeleton i { width: 3.2rem; height: .85rem; } .skeleton b { width: 42%; height: .95rem; } .skeleton span { width: 18%; }
  @keyframes shimmer { to { background-position: -220% 0; } }
  @keyframes card-in { from { opacity: 0; transform: translateY(.28rem); } to { opacity: 1; transform: translateY(0); } }
  .toast { position: fixed; right: 1.4rem; bottom: 1.4rem; padding: .7rem .9rem; border-radius: .75rem; background: var(--color-nav); color: var(--color-nav-text); font-size: .78rem; box-shadow: 0 .8rem 2rem #0003; }
  .toast[data-error='true'] { color: #ef7777; }
  [hidden] { display: none !important; }
  @media (max-width: 38rem) { .manage-page { width: calc(100% - 2rem); margin-inline: 1rem; } .list :global(article) { align-items: flex-start; flex-direction: column; } }
  @media (prefers-reduced-motion: reduce) { .list :global(article), .skeleton > * { animation: none; } }
</style>
