---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/paths';
---

<BaseLayout title="草稿箱 | 文档" description="创建和管理文档草稿。">
  <main class="draft-page" data-draft-page data-login-url={withBase('/login/')}>
    <header><p>DOCUMENT WORKSPACE</p><h1>草稿箱</h1></header>
    <p class="access-note" data-access-note>正在确认编辑权限……</p>
    <div class="workspace" data-workspace hidden>
      <form data-draft-form>
        <input type="hidden" name="id" />
        <label>标题 <input name="title" maxlength="60" required /></label>
        <label>栏目
          <select name="category"><option>基础工具</option><option>竞赛经验</option><option>项目记录</option><option>科协动态</option><option>其他</option></select>
        </label>
        <label>摘要 <textarea name="summary" maxlength="160" rows="3" required></textarea></label>
        <div class="editor-actions">
          <button class="button button--quiet" type="submit" data-save-draft>保存草稿</button>
          <button class="button button--primary" type="button" data-submit-review>提交审核</button>
          <button class="button button--primary" type="button" data-publish hidden>发布</button>
          <button class="button button--danger" type="button" data-return hidden>退回</button>
        </div>
        <label>正文 <textarea class="markdown-editor" name="content_markdown" rows="24" required></textarea></label>
        <p data-draft-note aria-live="polite"></p>
      </form>
      <aside>
        <div class="draft-create-actions">
          <button class="icon-button" type="button" data-new-draft aria-label="新建文档" title="新建文档">+</button>
          <label class="import-button" title="读取 Markdown">
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3v12M7.5 7.5 12 3l4.5 4.5M5 14v5h14v-5"></path></svg>
            <span>读取 Markdown</span>
            <input data-md-input type="file" accept=".md,.markdown,text/markdown" hidden />
          </label>
        </div>
        <section><p>我的草稿</p><div data-draft-list></div></section>
        <section data-review-section hidden><p>待审核</p><div data-review-list></div></section>
      </aside>
    </div>
  </main>
</BaseLayout>

<script>
  import { supabase } from '../../lib/supabase';
  const page = document.querySelector<HTMLElement>('[data-draft-page]');
  const workspace = document.querySelector<HTMLElement>('[data-workspace]');
  const accessNote = document.querySelector<HTMLElement>('[data-access-note]');
  const form = document.querySelector<HTMLFormElement>('[data-draft-form]');
  const draftList = document.querySelector<HTMLElement>('[data-draft-list]');
  const note = document.querySelector<HTMLElement>('[data-draft-note]');
  const session = (await supabase?.auth.getSession())?.data.session;
  if (!session) window.location.replace(page?.dataset.loginUrl ?? '/');

  let role = '';
  if (session && supabase) {
    const current = await supabase.from('profiles').select('role').eq('user_id', session.user.id).single();
    if (current.error?.code === '42703') {
      const legacy = await supabase.from('profiles').select('is_collaborator').eq('user_id', session.user.id).single();
      role = legacy.data?.is_collaborator ? 'editor' : '';
    } else role = String(current.data?.role ?? '');
  }
  if (role === 'editor' || role === 'admin') {
    if (workspace) workspace.hidden = false;
    if (accessNote) accessNote.hidden = true;
  } else if (accessNote) accessNote.textContent = '此功能仅对编辑和管理员开放。';
  if (role === 'admin') {
    const reviewSection = document.querySelector<HTMLElement>('[data-review-section]');
    if (reviewSection) reviewSection.hidden = false;
  }

  const setNote = (message: string, error = false) => {
    if (!note) return;
    note.textContent = message;
    note.dataset.error = String(error);
  };
  const fillForm = (draft: Record<string, unknown>) => {
    if (!form) return;
    for (const [key, value] of Object.entries(draft)) {
      const field = form.elements.namedItem(key);
      if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement) field.value = String(value ?? '');
    }
    const reviewing = draft.status === 'review';
    const saveButton = document.querySelector<HTMLElement>('[data-save-draft]');
    const submitButton = document.querySelector<HTMLElement>('[data-submit-review]');
    if (saveButton) saveButton.hidden = reviewing;
    if (submitButton) submitButton.hidden = reviewing;
    document.querySelectorAll<HTMLElement>('[data-publish],[data-return]').forEach((button) => (button.hidden = !reviewing || role !== 'admin'));
  };
  const loadDrafts = async () => {
    if (!supabase || !session || !draftList) return;
    const { data, error } = await supabase.from('articles').select('id,title,category,summary,content_markdown,status,updated_at').eq('author_id', session.user.id).in('status', ['draft', 'review']).order('updated_at', { ascending: false });
    if (error) return setNote('草稿数据库尚未启用。', true);
    draftList.replaceChildren(...(data ?? []).map((draft) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = `${draft.title || '未命名草稿'}${draft.status === 'review' ? ' · 待审核' : ''}`;
      button.addEventListener('click', () => fillForm(draft));
      return button;
    }));
  };
  const loadReviews = async () => {
    const reviewList = document.querySelector<HTMLElement>('[data-review-list]');
    if (!supabase || role !== 'admin' || !reviewList) return;
    const { data } = await supabase.from('articles').select('id,title,category,summary,content_markdown,status,updated_at').eq('status', 'review').order('updated_at');
    reviewList.replaceChildren(...(data ?? []).map((draft) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = draft.title || '未命名文档';
      button.addEventListener('click', () => fillForm(draft));
      return button;
    }));
  };
  if (role === 'editor' || role === 'admin') void loadDrafts();
  if (role === 'admin') void loadReviews();
  document.querySelector('[data-new-draft]')?.addEventListener('click', () => {
    form?.reset();
    const id = form?.elements.namedItem('id');
    if (id instanceof HTMLInputElement) id.value = '';
    document.querySelectorAll<HTMLElement>('[data-save-draft],[data-submit-review]').forEach((button) => (button.hidden = false));
    document.querySelectorAll<HTMLElement>('[data-publish],[data-return]').forEach((button) => (button.hidden = true));
  });
  document.querySelector<HTMLInputElement>('[data-md-input]')?.addEventListener('change', async (event) => {
    const input = event.currentTarget as HTMLInputElement;
    const file = input.files?.[0];
    if (!file || !form) return;
    const markdown = await file.text();
    const content = form.elements.namedItem('content_markdown');
    const title = form.elements.namedItem('title');
    if (content instanceof HTMLTextAreaElement) content.value = markdown;
    const heading = markdown.match(/^#\s+(.+)$/m)?.[1];
    if (heading && title instanceof HTMLInputElement && !title.value) title.value = heading.slice(0, 60);
    input.value = '';
  });
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!supabase || !session) return;
    const values = Object.fromEntries(new FormData(form));
    const id = String(values.id || '');
    const payload = { title: String(values.title), category: String(values.category), summary: String(values.summary), content_markdown: String(values.content_markdown), status: 'draft', updated_at: new Date().toISOString() };
    const result = id ? await supabase.from('articles').update(payload).eq('id', id).select('id').single() : await supabase.from('articles').insert({ ...payload, author_id: session.user.id }).select('id').single();
    if (result.error) return setNote(result.error.message, true);
    const idField = form.elements.namedItem('id');
    if (idField instanceof HTMLInputElement) idField.value = result.data.id;
    setNote('草稿已保存。');
    void loadDrafts();
  });
  const updateStatus = async (status: 'draft' | 'review' | 'published') => {
    if (!supabase || !form) return;
    const id = form.elements.namedItem('id');
    if (!(id instanceof HTMLInputElement) || !id.value) return setNote('请先保存草稿。', true);
    const updates: Record<string, string | null> = { status, updated_at: new Date().toISOString() };
    if (status === 'review') {
      if (!form.reportValidity()) return;
      const values = Object.fromEntries(new FormData(form));
      updates.title = String(values.title);
      updates.category = String(values.category);
      updates.summary = String(values.summary);
      updates.content_markdown = String(values.content_markdown);
    }
    if (status === 'published') updates.published_at = new Date().toISOString();
    const { error } = await supabase.from('articles').update(updates).eq('id', id.value);
    if (error) return setNote(error.message, true);
    setNote(status === 'review' ? '已提交审核。' : status === 'published' ? '文档已发布。' : '已退回草稿。');
    form.reset();
    void loadDrafts();
    void loadReviews();
  };
  document.querySelector('[data-submit-review]')?.addEventListener('click', () => void updateStatus('review'));
  document.querySelector('[data-publish]')?.addEventListener('click', () => void updateStatus('published'));
  document.querySelector('[data-return]')?.addEventListener('click', () => void updateStatus('draft'));
</script>

<style>
  .draft-page { width: min(72rem, calc(100% - 4rem)); margin-inline: auto; padding-block: 2.5rem 5rem; }
  header p { margin: 0; color: var(--color-accent); font-size: 0.72rem; font-weight: 750; letter-spacing: 0.1em; }
  h1 { margin: 0.35rem 0 1.6rem; font-size: clamp(1.9rem, 4vw, 2.65rem); letter-spacing: -0.035em; }
  .workspace { display: grid; grid-template-columns: minmax(0, 48rem) 14rem; justify-content: center; gap: clamp(1.5rem, 4vw, 3rem); }
  aside { position: sticky; top: 2rem; display: grid; align-content: start; gap: 1rem; }
  aside section { display: grid; gap: 0.4rem; }
  aside p { margin: 0; color: var(--color-text-muted); font-size: 0.7rem; font-weight: 720; letter-spacing: 0.06em; }
  [data-draft-list], [data-review-list] { display: grid; gap: 0.25rem; }
  [data-draft-list] button, [data-review-list] button { width: 100%; padding: 0.58rem 0.65rem; overflow: hidden; border: 0; border-radius: 0.45rem; background: transparent; color: var(--color-text-muted); cursor: pointer; font: inherit; font-size: 0.78rem; text-align: left; text-overflow: ellipsis; white-space: nowrap; transition: background 160ms ease, color 160ms ease, transform 160ms ease; }
  [data-draft-list] button:hover, [data-review-list] button:hover { background: var(--color-surface); color: var(--color-text); transform: translateX(0.15rem); }
  .draft-create-actions { display: flex; align-items: center; gap: 0.45rem; padding-bottom: 0.8rem; border-bottom: 1px solid var(--color-border); }
  .icon-button { display: grid; width: 2.35rem; height: 2.35rem; flex: none; place-items: center; border: 1px solid var(--color-border); border-radius: 50%; background: transparent; color: var(--color-text); cursor: pointer; font-size: 1.35rem; line-height: 1; transition: border-color 160ms ease, background 160ms ease, transform 160ms ease; }
  .icon-button:hover { border-color: var(--color-accent); background: color-mix(in srgb, var(--color-accent) 8%, transparent); transform: rotate(90deg); }
  .import-button { display: flex; min-width: 0; align-items: center; gap: 0.4rem; padding: 0.58rem 0.65rem; border: 0; border-radius: 0.45rem; color: var(--color-text-muted); cursor: pointer; font-size: 0.72rem; font-weight: 650; transition: background 160ms ease, color 160ms ease; }
  .import-button:hover { background: var(--color-surface); color: var(--color-text); }
  .import-button svg { width: 1rem; height: 1rem; flex: none; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.7; }
  .import-button span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  form { display: grid; gap: 1rem; }
  label { display: grid; gap: 0.4rem; font-size: 0.82rem; font-weight: 700; }
  input, select, textarea { width: 100%; padding: 0.7rem; border: 1px solid var(--color-border); border-radius: 0.4rem; background: var(--color-page); font: inherit; }
  .markdown-editor { font-family: ui-monospace, 'Cascadia Code', monospace; line-height: 1.65; resize: vertical; }
  .editor-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: center; gap: 0.45rem; }
  .button { width: auto; padding: 0.62rem 0.9rem; border: 1px solid transparent; border-radius: 999px; cursor: pointer; font: inherit; font-size: 0.78rem; font-weight: 680; transition: background 160ms ease, color 160ms ease, border-color 160ms ease, transform 160ms ease; }
  .button:hover { transform: translateY(-0.1rem); }
  .button--quiet { border-color: var(--color-border); background: transparent; }
  .button--quiet:hover { border-color: var(--color-text-muted); }
  .button--primary { background: var(--color-text); color: var(--color-page); }
  .button--primary:hover { background: var(--color-accent); }
  .button--danger { border-color: color-mix(in srgb, #c23b3b 35%, var(--color-border)); background: transparent; color: #c23b3b; }
  .button--danger:hover { background: color-mix(in srgb, #c23b3b 9%, transparent); }
  [data-draft-note][data-error='true'] { color: #c23b3b; }
  [hidden] { display: none !important; }
  @media (max-width: 60rem) { .draft-page { width: calc(100% - 2rem); } .workspace { grid-template-columns: 1fr; } aside { position: static; grid-row: 1; } }
</style>
