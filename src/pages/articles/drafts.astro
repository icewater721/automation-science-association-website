---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/paths';
---

<BaseLayout title="编辑文档 | 文档" description="创建和编辑文档。">
  <main
    class="draft-page"
    data-draft-page
    data-login-url={withBase('/login/')}
    data-articles-url={withBase('/articles/')}
    data-workspace-url={withBase('/articles/mine/')}
    data-loading="true"
    aria-busy="true"
  >
    <a class="back-link" href={withBase('/articles/mine/')}
      >← <span>返回创作中心</span></a
    >
    <header><p>DOCUMENT WORKSPACE</p><h1>编辑文档</h1></header>
    <div class="editor-loading" data-editor-loading aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <div class="workspace" data-workspace>
      <form data-draft-form>
        <input type="hidden" name="id" />
        <label>标题 <input name="title" maxlength="60" required /></label>
        <label class="category-field"
          >栏目
          <input type="hidden" name="category" value="未分类" />
          <details class="category-select" data-category-select>
            <summary
              ><span data-category-value>未分类</span><svg
                aria-hidden="true"
                viewBox="0 0 24 24"><path d="m7 9 5 5 5-5"></path></svg
              ></summary
            >
            <div>
              <button type="button" data-category-option="技术分享"
                >技术分享</button
              ><button type="button" data-category-option="工具使用"
                >工具使用</button
              ><button type="button" data-category-option="竞赛经验"
                >竞赛经验</button
              ><button type="button" data-category-option="项目记录"
                >项目记录</button
              ><button type="button" data-category-option="公告">公告</button
              ><button type="button" data-category-option="未分类"
                >未分类</button
              >
            </div>
          </details>
        </label>
        <label
          >摘要 <textarea name="summary" maxlength="160" rows="3" required
          ></textarea></label
        >
        <div class="content-field">
          <div class="content-field-heading"><span>正文</span></div>
          <textarea
            class="markdown-editor"
            name="content_markdown"
            rows="18"
            required
            spellcheck="false"
            data-gramm="false"
            data-gramm_editor="false"
            placeholder="使用 Markdown 语法开始写正文……"></textarea>
        </div>
        <div class="editor-actions">
          <button class="button button--quiet" type="submit" data-save-draft
            >保存草稿</button
          >
          <button
            class="button button--primary"
            type="button"
            data-publish
            hidden>发布</button
          >
        </div>
        <p class="editor-toast" data-draft-note aria-live="polite" hidden></p>
      </form>
      <aside>
        <p class="aside-title">编辑工具</p>
        <div class="format-tools" aria-label="正文工具">
          <label class="toolbar-upload"
            ><svg viewBox="0 0 24 24"
              ><rect x="3" y="4" width="18" height="16" rx="2"></rect><path
                d="m5 17 5-5 3 3 2-2 4 4"></path></svg
            >图片<input
              data-image-input
              type="file"
              accept="image/png,image/jpeg,image/webp,image/gif"
              hidden
            /></label
          >
          <button type="button" data-command="undo"
            ><svg viewBox="0 0 24 24"
              ><path d="m9 7-5 5 5 5M5 12h8a6 6 0 0 1 6 6"></path></svg
            >上一步</button
          ><button type="button" data-command="redo"
            ><svg viewBox="0 0 24 24"
              ><path d="m15 7 5 5-5 5m4-5h-8a6 6 0 0 0-6 6"></path></svg
            >下一步</button
          >
        </div>
      </aside>
    </div>
  </main>
</BaseLayout>

<script>
  import { supabase } from '../../lib/supabase';
  const page = document.querySelector<HTMLElement>('[data-draft-page]');
  const form = document.querySelector<HTMLFormElement>('[data-draft-form]');
  const draftList = document.querySelector<HTMLElement>('[data-draft-list]');
  const note = document.querySelector<HTMLElement>('[data-draft-note]');
  const markdownEditor = form?.elements.namedItem('content_markdown');
  const richEditor = document.querySelector<HTMLElement>('[data-rich-editor]');
  let savedRange: Range | null = null;
  const rememberSelection = () => {
    const selection = window.getSelection();
    if (selection?.rangeCount && richEditor?.contains(selection.anchorNode))
      savedRange = selection.getRangeAt(0).cloneRange();
  };
  const restoreSelection = () => {
    richEditor?.focus();
    if (!savedRange) return;
    const selection = window.getSelection();
    selection?.removeAllRanges();
    selection?.addRange(savedRange);
  };
  const markdownFromHtml = (html: string) => {
    const root = document.createElement('div');
    root.innerHTML = html;
    const convert = (node: Node): string => {
      if (node.nodeType === Node.TEXT_NODE) return node.textContent ?? '';
      if (!(node instanceof HTMLElement)) return '';
      if (node.classList.contains('editor-atomic')) {
        const media = node.querySelector<HTMLElement>('img,video,pre,hr');
        if (media instanceof HTMLImageElement)
          media.alt =
            node.querySelector('figcaption')?.textContent?.trim() ||
            media.alt ||
            '图片';
        return media ? convert(media) : '';
      }
      if (node.matches('[data-delete-atomic]')) return '';
      const content = [...node.childNodes].map(convert).join('');
      const tag = node.tagName.toLowerCase();
      if (tag === 'strong' || tag === 'b') return `**${content}**`;
      if (tag === 'em' || tag === 'i') return `*${content}*`;
      if (tag === 'a')
        return `[${content}](${node.getAttribute('href') ?? ''})`;
      if (tag === 'img')
        return `\n![${node.getAttribute('alt') ?? '图片'}](${node.getAttribute('src') ?? ''})\n`;
      if (tag === 'video')
        return `\n[视频](${node.getAttribute('src') ?? ''})\n`;
      if (tag === 'pre') return `\n\`\`\`\n${node.textContent ?? ''}\n\`\`\`\n`;
      if (tag === 'blockquote') return `\n> ${content}\n`;
      if (tag === 'hr') return '\n---\n';
      if (tag === 'li') return `- ${content}\n`;
      if (/^h[1-3]$/.test(tag))
        return `\n${'#'.repeat(Number(tag[1]))} ${content}\n`;
      if (tag === 'br') return '\n';
      if (tag === 'p' || tag === 'div') return `${content}\n\n`;
      return content;
    };
    return [...root.childNodes]
      .map(convert)
      .join('')
      .replace(/\n{3,}/g, '\n\n')
      .trim();
  };
  const syncMarkdown = () => {
    if (markdownEditor instanceof HTMLTextAreaElement && richEditor)
      markdownEditor.value = markdownFromHtml(richEditor.innerHTML);
  };
  const hydrateAtomicBlocks = () => {
    if (!richEditor) return;
    richEditor
      .querySelectorAll<HTMLElement>('img,video,pre,hr')
      .forEach((element) => {
        if (element.closest('.editor-atomic')) return;
        const isMedia = element.matches('img,video');
        const wrapper = document.createElement(isMedia ? 'figure' : 'div');
        wrapper.className = `editor-atomic${isMedia ? ' editor-atomic--media' : element.tagName === 'PRE' ? ' editor-atomic--code' : ' editor-atomic--divider'}`;
        wrapper.contentEditable = 'true';
        const parent = element.parentElement;
        if (parent?.tagName === 'P' && parent.childNodes.length === 1)
          parent.replaceWith(wrapper);
        else element.replaceWith(wrapper);
        if (element.tagName === 'PRE') {
          const label = document.createElement('span');
          label.textContent = '代码';
          wrapper.append(label);
          element.contentEditable = 'true';
        }
        if (element.matches('img,video,hr')) element.contentEditable = 'false';
        wrapper.append(element);
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.dataset.deleteAtomic = '';
        remove.ariaLabel = '删除内容块';
        remove.textContent = '×';
        wrapper.append(remove);
        remove.contentEditable = 'false';
        if (isMedia) {
          const caption = document.createElement('figcaption');
          caption.contentEditable = 'true';
          caption.dataset.placeholder =
            element.tagName === 'IMG'
              ? '添加图片描述（可选）'
              : '添加视频描述（可选）';
          wrapper.append(caption);
        }
        if (!wrapper.previousElementSibling)
          wrapper.before(
            Object.assign(document.createElement('p'), { innerHTML: '<br>' }),
          );
        if (!wrapper.nextElementSibling)
          wrapper.after(
            Object.assign(document.createElement('p'), { innerHTML: '<br>' }),
          );
      });
  };
  const closeCreateMenu = () => {
    const menu = document.querySelector<HTMLDetailsElement>('.create-menu');
    if (menu) menu.open = false;
  };
  const session = (await supabase?.auth.getSession())?.data.session;
  if (!session) window.location.replace(page?.dataset.loginUrl ?? '/');

  let role = '';
  if (session && supabase) {
    const current = await supabase
      .from('profiles')
      .select('role')
      .eq('user_id', session.user.id)
      .single();
    if (current.error?.code === '42703') {
      const legacy = await supabase
        .from('profiles')
        .select('is_collaborator')
        .eq('user_id', session.user.id)
        .single();
      role = legacy.data?.is_collaborator ? 'editor' : '';
    } else role = String(current.data?.role ?? '');
  }
  if (role !== 'admin')
    window.location.replace(page?.dataset.articlesUrl ?? '/articles/');
  window.requestAnimationFrame(() => {
    if (!page) return;
    page.dataset.loading = 'false';
    page.setAttribute('aria-busy', 'false');
  });

  let noteTimer: number | undefined;
  let currentStatus: 'draft' | 'published' = 'draft';
  const setNote = (message: string, error = false) => {
    if (!note) return;
    window.clearTimeout(noteTimer);
    note.textContent = message;
    note.dataset.error = String(error);
    note.hidden = false;
    note.animate(
      [
        { opacity: 0, transform: 'translateY(0.45rem)' },
        { opacity: 1, transform: 'translateY(0)' },
      ],
      { duration: 180, easing: 'ease-out' },
    );
    noteTimer = window.setTimeout(
      () => {
        note
          .animate([{ opacity: 1 }, { opacity: 0 }], {
            duration: 160,
            easing: 'ease-in',
          })
          .finished.then(() => {
            note.hidden = true;
          });
      },
      error ? 4200 : 2200,
    );
  };
  const fillForm = (draft: Record<string, unknown>) => {
    if (!form) return;
    currentStatus = draft.status === 'published' ? 'published' : 'draft';
    for (const [key, value] of Object.entries(draft)) {
      const field = form.elements.namedItem(key);
      if (
        field instanceof HTMLInputElement ||
        field instanceof HTMLTextAreaElement ||
        field instanceof HTMLSelectElement
      )
        field.value = String(value ?? '');
    }
    const normalizedCategory =
      String(draft.category || '未分类') === '其他'
        ? '未分类'
        : String(draft.category || '未分类');
    const categoryInput = form.elements.namedItem('category');
    if (categoryInput instanceof HTMLInputElement)
      categoryInput.value = normalizedCategory;
    const categoryValue = document.querySelector<HTMLElement>(
      '[data-category-value]',
    );
    if (categoryValue) categoryValue.textContent = normalizedCategory;
    const publishButton = document.querySelector<HTMLElement>('[data-publish]');
    if (publishButton) {
      publishButton.hidden = role !== 'admin' || currentStatus === 'published';
      publishButton.textContent = '发布';
    }
    const saveButton = document.querySelector<HTMLElement>('[data-save-draft]');
    if (saveButton)
      saveButton.textContent =
        currentStatus === 'published' ? '保存并更新' : '保存草稿';
  };
  const loadDrafts = async () => {
    if (!supabase || !session || !draftList) return;
    const { data, error } = await supabase
      .from('articles')
      .select('id,title,category,summary,content_markdown,status,updated_at')
      .eq('author_id', session.user.id)
      .eq('status', 'draft')
      .order('updated_at', { ascending: false });
    if (error) return setNote('草稿数据库尚未启用。', true);
    draftList.replaceChildren(
      ...(data ?? []).map((draft) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = draft.title || '未命名草稿';
        button.addEventListener('click', () => fillForm(draft));
        return button;
      }),
    );
  };
  void loadDrafts();
  const requestedDraftId = new URLSearchParams(window.location.search).get(
    'id',
  );
  if (requestedDraftId && supabase) {
    const { data: requestedDraft } = await supabase
      .from('articles')
      .select('id,title,category,summary,content_markdown,status,updated_at')
      .eq('id', requestedDraftId)
      .single();
    if (requestedDraft) fillForm(requestedDraft);
  }
  document.querySelector('[data-new-draft]')?.addEventListener('click', () => {
    form?.reset();
    const id = form?.elements.namedItem('id');
    if (id instanceof HTMLInputElement) id.value = '';
    if (richEditor) richEditor.innerHTML = '';
    currentStatus = 'draft';
    const saveButton = document.querySelector<HTMLElement>('[data-save-draft]');
    if (saveButton) saveButton.textContent = '保存草稿';
    const publishButton = document.querySelector<HTMLElement>('[data-publish]');
    if (publishButton) {
      publishButton.hidden = role !== 'admin';
      publishButton.textContent = '发布';
    }
    closeCreateMenu();
  });
  const insertHtmlAtCaret = (html: string) => {
    if (!richEditor) return;
    restoreSelection();
    const selection = window.getSelection();
    const range = selection?.rangeCount ? selection.getRangeAt(0) : null;
    if (!range) return;
    range.deleteContents();
    const fragment = range.createContextualFragment(html);
    const last = fragment.lastChild;
    range.insertNode(fragment);
    if (last) {
      range.setStartAfter(last);
      range.collapse(true);
      selection?.removeAllRanges();
      selection?.addRange(range);
      savedRange = range.cloneRange();
    }
  };
  const uploadAndInsertImage = async (file: File) => {
    if (
      !file ||
      !supabase ||
      !session ||
      !(markdownEditor instanceof HTMLTextAreaElement)
    )
      return;
    if (file.size > 8 * 1024 * 1024) {
      setNote('图片不能超过 8 MB。', true);
      return;
    }
    const extension = file.name.split('.').pop()?.toLowerCase() || 'webp';
    const path = `${session.user.id}/${Date.now()}-${crypto.randomUUID()}.${extension}`;
    const { error } = await supabase.storage
      .from('article-images')
      .upload(path, file);
    if (error) {
      setNote(error.message, true);
      return;
    }
    const url = supabase.storage.from('article-images').getPublicUrl(path)
      .data.publicUrl;
    const safeUrl = url.replace(/["<>]/g, '');
    const safeAlt = file.name.replace(/\.[^.]+$/, '').replace(/["<>]/g, '');
    const start = markdownEditor.selectionStart;
    const end = markdownEditor.selectionEnd;
    const markdown = `\n![${safeAlt}](${safeUrl})\n`;
    markdownEditor.setRangeText(markdown, start, end, 'end');
    markdownEditor.focus();
    setNote('图片已插入正文。');
  };
  document
    .querySelector<HTMLInputElement>('[data-image-input]')
    ?.addEventListener('change', async (event) => {
      const input = event.currentTarget as HTMLInputElement;
      const file = input.files?.[0];
      if (file) await uploadAndInsertImage(file);
      input.value = '';
    });
  if (markdownEditor instanceof HTMLTextAreaElement)
    markdownEditor.addEventListener('paste', (event) => {
      const image = [...(event.clipboardData?.files ?? [])].find((file) =>
        file.type.startsWith('image/'),
      );
      if (!image) return;
      event.preventDefault();
      void uploadAndInsertImage(image);
    });
  richEditor?.addEventListener('input', () => {
    rememberSelection();
    syncMarkdown();
  });
  richEditor?.addEventListener('keyup', rememberSelection);
  richEditor?.addEventListener('pointerup', rememberSelection);
  document
    .querySelector('.format-tools')
    ?.addEventListener('pointerdown', (event) => event.preventDefault());
  richEditor?.addEventListener('keydown', (event) => {
    if (event.key !== ' ') return;
    const selection = window.getSelection();
    const anchor =
      selection?.anchorNode instanceof HTMLElement
        ? selection.anchorNode
        : selection?.anchorNode?.parentElement;
    const block = anchor?.closest<HTMLElement>('p,div');
    const marker = block?.textContent?.trim().match(/^(#{1,3})$/)?.[1];
    if (
      !marker ||
      block === richEditor ||
      block?.classList.contains('editor-atomic')
    )
      return;
    event.preventDefault();
    block.textContent = '';
    document.execCommand('formatBlock', false, `h${marker.length}`);
    rememberSelection();
    syncMarkdown();
  });
  richEditor?.addEventListener('click', (event) => {
    const link = (event.target as HTMLElement).closest('a');
    if (link) event.preventDefault();
    const button = (event.target as HTMLElement).closest<HTMLElement>(
      '[data-delete-atomic]',
    );
    if (!button) return;
    button.closest('.editor-atomic')?.remove();
    syncMarkdown();
  });
  document
    .querySelectorAll<HTMLButtonElement>('[data-command]')
    .forEach((button) =>
      button.addEventListener('click', () => {
        if (!(markdownEditor instanceof HTMLTextAreaElement)) return;
        markdownEditor.focus();
        document.execCommand(button.dataset.command ?? '');
      }),
    );
  document
    .querySelector('[data-action="divider"]')
    ?.addEventListener('click', () => {
      insertHtmlAtCaret(
        '<p><br></p><div class="editor-atomic editor-atomic--divider" contenteditable="true"><hr contenteditable="false"><button type="button" contenteditable="false" data-delete-atomic aria-label="删除分割线">×</button></div><p><br></p>',
      );
      syncMarkdown();
    });
  document
    .querySelector('[data-action="code"]')
    ?.addEventListener('click', () => {
      insertHtmlAtCaret(
        '<p><br></p><div class="editor-atomic editor-atomic--code" contenteditable="true"><span contenteditable="false">代码</span><pre contenteditable="true"><br></pre><button type="button" contenteditable="false" data-delete-atomic aria-label="删除代码块">×</button></div><p><br></p>',
      );
      syncMarkdown();
    });
  document
    .querySelector('[data-action="link"]')
    ?.addEventListener('click', () => {
      const selectedText = savedRange?.toString().trim() ?? '';
      const text = selectedText || window.prompt('输入链接文字') || '';
      if (!text) return;
      const url = window.prompt('输入链接地址', 'https://');
      if (url) {
        restoreSelection();
        document.execCommand(
          'insertHTML',
          false,
          `<a href="${url.replace(/["<>]/g, '')}">${text.replace(/[<>]/g, '')}</a>`,
        );
        syncMarkdown();
      }
    });
  document
    .querySelector('[data-action="comment"]')
    ?.addEventListener('click', () => {
      restoreSelection();
      document.execCommand('foreColor', false, '#7a8799');
      document.execCommand('italic');
      syncMarkdown();
    });
  document
    .querySelectorAll<HTMLButtonElement>('[data-category-option]')
    .forEach((button) =>
      button.addEventListener('click', () => {
        const value = button.dataset.categoryOption ?? '未分类';
        const input = form?.elements.namedItem('category');
        if (input instanceof HTMLInputElement) input.value = value;
        const label = document.querySelector<HTMLElement>(
          '[data-category-value]',
        );
        if (label) label.textContent = value;
        const select = document.querySelector<HTMLDetailsElement>(
          '[data-category-select]',
        );
        if (select) select.open = false;
      }),
    );
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!supabase || !session) return;
    syncMarkdown();
    const values = Object.fromEntries(new FormData(form));
    const id = String(values.id || '');
    const payload = {
      title: String(values.title),
      category: String(values.category),
      summary: String(values.summary),
      content_markdown: String(values.content_markdown),
      status: currentStatus,
      updated_at: new Date().toISOString(),
    };
    const result = id
      ? await supabase
          .from('articles')
          .update(payload)
          .eq('id', id)
          .select('id')
          .single()
      : await supabase
          .from('articles')
          .insert({ ...payload, author_id: session.user.id })
          .select('id')
          .single();
    if (result.error) return setNote(result.error.message, true);
    const idField = form.elements.namedItem('id');
    if (idField instanceof HTMLInputElement) idField.value = result.data.id;
    setNote(
      currentStatus === 'published' ? '线上文档已更新。' : '草稿已保存。',
    );
    void loadDrafts();
  });
  const publishDraft = async () => {
    if (!supabase || !form) return;
    if (role !== 'admin') return setNote('只有管理员可以发布文档。', true);
    const id = form.elements.namedItem('id');
    if (!(id instanceof HTMLInputElement) || !id.value)
      return setNote('请先保存草稿。', true);
    syncMarkdown();
    if (!form.reportValidity()) return;
    const values = Object.fromEntries(new FormData(form));
    const now = new Date().toISOString();
    const updates = {
      status: 'published',
      updated_at: now,
      published_at: now,
      title: String(values.title),
      category: String(values.category),
      summary: String(values.summary),
      content_markdown: String(values.content_markdown),
    };
    const { error } = await supabase
      .from('articles')
      .update(updates)
      .eq('id', id.value);
    if (error) return setNote(error.message, true);
    setNote('文档已发布。');
    form.reset();
    void loadDrafts();
  };
  document
    .querySelector('[data-publish]')
    ?.addEventListener('click', () => void publishDraft());
</script>

<style>
  .draft-page {
    width: min(72rem, calc(100% - 4rem));
    margin-inline: auto;
    padding-block: 1rem 5rem;
  }
  .back-link {
    display: inline-flex;
    gap: 0.45rem;
    margin-bottom: 0.8rem;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    text-decoration: none;
    transition:
      color 160ms ease,
      transform 160ms ease;
  }
  .back-link:hover {
    color: var(--color-accent);
    transform: translateX(-0.15rem);
  }
  header p {
    margin: 0;
    color: var(--color-accent);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.1em;
  }
  h1 {
    margin: 0.35rem 0 1.6rem;
    font-size: clamp(1.9rem, 4vw, 2.65rem);
    letter-spacing: -0.035em;
  }
  .editor-loading {
    display: none;
  }
  .draft-page[data-loading='true'] .workspace {
    visibility: hidden;
    opacity: 0;
  }
  .draft-page[data-loading='true'] .editor-loading {
    display: grid;
    gap: 0.75rem;
    width: min(42rem, 100%);
    padding-top: 1.25rem;
  }
  .editor-loading span {
    display: block;
    height: 3.1rem;
    border-radius: 0.75rem;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--color-text) 4%, transparent) 20%,
      color-mix(in srgb, var(--color-text) 9%, transparent) 50%,
      color-mix(in srgb, var(--color-text) 4%, transparent) 80%
    );
    background-size: 220% 100%;
    animation: editor-shimmer 1.25s ease-in-out infinite;
  }
  .editor-loading span:nth-child(2) {
    height: 6rem;
  }
  .editor-loading span:nth-child(3) {
    height: 22rem;
  }
  @keyframes editor-shimmer {
    to {
      background-position: -220% 0;
    }
  }
  .workspace {
    transition: opacity 180ms ease;
  }
  .workspace {
    display: grid;
