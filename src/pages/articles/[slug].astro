---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { withBase } from '../../utils/paths';

export const getStaticPaths = (async () => {
  const slugFor = (id: string) =>
    id.split('/').at(-1)?.replace(/\.mdx?$/, '') ?? id;
  const entries = await getCollection('docs', ({ data }) => data.kind === 'document' && !data.draft);
  return entries.map((entry) => ({ params: { slug: slugFor(entry.id) }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const slugFor = (id: string) => id.split('/').at(-1)?.replace(/\.mdx?$/, '') ?? id;
const { Content, headings } = await render(entry);
const entries = (await getCollection('docs', ({ data }) => data.kind === 'document' && !data.draft))
  .filter((item) => item.data.category === entry.data.category)
  .sort((a, b) => a.data.order - b.data.order);
const currentIndex = entries.findIndex((item) => item.id === entry.id);
const navigationItem = (item: (typeof entries)[number] | undefined) => item ? {
  title: item.data.title,
  href: withBase(`/articles/${slugFor(item.id)}/`),
} : undefined;
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  browserTitle={`${entry.data.title} | 文档`}
  headings={headings}
  breadcrumbs={[
    { title: '文档', href: withBase('/articles/') },
    { title: entry.data.category },
    { title: entry.data.title },
  ]}
  previous={navigationItem(entries[currentIndex - 1])}
  next={navigationItem(entries[currentIndex + 1])}
>
  <Content />
</DocsLayout>
