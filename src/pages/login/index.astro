---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/paths';
---

<BaseLayout
  title="个人登录 | 人工智能学院科协"
  description="登录科协个人空间。"
>
  <main class="auth-page">
    <section class="auth-intro">
      <p class="eyebrow">MEMBER SPACE</p>
      <h1>个人空间</h1>
      <p>用邮箱接收一次性验证码，登录后管理个人资料并查看自己发布过的文章。</p>
      <a href={withBase('/profile/')}>预览个人页</a>
    </section>

    <section class="auth-card" aria-labelledby="login-title">
      <div>
        <p class="step">01 / 邮箱验证</p>
        <h2 id="login-title">登录或创建账号</h2>
      </div>
      <form data-login-form data-profile-url={withBase('/profile/')}>
        <div data-email-step>
          <label for="email">邮箱</label>
          <div class="field-row">
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              placeholder="name@example.com"
              required
            />
            <button type="submit">发送验证码</button>
          </div>
        </div>
        <div data-code-step hidden>
          <label for="code">六位验证码</label>
          <div class="field-row">
            <input
              id="code"
              name="code"
              inputmode="numeric"
              autocomplete="one-time-code"
              pattern="[0-9]{6}"
              maxlength="6"
              placeholder="000000"
            />
            <button type="submit">验证并登录</button>
          </div>
          <div class="code-actions">
            <button class="text-button" type="button" data-change-email
              >更换邮箱</button
            >
            <button class="text-button" type="button" data-resend-code disabled>
              60 秒后重新发送
            </button>
          </div>
        </div>
        <p class="form-note" data-form-note aria-live="polite">
          首次验证成功后会自动创建账号。
        </p>
      </form>
    </section>
  </main>
</BaseLayout>

<script>
  import { isSupabaseConfigured, supabase } from '../../lib/supabase';

  const form = document.querySelector<HTMLFormElement>('[data-login-form]');
  const note = document.querySelector<HTMLElement>('[data-form-note]');
  const emailStep = document.querySelector<HTMLElement>('[data-email-step]');
  const codeStep = document.querySelector<HTMLElement>('[data-code-step]');
  const changeEmail = document.querySelector<HTMLButtonElement>(
    '[data-change-email]',
  );
  const resendCode =
    document.querySelector<HTMLButtonElement>('[data-resend-code]');
  let waitingForCode = false;
  let resendTimer: number | undefined;

  const setNote = (message: string, error = false) => {
    if (!note) return;
    note.textContent = message;
    note.dataset.error = String(error);
  };

  const sessionResult = await supabase?.auth.getSession();
  if (sessionResult?.data.session && form?.dataset.profileUrl) {
    window.location.replace(form.dataset.profileUrl);
  }

  const startResendCountdown = () => {
    if (!resendCode) return;
    window.clearInterval(resendTimer);
    let seconds = 60;
    resendCode.disabled = true;
    resendCode.textContent = `${seconds} 秒后重新发送`;
    resendTimer = window.setInterval(() => {
      seconds -= 1;
      resendCode.textContent =
        seconds > 0 ? `${seconds} 秒后重新发送` : '重新发送验证码';
      if (seconds <= 0) {
        window.clearInterval(resendTimer);
        resendCode.disabled = false;
      }
    }, 1000);
  };

  const sendCode = async (email: string, isResend = false) => {
    if (!supabase) return false;
    setNote(isResend ? '正在重新发送验证码……' : '正在发送验证码……');
    const { error } = await supabase.auth.signInWithOtp({
      email,
      options: { shouldCreateUser: true },
    });
    if (error) {
      setNote(error.message, true);
      return false;
    }
    setNote(
      isResend
        ? `新验证码已发送到 ${email}，上一枚验证码已失效。`
        : `验证码已发送到 ${email}，有效期为 5 分钟。`,
    );
    startResendCountdown();
    return true;
  };

  changeEmail?.addEventListener('click', () => {
    waitingForCode = false;
    window.clearInterval(resendTimer);
    if (emailStep) emailStep.hidden = false;
    if (codeStep) codeStep.hidden = true;
    setNote('首次验证成功后会自动创建账号。');
  });

  resendCode?.addEventListener('click', async () => {
    if (!isSupabaseConfigured || !supabase || !form) return;
    const email = String(new FormData(form).get('email') ?? '').trim();
    await sendCode(email, true);
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!isSupabaseConfigured || !supabase) {
      setNote('Supabase 尚未配置，请先填写环境变量。', true);
      return;
    }

    const data = new FormData(form);
    const email = String(data.get('email') ?? '').trim();

    if (!waitingForCode) {
      const sent = await sendCode(email);
      if (!sent) return;

      waitingForCode = true;
      if (emailStep) emailStep.hidden = true;
      if (codeStep) codeStep.hidden = false;
      document.querySelector<HTMLInputElement>('#code')?.focus();
      return;
    }

    const token = String(data.get('code') ?? '').trim();
    setNote('正在验证……');
    const { error } = await supabase.auth.verifyOtp({
      email,
      token,
      type: 'email',
    });
    if (error) return setNote(error.message, true);
    window.location.assign(form.dataset.profileUrl ?? '/');
  });
</script>

<style>
  .auth-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(22rem, 30rem);
    gap: clamp(3rem, 8vw, 8rem);
    width: min(72rem, calc(100% - 4rem));
    min-height: 100vh;
    align-items: center;
    margin-inline: auto;
    padding-block: 4rem;
  }
  .eyebrow,
  .step {
    color: var(--color-accent);
    font-size: 0.74rem;
    font-weight: 750;
    letter-spacing: 0.1em;
  }
  h1 {
    margin: 0.4rem 0 1rem;
    font-size: clamp(3rem, 7vw, 6.5rem);
    letter-spacing: -0.06em;
  }
  .auth-intro > p:last-of-type {
    max-width: 34rem;
    color: var(--color-text-muted);
    line-height: 1.8;
  }
  .auth-intro a {
    display: inline-block;
    margin-top: 1.2rem;
    color: var(--color-text-muted);
    font-size: 0.84rem;
  }
  .auth-card {
    display: grid;
    gap: 2rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: var(--color-surface);
  }
  h2 {
    margin: 0.5rem 0 0;
    font-size: 1.55rem;
  }
  form {
    display: grid;
    gap: 0.7rem;
  }
  [hidden] {
    display: none !important;
  }
  [data-email-step],
  [data-code-step] {
    display: grid;
    gap: 0.7rem;
  }
  label {
    font-size: 0.82rem;
    font-weight: 700;
  }
  .field-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.55rem;
  }
  input,
  button {
    min-height: 3rem;
    border: 1px solid var(--color-border);
    border-radius: 0.55rem;
  }
  input {
    min-width: 0;
    padding: 0 0.9rem;
    background: var(--color-page);
  }
  button {
    padding-inline: 1rem;
    border-color: var(--color-text);
    background: var(--color-text);
    color: var(--color-page);
    font-weight: 700;
    cursor: pointer;
  }
  .form-note {
    margin: 0.2rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.76rem;
    line-height: 1.6;
  }
  .form-note[data-error='true'] {
    color: #c23b3b;
  }
  .text-button {
    width: fit-content;
    min-height: auto;
    padding: 0.25rem 0;
    border: 0;
    background: transparent;
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }
  .code-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .text-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  @media (max-width: 54rem) {
    .auth-page {
      grid-template-columns: 1fr;
      align-content: center;
    }
  }
</style>
