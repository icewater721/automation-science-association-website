---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { withBase } from '../utils/paths';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link
      rel="icon"
      type="image/png"
      href={withBase('/images/brand/asaw-logo.png')}
    />
    <title>{title}</title>
    <script is:inline>
      const savedTheme = localStorage.getItem('asaw-theme');
      const availableThemes = ['light', 'dark'];
      document.documentElement.dataset.theme = availableThemes.includes(
        savedTheme,
      )
        ? savedTheme
        : 'light';
    </script>
  </head>
  <body>
    <Header />
    <slot />
    <script>
      const decorateCodeBlock = (pre: HTMLPreElement) => {
        if (pre.dataset.copyReady === 'true') return;
        pre.dataset.copyReady = 'true';
        pre.classList.add('has-code-copy');

        const copyIcon = '<svg aria-hidden="true" viewBox="0 0 24 24"><rect x="9" y="9" width="10" height="10" rx="2"></rect><path d="M15 9V7a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"></path></svg>';
        const successIcon = '<svg aria-hidden="true" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"></path></svg>';
        const errorIcon = '<svg aria-hidden="true" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"></path></svg>';
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'code-copy-button';
        button.innerHTML = copyIcon;
        button.setAttribute('aria-label', '复制代码');
        button.title = '复制代码';
        button.addEventListener('click', async () => {
          const code = pre.querySelector('code')?.textContent ?? '';
          try {
            await navigator.clipboard.writeText(code);
            button.innerHTML = successIcon;
            button.dataset.state = 'success';
            button.setAttribute('aria-label', '代码已复制');
            button.title = '已复制';
          } catch {
            button.innerHTML = errorIcon;
            button.dataset.state = 'error';
            button.setAttribute('aria-label', '复制失败');
            button.title = '复制失败';
          }
          window.setTimeout(() => {
            button.innerHTML = copyIcon;
            button.setAttribute('aria-label', '复制代码');
            button.title = '复制代码';
            delete button.dataset.state;
          }, 1600);
        });
        pre.append(button);
      };

      const decorateArticleCodeBlocks = (root: ParentNode) => {
        if (root instanceof HTMLPreElement && root.matches('.docs-content pre, .content pre')) decorateCodeBlock(root);
        root.querySelectorAll<HTMLPreElement>('.docs-content pre, .content pre').forEach(decorateCodeBlock);
      };

      decorateArticleCodeBlocks(document);
      new MutationObserver((records) => {
        for (const record of records) {
          for (const node of record.addedNodes) {
            if (node instanceof Element) decorateArticleCodeBlocks(node);
          }
        }
      }).observe(document.body, { childList: true, subtree: true });
    </script>
  </body>
</html>
