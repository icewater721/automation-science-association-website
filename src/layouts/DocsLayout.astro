---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import { withBase } from '../utils/paths';

interface Props {
  title: string;
  description: string;
  browserTitle?: string;
  headings?: MarkdownHeading[];
  currentPath?: string;
  breadcrumbs?: Array<{ title: string; href?: string }>;
  previous?: { title: string; href: string };
  next?: { title: string; href: string };
}

const {
  title,
  description,
  browserTitle,
  headings = [],
  currentPath = '/docs/',
  breadcrumbs = [],
  previous,
  next,
} = Astro.props;
const visibleHeadings = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
const isCurrent = (path: string) => currentPath === path;
const isLearning = currentPath.startsWith('/docs/learning');
const isBasicTools = currentPath.startsWith('/docs/learning/basic-tools');
const basicTools = [
  { title: 'VS Code', path: '/docs/learning/basic-tools/vscode/' },
  { title: 'Git 与 GitHub', path: '/docs/learning/basic-tools/git-github/' },
  { title: 'CMake', path: '/docs/learning/basic-tools/cmake/' },
  { title: '容器', path: '/docs/learning/basic-tools/containers/' },
  { title: '包管理器', path: '/docs/learning/basic-tools/package-managers/' },
];
---

<BaseLayout
  title={browserTitle ?? `${title} | 人工智能学院科协文档`}
  description={description}
  pageKind="docs"
>
  <main class="docs-shell">
    <aside class="docs-navigation" aria-label="文档目录">
      <p class="navigation-title">文档</p>
      <nav class="document-tree">
        <a
          class="tree-link tree-link--root"
          href={withBase('/docs/')}
          aria-current={isCurrent('/docs/') ? 'page' : undefined}>简介</a
        >
        <details open={isLearning}>
          <summary>学习资料</summary>
          <div class="tree-branch">
            <details open={isBasicTools}>
              <summary>基础工具</summary>
              <div class="tree-branch">
                {
                  basicTools.map((tool) => (
                    <a
                      class="tree-link"
                      href={withBase(tool.path)}
                      aria-current={isCurrent(tool.path) ? 'page' : undefined}
                    >
                      {tool.title}
                    </a>
                  ))
                }
              </div>
            </details>
          </div>
        </details>
      </nav>
    </aside>

    <article class="docs-article">
      {
        breadcrumbs.length > 0 && (
          <nav class="breadcrumbs" aria-label="面包屑导航">
            {breadcrumbs.map((item, index) => (
              <span>
                {index > 0 && <span aria-hidden="true">/</span>}
                {item.href ? <a href={item.href}>{item.title}</a> : item.title}
              </span>
            ))}
          </nav>
        )
      }
      <header>
        <p class="eyebrow">文档中心</p>
        <h1>{title}</h1>
        <p class="description">{description}</p>
      </header>
      <div class="docs-content">
        <slot />
      </div>
      {
        (previous || next) && (
          <nav class="article-navigation" aria-label="前后文导航">
            {previous ? (
              <a class="article-navigation__previous" href={previous.href}>
                <span>上一篇</span>
                <strong>{previous.title}</strong>
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a class="article-navigation__next" href={next.href}>
                <span>下一篇</span>
                <strong>{next.title}</strong>
              </a>
            )}
          </nav>
        )
      }
    </article>

    <aside class="page-outline" aria-label="本页跳转">
      <p>本页跳转</p>
      {
        visibleHeadings.length > 0 ? (
          <nav>
            {visibleHeadings.map((heading) => (
              <a href={`#${heading.slug}`} data-depth={heading.depth}>
                {heading.text}
              </a>
            ))}
          </nav>
        ) : (
          <span>本页暂无小节</span>
        )
      }
    </aside>
  </main>
</BaseLayout>

<style>
  .docs-shell {
    display: grid;
    grid-template-columns: minmax(11rem, 15rem) minmax(0, 48rem) minmax(
        9rem,
        12rem
      );
    gap: clamp(2rem, 5vw, 4rem);
    width: min(88rem, calc(100% - 4rem));
    margin-inline: auto;
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }

  .docs-navigation,
  .page-outline {
    position: sticky;
    top: 6.5rem;
    align-self: start;
  }

  .docs-navigation {
    grid-column: 1;
    grid-row: 1;
  }

  .docs-article {
    grid-column: 2;
    grid-row: 1;
  }

  .page-outline {
    grid-column: 3;
    grid-row: 1;
  }

  .navigation-title,
  .page-outline > p {
    margin: 0 0 0.9rem;
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.08em;
  }

  .page-outline nav {
    display: grid;
    gap: 0.2rem;
  }

  .page-outline a {
    padding: 0.42rem 0 0.42rem 0.7rem;
    border-left: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.82rem;
    line-height: 1.45;
    text-decoration: none;
  }

  .page-outline a:hover {
    border-left-color: var(--color-accent);
    color: var(--color-text);
  }

  .page-outline a[data-depth='3'] {
    padding-left: 1.15rem;
  }

  .page-outline span {
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }

  .document-tree {
    display: grid;
    gap: 0.55rem;
  }

  .document-tree details {
    min-width: 0;
  }

  .document-tree summary {
    padding: 0.55rem 0.6rem;
    border-radius: 0.3rem;
    font-size: 0.86rem;
    font-weight: 700;
    cursor: pointer;
  }

  .tree-branch {
    display: grid;
    gap: 0.25rem;
    margin-left: 0.65rem;
    padding: 0.2rem 0 0.25rem 0.65rem;
    border-left: 1px solid var(--color-border);
  }

  .tree-branch .tree-branch {
    margin-left: 0.4rem;
  }

  .tree-link {
    padding: 0.48rem 0.65rem;
    border-radius: 0.25rem;
    color: var(--color-text-muted);
    font-size: 0.82rem;
    text-decoration: none;
  }

  .tree-link--root {
    font-size: 0.86rem;
    font-weight: 700;
  }

  .tree-link[aria-current='page'] {
    box-shadow: inset 0.18rem 0 var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    color: var(--color-text);
    font-weight: 700;
  }

  :global(:root[data-theme='ark']) .tree-link[aria-current='page'] {
    box-shadow: inset 0.24rem 0 var(--color-accent);
    border-radius: 0;
  }

  .docs-article {
    min-width: 0;
  }

  .docs-article header {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.2rem;
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }

  .breadcrumbs span {
    display: inline-flex;
    gap: 0.4rem;
  }

  .breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }

  .eyebrow {
    margin: 0 0 0.65rem;
    color: var(--color-accent);
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.08em;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    letter-spacing: -0.045em;
  }

  .description {
    max-width: 42rem;
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    line-height: 1.75;
  }

  .docs-content {
    padding-top: 1.5rem;
    font-size: 1rem;
    line-height: 1.85;
  }

  .docs-content :global(h2) {
    margin: 2.6rem 0 0.8rem;
    font-size: 1.65rem;
    letter-spacing: -0.025em;
  }

  .docs-content :global(p),
  .docs-content :global(ul) {
    margin-block: 0.9rem;
  }

  .docs-content :global(a) {
    color: var(--color-accent);
  }

  .article-navigation {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .article-navigation a {
    display: grid;
    gap: 0.3rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    text-decoration: none;
  }

  .article-navigation a:hover {
    border-color: var(--color-accent);
  }

  .article-navigation span {
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .article-navigation strong {
    font-size: 0.9rem;
  }

  .article-navigation__next {
    text-align: right;
  }

  :global(:root[data-theme='ark']) .docs-shell {
    position: relative;
  }

  :global(:root[data-theme='ark']) .docs-shell::before {
    position: fixed;
    z-index: -1;
    inset: 4.75rem 0 0;
    background:
      linear-gradient(128deg, rgb(25 28 31 / 7%) 0 18%, transparent 18%),
      radial-gradient(circle at 85% 12%, rgb(196 94 77 / 12%), transparent 22%),
      linear-gradient(
        160deg,
        transparent 0 72%,
        rgb(16 155 216 / 9%) 72% 83%,
        transparent 83%
      );
    content: '';
    pointer-events: none;
  }

  :global(:root[data-theme='ark']) .docs-navigation,
  :global(:root[data-theme='ark']) .page-outline {
    padding: 1rem;
    border: 1px solid var(--color-border);
    background: var(--ark-glass);
    box-shadow: 0.45rem 0.45rem 0 rgb(25 28 31 / 8%);
    backdrop-filter: blur(8px);
  }

  :global(:root[data-theme='ark']) .navigation-title,
  :global(:root[data-theme='ark']) .page-outline > p {
    padding-bottom: 0.6rem;
    border-bottom: 0.2rem solid var(--color-text);
    color: var(--color-accent);
    font-family: ui-monospace, 'Cascadia Code', monospace;
  }

  :global(:root[data-theme='ark']) .docs-article header {
    position: relative;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--color-border);
    border-left: 0.35rem solid var(--color-accent);
    background:
      linear-gradient(
        115deg,
        var(--ark-glass) 0 78%,
        rgb(16 155 216 / 11%) 78%
      ),
      var(--color-surface);
    box-shadow: 0.8rem 0.8rem 0 rgb(25 28 31 / 8%);
  }

  :global(:root[data-theme='ark']) .docs-article header::after {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 3rem;
    height: 0.3rem;
    background: linear-gradient(
      90deg,
      var(--ark-alert) 0 35%,
      transparent 35% 48%,
      var(--ark-warning) 48%
    );
    content: '';
  }

  :global(:root[data-theme='ark']) .docs-content :global(h2) {
    padding-left: 0.8rem;
    border-left: 0.25rem solid var(--color-accent);
  }

  :global(:root[data-theme='ark']) .article-navigation a {
    border-left: 0.25rem solid var(--color-accent);
    background: var(--ark-glass);
  }

  :global(:root[data-theme='stardew']) .docs-shell {
    position: relative;
  }

  :global(:root[data-theme='stardew']) .docs-shell::before {
    position: fixed;
    z-index: -1;
    inset: 4.75rem 0 0;
    background:
      linear-gradient(180deg, rgb(145 203 210 / 45%) 0 8rem, transparent 8rem),
      linear-gradient(135deg, transparent 0 84%, rgb(126 182 77 / 18%) 84%),
      var(--color-page);
    content: '';
    pointer-events: none;
  }

  :global(:root[data-theme='stardew']) .docs-navigation,
  :global(:root[data-theme='stardew']) .page-outline {
    padding: 1rem;
    border: 0.2rem solid #713b24;
    border-radius: 0.35rem;
    background: linear-gradient(#f5cb83, #eab56b);
    box-shadow:
      0 0 0 0.12rem #b96c3c,
      0.22rem 0.25rem 0 #633c25,
      inset 0 0 0 0.12rem #ffe0a2;
  }

  :global(:root[data-theme='stardew']) .navigation-title,
  :global(:root[data-theme='stardew']) .page-outline > p,
  :global(:root[data-theme='stardew']) .document-tree summary,
  :global(:root[data-theme='stardew']) .tree-link {
    font-family: var(--stardew-display-font);
    font-weight: 400;
  }

  :global(:root[data-theme='stardew']) .tree-link[aria-current='page'] {
    border: 0.12rem solid #315d3d;
    border-radius: 0.15rem;
    background: linear-gradient(#a8d36a, #79aa4e);
    box-shadow:
      0.1rem 0.12rem 0 #315436,
      inset 0 0 0 0.06rem #dff0a0;
    color: #29452e;
  }

  :global(:root[data-theme='stardew']) .docs-article header {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 0.24rem solid #713b24;
    border-radius: 0.35rem;
    background:
      repeating-linear-gradient(
        0deg,
        transparent 0 1.5rem,
        rgb(155 91 45 / 9%) 1.5rem 1.58rem
      ),
      linear-gradient(#f7d494, #edbb72);
    box-shadow:
      0 0 0 0.14rem #b96c3c,
      0.28rem 0.32rem 0 #633c25,
      inset 0 0 0 0.15rem #ffe6ad;
  }

  :global(:root[data-theme='stardew']) .docs-article h1,
  :global(:root[data-theme='stardew']) .docs-content :global(h2) {
    color: #6a3525;
    font-family: var(--stardew-display-font);
    font-weight: 400;
    text-shadow: 0.08rem 0.08rem 0 #ffd99b;
  }

  :global(:root[data-theme='stardew']) .docs-content {
    margin-top: 1.5rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 0.16rem solid #b87845;
    border-radius: 0.3rem;
    background: rgb(255 244 207 / 92%);
    box-shadow: 0.18rem 0.2rem 0 rgb(99 60 37 / 42%);
  }

  :global(:root[data-theme='stardew']) .article-navigation a {
    border: 0.16rem solid #713b24;
    border-radius: 0.25rem;
    background: linear-gradient(#f2be72, #e5a85e);
    box-shadow: 0.16rem 0.18rem 0 #633c25;
  }

  @media (max-width: 70rem) {
    .docs-shell {
      grid-template-columns: minmax(10rem, 13rem) minmax(0, 1fr);
    }

    .page-outline {
      display: none;
    }
  }

  @media (max-width: 46rem) {
    .docs-shell {
      grid-template-columns: 1fr;
      width: min(100% - 2rem, 46rem);
    }

    .docs-navigation {
      position: static;
      grid-column: 1;
      grid-row: auto;
    }

    .docs-article {
      grid-column: 1;
      grid-row: auto;
    }
  }
</style>
