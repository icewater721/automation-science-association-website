---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  browserTitle?: string;
  headings?: MarkdownHeading[];
  breadcrumbs?: Array<{ title: string; href?: string }>;
  previous?: { title: string; href: string };
  next?: { title: string; href: string };
  backHref?: string;
}

const {
  title,
  description,
  browserTitle,
  headings = [],
  breadcrumbs = [],
  previous,
  next,
  backHref,
} = Astro.props;
const visibleHeadings = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
---

<BaseLayout
  title={browserTitle ?? `${title} | 人工智能学院科协文档`}
  description={description}
>
  <main class="docs-shell">
    <article class="docs-article">
      {backHref && <a class="back-link" href={backHref} aria-label="返回文档列表">← <span>返回</span></a>}
      {
        breadcrumbs.length > 0 && (
          <nav class="breadcrumbs" aria-label="面包屑导航">
            {breadcrumbs.map((item, index) => (
              <span>
                {index > 0 && <span aria-hidden="true">/</span>}
                {item.href ? <a href={item.href}>{item.title}</a> : item.title}
              </span>
            ))}
          </nav>
        )
      }
      <header>
        <p class="eyebrow">基础工具</p>
        <h1>{title}</h1>
        <p class="description">{description}</p>
      </header>
      <div class="docs-content">
        <slot />
      </div>
      {
        (previous || next) && (
          <nav class="article-navigation" aria-label="前后文导航">
            {previous ? (
              <a class="article-navigation__previous" href={previous.href}>
                <span>上一篇</span>
                <strong>{previous.title}</strong>
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a class="article-navigation__next" href={next.href}>
                <span>下一篇</span>
                <strong>{next.title}</strong>
              </a>
            )}
          </nav>
        )
      }
    </article>

    <aside class="page-outline" aria-label="本页跳转">
      <p>文档目录</p>
      <button class="back-to-top" type="button" data-back-to-top><span>↑</span> 回到顶部</button>
      {
        visibleHeadings.length > 0 ? (
          <nav>
            {visibleHeadings.map((heading) => (
              <a href={`#${heading.slug}`} data-depth={heading.depth}>
                {heading.text}
              </a>
            ))}
          </nav>
        ) : (
          <span>本页暂无小节</span>
        )
      }
    </aside>
  </main>
</BaseLayout>

<script>
  const outlineLinks = [...document.querySelectorAll<HTMLAnchorElement>('.page-outline a')];
  const sections = outlineLinks
    .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
    .filter((section): section is HTMLElement => Boolean(section));
  const updateActiveOutline = () => {
    if (!sections.length) return;
    const marker = Math.min(window.innerHeight * 0.3, 180);
    let active = sections[0];
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= marker) active = section;
      else break;
    }
    outlineLinks.forEach((link) => {
      const isActive = link.hash === `#${active.id}`;
      link.classList.toggle('is-active', isActive);
      if (isActive) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  };
  updateActiveOutline();
  window.addEventListener('scroll', updateActiveOutline, { passive: true });
  document.querySelector('[data-back-to-top]')?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
</script>

<style>
  .docs-shell {
    display: grid;
    grid-template-columns: minmax(0, 48rem) minmax(9rem, 11rem);
    gap: clamp(1.5rem, 3vw, 3rem);
    width: min(88rem, calc(100% - 4rem));
    margin-inline: auto;
    padding: 1.4rem 0 clamp(2.5rem, 6vw, 5rem);
  }

  .page-outline {
    position: sticky;
    top: 2rem;
    align-self: start;
  }

  .docs-article {
    grid-column: 1;
    grid-row: 1;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 1.2rem;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    text-decoration: none;
    transition: color 160ms ease, transform 160ms ease;
  }

  .back-link:hover { color: var(--color-accent); transform: translateX(-0.15rem); }

  .page-outline {
    grid-column: 2;
    grid-row: 1;
  }

  .navigation-title,
  .page-outline > p {
    margin: 0 0 0.9rem;
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.08em;
  }

  .page-outline nav {
    display: grid;
    gap: 0.2rem;
  }

  .back-to-top { display: flex; width: 100%; align-items: center; gap: 0.45rem; margin: -0.25rem 0 0.65rem; padding: 0.45rem 0.7rem; border: 0; border-radius: 0.55rem; background: transparent; color: var(--color-text-muted); cursor: pointer; font: inherit; font-size: 0.78rem; text-align: left; }
  .back-to-top:hover { background: var(--color-surface); color: var(--color-accent); }

  .page-outline a {
    padding: 0.42rem 0 0.42rem 0.7rem;
    border-left: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.82rem;
    line-height: 1.45;
    text-decoration: none;
  }

  .page-outline a:hover {
    border-left-color: var(--color-accent);
    color: var(--color-text);
  }

  .page-outline a.is-active {
    border-left: 3px solid var(--color-accent);
    border-radius: 0 0.5rem 0.5rem 0;
    background: color-mix(in srgb, var(--color-accent) 16%, transparent);
    color: var(--color-accent);
    font-weight: 750;
  }

  .page-outline a[data-depth='3'] {
    padding-left: 1.15rem;
  }

  .page-outline span {
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }

  .docs-article {
    min-width: 0;
  }

  .docs-article header {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.2rem;
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }

  .breadcrumbs span {
    display: inline-flex;
    gap: 0.4rem;
  }

  .breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }

  .eyebrow {
    margin: 0 0 0.65rem;
    color: var(--color-accent);
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.08em;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    letter-spacing: -0.045em;
  }

  .description {
    max-width: 42rem;
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    line-height: 1.75;
  }

  .docs-content {
    padding-top: 1.5rem;
    font-size: 1rem;
    line-height: 1.85;
  }

  .docs-content :global(h2) {
    margin: 2.6rem 0 0.8rem;
    font-size: 1.65rem;
    letter-spacing: -0.025em;
  }

  .docs-content :global(p),
  .docs-content :global(ul) {
    margin-block: 0.9rem;
  }

  .docs-content :global(a) {
    color: var(--color-accent);
  }

  .article-navigation {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .article-navigation a {
    display: grid;
    gap: 0.3rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    border-radius: 0.7rem;
    text-decoration: none;
  }

  .article-navigation a:hover {
    border-color: var(--color-accent);
  }

  .article-navigation span {
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .article-navigation strong {
    font-size: 0.9rem;
  }

  .article-navigation__next {
    text-align: right;
  }

  @media (max-width: 86rem) {
    .docs-shell {
      grid-template-columns: minmax(0, 48rem);
      justify-content: center;
    }

    .page-outline {
      display: none;
    }
  }

  @media (max-width: 46rem) {
    .docs-shell {
      grid-template-columns: 1fr;
      width: min(100% - 2rem, 46rem);
    }

    .docs-article {
      grid-column: 1;
      grid-row: auto;
    }
  }
</style>
