---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  currentPath?: string;
}

const { title, description, currentPath = '/docs/' } = Astro.props;
const isCurrent = (path: string) => currentPath === path;
const isLearning = currentPath.startsWith('/docs/learning');
const isBasicTools = currentPath.startsWith('/docs/learning/basic-tools');
const basicTools = [
  { title: 'VS Code', path: '/docs/learning/basic-tools/vscode/' },
  { title: 'Git 与 GitHub', path: '/docs/learning/basic-tools/git-github/' },
  { title: 'CMake', path: '/docs/learning/basic-tools/cmake/' },
  { title: '容器', path: '/docs/learning/basic-tools/containers/' },
  { title: '包管理器', path: '/docs/learning/basic-tools/package-managers/' },
];
---

<BaseLayout
  title={`${title} | 人工智能学院学生科协文档`}
  description={description}
>
  <main class="docs-shell">
    <aside class="docs-navigation" aria-label="文档目录">
      <p class="navigation-title">文档</p>
      <nav class="document-tree">
        <a
          class="tree-link tree-link--root"
          href="/docs/"
          aria-current={isCurrent('/docs/') ? 'page' : undefined}>简介</a
        >
        <details open={isLearning}>
          <summary>学习资料</summary>
          <div class="tree-branch">
            <a
              class="tree-link"
              href="/docs/learning/"
              aria-current={isCurrent('/docs/learning/') ? 'page' : undefined}
              >学习资料</a
            >
            <details open={isBasicTools}>
              <summary>基础工具</summary>
              <div class="tree-branch">
                <a
                  class="tree-link"
                  href="/docs/learning/basic-tools/"
                  aria-current={isCurrent('/docs/learning/basic-tools/')
                    ? 'page'
                    : undefined}>基础工具简介</a
                >
                {
                  basicTools.map((tool) => (
                    <a
                      class="tree-link"
                      href={tool.path}
                      aria-current={isCurrent(tool.path) ? 'page' : undefined}
                    >
                      {tool.title}
                    </a>
                  ))
                }
              </div>
            </details>
          </div>
        </details>
      </nav>
    </aside>

    <article class="docs-article">
      <header>
        <p class="eyebrow">文档中心</p>
        <h1>{title}</h1>
        <p class="description">{description}</p>
      </header>
      <div class="docs-content">
        <slot />
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .docs-shell {
    display: grid;
    grid-template-columns: minmax(11rem, 15rem) minmax(0, 52rem);
    gap: clamp(2rem, 5vw, 4rem);
    width: min(72rem, calc(100% - 4rem));
    margin-inline: auto;
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }

  .docs-navigation {
    position: sticky;
    top: 6.5rem;
    align-self: start;
  }

  .navigation-title {
    margin: 0 0 0.9rem;
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.08em;
  }

  .document-tree {
    display: grid;
    gap: 0.55rem;
  }

  .document-tree details {
    min-width: 0;
  }

  .document-tree summary {
    padding: 0.55rem 0.6rem;
    border-radius: 0.3rem;
    font-size: 0.86rem;
    font-weight: 700;
    cursor: pointer;
  }

  .tree-branch {
    display: grid;
    gap: 0.25rem;
    margin-left: 0.65rem;
    padding: 0.2rem 0 0.25rem 0.65rem;
    border-left: 1px solid var(--color-border);
  }

  .tree-branch .tree-branch {
    margin-left: 0.4rem;
  }

  .tree-link {
    padding: 0.48rem 0.65rem;
    border-radius: 0.25rem;
    color: var(--color-text-muted);
    font-size: 0.82rem;
    text-decoration: none;
  }

  .tree-link--root {
    font-size: 0.86rem;
    font-weight: 700;
  }

  .tree-link[aria-current='page'] {
    box-shadow: inset 0.18rem 0 var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    color: var(--color-text);
    font-weight: 700;
  }

  :global(:root[data-theme='ark']) .tree-link[aria-current='page'] {
    box-shadow: inset 0.24rem 0 var(--color-accent);
    border-radius: 0;
  }

  .docs-article {
    min-width: 0;
  }

  .docs-article header {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .eyebrow {
    margin: 0 0 0.65rem;
    color: var(--color-accent);
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.08em;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    letter-spacing: -0.045em;
  }

  .description {
    max-width: 42rem;
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    line-height: 1.75;
  }

  .docs-content {
    padding-top: 1.5rem;
    font-size: 1rem;
    line-height: 1.85;
  }

  .docs-content :global(h2) {
    margin: 2.6rem 0 0.8rem;
    font-size: 1.65rem;
    letter-spacing: -0.025em;
  }

  .docs-content :global(p),
  .docs-content :global(ul) {
    margin-block: 0.9rem;
  }

  .docs-content :global(a) {
    color: var(--color-accent);
  }

  @media (max-width: 46rem) {
    .docs-shell {
      grid-template-columns: 1fr;
      width: min(100% - 2rem, 46rem);
    }

    .docs-navigation {
      position: static;
    }
  }
</style>
